// timer — monotonic time and frame pacing.
//
// Milliseconds and seconds since the clock started, the raw counter
// underneath them, and the two ways to wait: hand a duration back to the
// scheduler, or hold until a deadline.
//
// Two hazards shape this file. Integer division **traps** in Axle rather
// than yielding infinity, so the frequency is clamped away from zero at
// construction and never re-checked. And `Sleep(1)` is not one
// millisecond unless the scheduler period was lowered — `Platform` does that
// where a platform has one to lower, and `delayUntil` still spins the
// last stretch because even a 1 ms granularity overshoots often enough
// to cost a frame.

use crate::platform::sys_clock::SysClock;

/**
 * The monotonic clock, started when it is constructed.
 *
 * One per process is plenty — every reading is relative to the same
 * origin, so two clocks would disagree about `ticks()` by however long
 * separated their construction.
 */
pub class Clock : Closeable {
    /** Milliseconds in a second. */
    pub(file) static MS_PER_SEC : i64 = 1000;

    /** Microseconds in a second. */
    pub(file) static US_PER_SEC : i64 = 1000000;

    /**
     * How much of a wait is handed to the scheduler rather than spun.
     *
     * `Sleep` returns late, not early, so the last millisecond is spun: a
     * frame paced entirely by `Sleep` misses vsync roughly one frame in ten
     * even at a 1 ms period.
     */
    pub(file) static SPIN_MARGIN_US : i64 = 1500;

    freq   : i64;
    origin : i64;
    sys    : SysClock = new SysClock();

    /** Start the clock. */
    constructor() {
        let hz : i64 = self.sys.frequency();
        // Every later conversion divides by this. A zero would trap, so
        // a machine that answers nonsense gets a clock that runs slow
        // rather than a process that dies.
        if (hz <= 0) {
            self.freq = Clock::US_PER_SEC;
        } else {
            self.freq = hz;
        }
        self.origin = self.sys.counter();
    }

    /** Ticks of the performance counter per second. */
    pub fn frequency(self) : i64 {
        return self.freq;
    }

    /** The raw monotonic counter, in `frequency()` ticks. */
    pub fn counter(mut self) : i64 {
        return self.sys.counter();
    }

    /** Milliseconds since the clock started. */
    pub fn ticks(mut self) : i64 {
        return ((self.counter() - self.origin) * Clock::MS_PER_SEC) / self.freq;
    }

    /** Microseconds since the clock started. */
    pub fn micros(mut self) : i64 {
        return ((self.counter() - self.origin) * Clock::US_PER_SEC) / self.freq;
    }

    /** Seconds since the clock started, as a fraction. */
    pub fn seconds(mut self) : f64 {
        return (self.micros() as f64) / (Clock::US_PER_SEC as f64);
    }

    /** Hand `ms` milliseconds back to the scheduler. */
    pub fn delay(self, ms : i32) : void {
        if (ms > 0) {
            self.sys.sleep(ms);
        }
    }

    /**
     * Wait until `deadlineUs` microseconds have elapsed since the clock
     * started, then return — the frame pacer.
     *
     * Sleeps while more than `Clock::SPIN_MARGIN_US` remains and spins the
     * rest, which is what keeps a 16.67 ms frame from becoming 17.9 ms.
     */
    pub fn delayUntil(mut self, deadlineUs : i64) : void {
        let remaining : i64 = deadlineUs - self.micros();
        if (remaining > Clock::SPIN_MARGIN_US) {
            let sleepable : i64 = remaining - Clock::SPIN_MARGIN_US;
            self.sys.sleep((sleepable / Clock::MS_PER_SEC) as i32);
        }
        while (self.micros() < deadlineUs) {
            // Spin. The margin above keeps this under two milliseconds.
        }
    }

    /** Release the platform clock.*/
    pub fn close(self) : void {
        self.sys.close();
    }
}

/**
 * The frame loop's metronome: it sleeps to the frame boundary, and
 * answers how long the previous frame took.
 *
 * SDL has no equivalent — a game writes the deadline arithmetic itself,
 * and gets it subtly wrong: sleeping a fixed period lets error
 * accumulate, and measuring the delta after the sleep folds the sleep's
 * own overshoot into the simulation. This does both from one call at the
 * top of the loop:
 *
 * ```
 * let pacer = new FramePacer(60);
 * while (running) {
 *     let dt = pacer.tick(clock);
 *     world.update(dt);
 *     device.endFrame(win);
 * }
 * ```
 *
 * `dt` is in seconds, so it multiplies straight into a velocity. The
 * first tick returns zero — there is no previous frame to have taken
 * time — and never sleeps.
 */
pub class FramePacer {
    /**
     * How much of a frame's delta is reported, however long the frame took.
     *
     * A stalled frame — a dragged window, a breakpoint, a paging storm —
     * would otherwise hand the simulation one enormous step, and a step that
     * large moves a body through a wall instead of into it. Reporting less
     * time than passed makes the world run slow for one frame, which is the
     * failure a player forgives.
     */
    pub(file) static MAX_DELTA_US : i64 = 250000;

    /** The span a frame rate is averaged over before it is republished — one second. */
    pub(file) static RATE_WINDOW_US : i64 = 1000000;

    periodUs     : i64 = 0;
    deadlineUs   : i64 = 0;
    lastUs       : i64 = 0;
    started      : bool = false;
    windowUs     : i64 = 0;
    windowFrames : i64 = 0;
    rate         : f64 = 0.0;

    /**
     * A pacer targeting `fps` frames per second; `0` leaves it uncapped.
     *
     * Through `setRate`, so the period is derived from a frame rate in
     * one place: the two spellings drifting apart would give a pacer
     * that targeted one rate until it was retargeted to the same one.
     */
    constructor(fps : i32) {
        self.setRate(fps);
    }

    /** Retarget the loop; `0` uncaps it. Takes effect on the next tick. */
    pub fn setRate(mut self, fps : i32) : void {
        self.periodUs = 0;
        if (fps > 0) {
            self.periodUs = Clock::US_PER_SEC / (fps as i64);
        }
    }

    /** The frame period being targeted, in microseconds; `0` when uncapped. */
    pub fn period(self) : i64 {
        return self.periodUs;
    }

    /**
     * The rate actually achieved, averaged over the last window.
     *
     * Zero until a full window has elapsed, so a title bar shows nothing
     * rather than a wild number extrapolated from three frames.
     */
    pub fn fps(self) : f64 {
        return self.rate;
    }

    /**
     * Sleep to the frame boundary, then answer the seconds the previous
     * frame took.
     *
     * The deadline advances by whole periods, so a frame that finished
     * early does not shorten the next one. A frame that overran by more
     * than a period leaves a backlog that no run of short frames can
     * clear, so the deadline is re-seeded from now rather than chased.
     */
    pub fn tick(mut self, clock : Clock) : f64 {
        if (!self.started) {
            self.started = true;
            self.lastUs = clock.micros();
            self.deadlineUs = self.lastUs + self.periodUs;
            self.windowUs = self.lastUs;
            return 0.0;
        }

        if (self.periodUs > 0) {
            clock.delayUntil(self.deadlineUs);
        }

        let now = clock.micros();
        let elapsed = now - self.lastUs;
        self.lastUs = now;

        self.deadlineUs = self.deadlineUs + self.periodUs;
        if (self.deadlineUs < now) {
            self.deadlineUs = now + self.periodUs;
        }

        self.windowFrames += 1;
        let span = now - self.windowUs;
        if (span >= FramePacer::RATE_WINDOW_US) {
            self.rate = ((self.windowFrames * Clock::US_PER_SEC) as f64) / (span as f64);
            self.windowFrames = 0;
            self.windowUs = now;
        }

        if (elapsed > FramePacer::MAX_DELTA_US) {
            elapsed = FramePacer::MAX_DELTA_US;
        }
        return (elapsed as f64) / (Clock::US_PER_SEC as f64);
    }
}
