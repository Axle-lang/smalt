// timer — monotonic time and frame pacing.
//
// The counterpart of `SDL_timer.h`: `ticks()` for `SDL_GetTicks`,
// `counter()` / `frequency()` for the performance counter pair, `delay`
// for `SDL_Delay`, and `delayUntil` for SDL3's `SDL_DelayPrecise`.
//
// Two hazards shape this file. Integer division **traps** in Axle rather
// than yielding infinity, so the frequency is clamped away from zero at
// construction and never re-checked. And `Sleep(1)` is not one
// millisecond unless the scheduler period was lowered — `Platform` does that
// with `timeBeginPeriod`, and `delayUntil` still spins the last stretch
// because even a 1 ms period overshoots often enough to cost a frame.

use crate::kernel::blob::Blob;
use crate::sys::win32_kernel::{
    QueryPerformanceCounter, QueryPerformanceFrequency, Sleep,
};

/** Milliseconds in a second. */
const CLOCK_MS_PER_SEC : i64 = 1000;
/** Microseconds in a second. */
const CLOCK_US_PER_SEC : i64 = 1000000;
/**
 * How much of a wait is handed to the scheduler rather than spun.
 *
 * `Sleep` returns late, not early, so the last millisecond is spun: a
 * frame paced entirely by `Sleep` misses vsync roughly one frame in ten
 * even at a 1 ms period.
 */
const CLOCK_SPIN_MARGIN_US : i64 = 1500;

/**
 * The monotonic clock, started when it is constructed.
 *
 * One per process is plenty — every reading is relative to the same
 * origin, so two clocks would disagree about `ticks()` by however long
 * separated their construction.
 */
pub class Clock : Closeable {
    freq : i64;
    origin : i64;
    scratch : Blob;

    /** Start the clock. */
    constructor() {
        // The counter calls write a `LARGE_INTEGER`, of which this code
        // reads the 64-bit `QuadPart` — so the block is that, measured.
        self.scratch = new Blob(sizeof<i64>());
        let hz : i64 = 0;
        unsafe {
            let slot : ptr<i64> = self.scratch.at() as ptr<i64>;
            QueryPerformanceFrequency(slot);
            hz = *slot;
        }
        // Every later conversion divides by this. A zero would trap, so
        // a machine that answers nonsense gets a clock that runs slow
        // rather than a process that dies.
        if (hz <= 0) {
            self.freq = CLOCK_US_PER_SEC;
        } else {
            self.freq = hz;
        }
        unsafe {
            let slot : ptr<i64> = self.scratch.at() as ptr<i64>;
            QueryPerformanceCounter(slot);
            self.origin = *slot;
        }
    }

    /** Ticks of the performance counter per second. */
    fn frequency(self) : i64 {
        return self.freq;
    }

    /** The raw performance counter — `SDL_GetPerformanceCounter`. */
    fn counter(mut self) : i64 {
        unsafe {
            let slot : ptr<i64> = self.scratch.at() as ptr<i64>;
            QueryPerformanceCounter(slot);
            return *slot;
        }
    }

    /** Milliseconds since the clock started — `SDL_GetTicks`. */
    fn ticks(mut self) : i64 {
        return ((self.counter() - self.origin) * CLOCK_MS_PER_SEC) / self.freq;
    }

    /** Microseconds since the clock started. */
    fn micros(mut self) : i64 {
        return ((self.counter() - self.origin) * CLOCK_US_PER_SEC) / self.freq;
    }

    /** Seconds since the clock started, as a fraction. */
    fn seconds(mut self) : f64 {
        return (self.micros() as f64) / (CLOCK_US_PER_SEC as f64);
    }

    /** Hand the rest of `ms` back to the scheduler — `SDL_Delay`. */
    fn delay(self, ms : i32) : void {
        if (ms > 0) {
            Sleep(ms);
        }
    }

    /**
     * Wait until `deadlineUs` microseconds have elapsed since the clock
     * started, then return — the frame pacer.
     *
     * Sleeps while more than `CLOCK_SPIN_MARGIN_US` remains and spins the
     * rest, which is what keeps a 16.67 ms frame from becoming 17.9 ms.
     */
    fn delayUntil(mut self, deadlineUs : i64) : void {
        let remaining : i64 = deadlineUs - self.micros();
        if (remaining > CLOCK_SPIN_MARGIN_US) {
            let sleepable : i64 = remaining - CLOCK_SPIN_MARGIN_US;
            Sleep((sleepable / CLOCK_MS_PER_SEC) as i32);
        }
        while (self.micros() < deadlineUs) {
            // Spin. The margin above keeps this under two milliseconds.
        }
    }

    /** Release the scratch block. */
    fn close(self) : void {
        self.scratch.close();
    }
}
