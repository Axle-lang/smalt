// mouse — pointer position, buttons, wheel, and relative motion.
//
// Two coordinate stories, and they are not one. `x` / `y` are the pointer's
// position in the window's client area, which is what a menu or a
// cursor needs. `dx` / `dy` are the motion accumulated since the last
// pump, which is what a first-person camera needs — and the two are not
// interchangeable: a camera driven by absolute position stops turning
// the moment the pointer reaches the edge of the screen.
//
// Relative mode keeps the pointer pinned to the centre of the window and
// hidden, so motion never runs out of room. That is a per-frame recentre
// rather than a raw-input device registration, which keeps the whole
// mechanism inside the polled model the library is built on.

/** Longest gap between presses that still make a double click, in milliseconds. */
const CLICK_INTERVAL_MS : i64 = 500;

/** Furthest the pointer may move between presses that still make a double click, in pixels. */
const CLICK_SLOP : i32 = 4;

/** Buttons, numbered as the OS numbers them: 1 is the left one. */
pub enum MouseButton : i8 {
    Left = 1,
    Middle = 2,
    Right = 3,
    X1 = 4,
    X2 = 5,
}

/**
 * The pointer's state: where it is, what is held, and how far it moved
 * since the last pump.
 */
pub class MouseState {
    x        : i32 = 0;
    y        : i32 = 0;
    dx       : i32 = 0;
    dy       : i32 = 0;
    wheel    : i32 = 0;
    buttons  : i32 = 0;
    relative : bool = false;
    primed   : bool = false;
    inside   : bool = false;

    /** The button, time and place of the last press, and how many in a row it made. */
    lastButton : i32 = 0;
    lastStamp  : i64 = 0;
    lastX      : i32 = 0;
    lastY      : i32 = 0;
    clickRun   : i32 = 0;

    /**
     * Whether a real pointer position has been seen yet.
     *
     * The first motion message must not produce a delta: the previous
     * position is the constructor's `(0, 0)`, not anywhere the pointer
     * has been, and a camera fed that delta snaps violently on the first
     * mouse move of the program.
     */
    pub fn isPrimed(self) : bool {
        return self.primed;
    }

    /** The bit `b` occupies in the button mask. */
    pub(file) static fn maskOf(b : MouseButton) : i32 {
        return 1 << ((b as i32) - 1);
    }

    /** Pointer x, in client pixels. */
    pub fn posX(self) : i32 {
        return self.x;
    }

    /** Pointer y, in client pixels. */
    pub fn posY(self) : i32 {
        return self.y;
    }

    /** Horizontal motion accumulated since the previous pump. */
    pub fn deltaX(self) : i32 {
        return self.dx;
    }

    /** Vertical motion accumulated since the previous pump. */
    pub fn deltaY(self) : i32 {
        return self.dy;
    }

    /** Wheel notches since the previous pump; positive is away from the user. */
    pub fn wheelDelta(self) : i32 {
        return self.wheel;
    }

    /** Whether `b` is held. */
    pub fn isDown(self, b : MouseButton) : bool {
        return (self.buttons & MouseState::maskOf(b)) != 0;
    }

    /** Whether the pointer is pinned and hidden for relative motion. */
    pub fn isRelative(self) : bool {
        return self.relative;
    }

    /** Whether the pointer is over the window's client area. */
    pub fn isInside(self) : bool {
        return self.inside;
    }

    /** Whether any button is held. */
    pub fn anyDown(self) : bool {
        return self.buttons != 0;
    }

    /** Record that the pointer is over the client area or not. */
    pub(crate) fn setInside(mut self, inside : bool) : void {
        self.inside = inside;
    }

    /**
     * Count a press of `b` at (`x`, `y`) at time `stamp`: 1 for a first
     * click, 2 when it follows a press of the same button within half a
     * second and four pixels, 3 for the next, and so on.
     */
    pub(crate) fn countClick(mut self, b : MouseButton, stamp : i64, x : i32, y : i32) : i32 {
        let near : bool = (x - self.lastX).abs() <= CLICK_SLOP && (y - self.lastY).abs() <= CLICK_SLOP;
        if (self.clickRun > 0 && (b as i32) == self.lastButton && stamp - self.lastStamp <= CLICK_INTERVAL_MS && near) {
            self.clickRun += 1;
        } else {
            self.clickRun = 1;
        }
        self.lastButton = b as i32;
        self.lastStamp = stamp;
        self.lastX = x;
        self.lastY = y;
        return self.clickRun;
    }

    /** Record `b` as held. */
    pub(crate) fn press(mut self, b : MouseButton) : void {
        self.buttons |= MouseState::maskOf(b);
    }

    /** Record `b` as released. */
    pub(crate) fn release(mut self, b : MouseButton) : void {
        self.buttons &= ~MouseState::maskOf(b);
    }

    /** Move the pointer to a client-area position, accumulating the delta. */
    pub(crate) fn moveTo(mut self, nx : i32, ny : i32) : void {
        if (self.primed) {
            self.dx += nx - self.x;
            self.dy += ny - self.y;
        }
        self.x = nx;
        self.y = ny;
        self.primed = true;
    }

    /** Place the pointer without producing motion — the relative-mode recentre. */
    pub(crate) fn warpTo(mut self, nx : i32, ny : i32) : void {
        self.x = nx;
        self.y = ny;
        self.primed = true;
    }

    /** Accumulate `notches` of wheel travel. */
    pub(crate) fn scroll(mut self, notches : i32) : void {
        self.wheel += notches;
    }

    /** Enter or leave relative mode. */
    pub(crate) fn setRelative(mut self, on : bool) : void {
        self.relative = on;
    }

    /** Drop the per-frame accumulators. Called at the top of every pump. */
    pub(crate) fn newFrame(mut self) : void {
        self.dx = 0;
        self.dy = 0;
        self.wheel = 0;
    }

    /** Release every button — the focus-loss counterpart of `releaseAll`. */
    pub(crate) fn releaseAll(mut self) : void {
        self.buttons = 0;
    }
}
