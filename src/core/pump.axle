// pump — the event subsystem: one call a frame, everything that happened.
//
// `Events` is what a game holds. It owns the queue, the keyboard and
// mouse state, and the reusable OS event record, and it is where the two
// halves of the input story are joined: what the platform reports as a
// stream (`SysDrain::drain` — every keyboard and mouse input) and what
// it latches on the window (a close request, a resize, a focus or
// minimise edge).
//
// The split is the platform's, not this file's, and it differs: Win32
// posts input to a thread queue and *sends* the window messages straight
// to a procedure, while X11 delivers both down one connection. Which is
// exactly why the drain takes the window — a port latches the edges
// inside its own loop, and this file reads them the same way either way.
//
// `pump` takes the window because that is where the edges are latched
// — a close request, a resize, a focus or minimise change all belong to
// one window, and a process may have more than one.

use crate::core::event::{Event, EventKind, EventQueue};
use crate::core::timer::Clock;
use crate::core::keyboard::{KeyboardState, Scancode};
use crate::core::mouse::{MouseButton, MouseState};
use crate::kernel::blob::Blob;
use crate::video::sys_cursor::SysCursor;
use crate::video::sys_drain::SysDrain;
use crate::video::window::Window;

/**
 * The event subsystem.
 *
 * The frame shape a game writes:
 *
 * ```
 * events.pump(win, clock);
 * while (events.hasNext()) {
 *     let e = events.next();
 *     ...
 * }
 * if (events.isKeyDown(Scancode::W)) { ... }
 * ```
 *
 * Edge events come out of the queue; held state is read straight off
 * this object. The split is the point: an edge is a thing that
 * happened once and must not be missed, and held state is a question
 * with an answer right now.
 */
pub class Events : Closeable {
    queue         : EventQueue;
    keys          : KeyboardState;
    mouse         : MouseState;
    msg           : Blob;
    sentQuit      : bool;

    /**
     * A relative-mouse change waiting for a window to apply it to.
     *
     * The pointer's visibility is a property of a *window* on one of the
     * two platforms and of the process on the other, and `setRelativeMouse`
     * is handed neither. So the request is latched and applied in `pump`,
     * which has the window — one frame later, which is a frame in which
     * the pointer is already pinned and only its visibility lags.
     */
    cursorPending : bool;

    /** A pump with an empty queue and nothing held. */
    constructor() {
        self.queue = new EventQueue();
        self.keys = new KeyboardState();
        self.mouse = new MouseState();
        self.msg = SysDrain::newScratch();
        self.sentQuit = false;
        self.cursorPending = false;
    }

    /** Whether an event is waiting. */
    fn hasNext(self) : bool {
        return self.queue.hasNext();
    }

    /** The next event, or the empty event when none is waiting. */
    fn next(mut self) : Event {
        return self.queue.next();
    }

    /** Whether the physical key `sc` is held. */
    fn isKeyDown(self, sc : Scancode) : bool {
        return self.keys.isDown(sc);
    }

    /** Whether the mouse button `b` is held. */
    fn isButtonDown(self, b : MouseButton) : bool {
        return self.mouse.isDown(b);
    }

    /** Pointer x, in client pixels. */
    fn mouseX(self) : i32 {
        return self.mouse.posX();
    }

    /** Pointer y, in client pixels. */
    fn mouseY(self) : i32 {
        return self.mouse.posY();
    }

    /** Horizontal pointer motion during the last pump. */
    fn mouseDX(self) : i32 {
        return self.mouse.deltaX();
    }

    /** Vertical pointer motion during the last pump. */
    fn mouseDY(self) : i32 {
        return self.mouse.deltaY();
    }

    /** Wheel notches during the last pump. */
    fn mouseWheel(self) : i32 {
        return self.mouse.wheelDelta();
    }

    /** Whether the pointer is pinned and hidden for relative motion. */
    fn isRelativeMouse(self) : bool {
        return self.mouse.isRelative();
    }

    /**
     * Pin and hide the pointer so motion never runs out of screen.
     *
     * The pointer is recentred at the end of every pump while this is
     * on, so `mouseDX` / `mouseDY` keep reporting motion however far the
     * player turns.
     */
    fn setRelativeMouse(mut self, on : bool) : void {
        if (self.mouse.isRelative() == on) {
            return;
        }
        self.mouse.setRelative(on);
        self.cursorPending = true;
    }

    /**
     * Collect everything that happened since the previous call.
     *
     * The clock is read once, so a frame's events share one timestamp
     * rather than a spread of readings taken while draining.
     */
    fn pump(mut self, win : Window, clock : Clock) : void {
        let stamp = clock.ticks();
        self.mouse.newFrame();
        if (self.cursorPending) {
            SysCursor::showCursor(win.native(), !self.mouse.isRelative());
            self.cursorPending = false;
        }
        SysDrain::drain(self.msg, win.native(), stamp, self.queue, self.keys, self.mouse);

        // A close the user asked for. The procedure records `WM_CLOSE`
        // rather than obeying it, so the window is still alive here and
        // the game decides — which is the difference between `Quit` being
        // an event and being an obituary.
        if (win.takeCloseRequest()) {
            if (!self.sentQuit) {
                self.queue.push(Event { kind: EventKind::Quit, timestamp: stamp });
                self.sentQuit = true;
            }
        }

        if (!win.isOpen()) {
            if (!self.sentQuit) {
                self.queue.push(Event { kind: EventKind::Quit, timestamp: stamp });
                self.sentQuit = true;
            }
            return;
        }

        if (win.syncSize()) {
            self.queue.push(
                Event {
                    kind: EventKind::WindowResized,
                    timestamp: stamp,
                    width: win.width(),
                    height: win.height(),
                }
            );
        }

        let focused = win.focused();
        if (win.takeFocusEdge()) {
            if (focused) {
                self.queue.push(Event { kind: EventKind::WindowFocusGained, timestamp: stamp });
            } else {
                // The key-up for anything held now goes to whichever
                // application took focus, so releasing here is what stops
                // the player walking into a wall after an Alt-Tab.
                self.keys.releaseAll();
                self.mouse.releaseAll();
                self.queue.push(Event { kind: EventKind::WindowFocusLost, timestamp: stamp });
            }
        }

        let minimised = win.minimised();
        if (win.takeMinimiseEdge()) {
            if (minimised) {
                self.queue.push(Event { kind: EventKind::WindowMinimised, timestamp: stamp });
            } else {
                self.queue.push(Event { kind: EventKind::WindowRestored, timestamp: stamp });
            }
        }

        if (self.mouse.isRelative() && focused && !minimised) {
            let cx = win.width() / 2;
            let cy = win.height() / 2;
            SysCursor::recentre(win.native(), cx, cy);
            self.mouse.warpTo(cx, cy);
        }
    }

    /** Release the message block. */
    fn close(self) : void {
        self.msg.close();
    }
}
