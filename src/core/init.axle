// init — the library's entry object, the counterpart of `SDL_Init`.
//
// SDL keeps its video device in a file-static `_this` and reads it from
// every public function. Axle has no mutable global state, so what SDL
// hides in a global is an explicit object here: `Platform` owns the module
// handle, the registered window class and the raised timer resolution,
// and windows are created *from* it. That is a better contract anyway —
// the lifetime of the subsystem is visible in the source.
//
// What SDL reports through a return code and `SDL_GetError`, the
// constructor reports by raising `PlatformError`: a `Platform` that exists is an
// initialised one, so nothing downstream tests a half-built subsystem.

use crate::core::error::PlatformError;
use crate::platform::sys_app::SysApp;
use crate::video::window::Window;
use crate::video::windows::win_class::WinClass;

/** The scheduler granularity the frame pacer asks for, in milliseconds. */
const TIMER_PERIOD_MS : i32 = 1;

/**
 * The initialised library.
 *
 * One per process. Create it first and close it before returning from
 * `main` — it lowers the timer resolution it raised, which is
 * process-wide state the OS does not clean up for a program that merely
 * exits, so `Closeable` is what makes the compiler insist on it.
 */
pub class Platform : Closeable {
    instance : ptr;
    timerRaised : bool;

    /** Initialise the video and event subsystems. */
    constructor() ! PlatformError {
        self.instance = SysApp::instance();
        if (SysApp::isNil(self.instance)) {
            throw PlatformError("GetModuleHandleW returned no module handle");
        }
        if (!WinClass::register(self.instance)) {
            throw PlatformError("RegisterClassExW failed for the smalt window class");
        }
        self.timerRaised = SysApp::raiseTimerRes();
    }

    /** Open a window with a `w` by `h` client area. */
    fn createWindow(self, title : string, w : i32, h : i32, flags : i32) : Window ! PlatformError {
        return new Window(self.instance, title, w, h, flags)?;
    }

    /**
     * Release what initialisation acquired.
     *
     * The window class is deliberately left registered: it is owned by
     * the module for the process's lifetime, and unregistering it while
     * a window still exists fails anyway.
     */
    fn close(self) : void {
        if (self.timerRaised) {
            SysApp::lowerTimerRes();
        }
    }
}
