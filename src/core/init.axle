// init — the library's entry object: the subsystem, as a value.
//
// The state a platform layer needs — the process's token on the OS,
// whatever had to be registered before a window can exist, the scheduler
// granularity a frame pacer asked for — is state with a *lifetime*. Put
// it in a global and that lifetime becomes invisible: nothing in the
// source says when it began, nothing says when it ends, and every
// function that reads it is one more place that assumes it began.
//
// So it is an object. `Platform` owns those three things and windows are
// created *from* it, which makes the subsystem's lifetime the object's
// lifetime and puts it in the reader's line of sight.
//
// Failure is in the constructor: it raises `PlatformError` rather than
// returning a code, so a `Platform` that exists is an initialised one
// and nothing downstream tests a half-built subsystem.
//
// Nothing here names an operating system. The three steps — take the
// process's token, prepare whatever must exist before a window can, and
// ask for the scheduler granularity a frame pacer needs — are
// `platform::sys_app`'s, and what each costs differs per target: on
// Win32 the middle step registers a window class, on X11 there is
// nothing to prepare and the token itself is the connection to release.

use crate::core::error::PlatformError;
use crate::platform::sys_app::SysApp;
use crate::video::window::Window;

/**
 * The initialised library.
 *
 * One per process. Create it first and close it before returning from
 * `main` — it lowers the timer resolution it raised, which is
 * process-wide state the OS does not clean up for a program that merely
 * exits, so `Closeable` is what makes the compiler insist on it.
 */
pub class Platform : Closeable {
    instance    : ptr;
    timerRaised : bool;

    /**
     * Whether the OS records this build's platform backend fills are the
     * ones the OS reads — 0 when they agree, otherwise which check
     * failed.
     *
     * Static, and callable before initialisation: what it answers is a
     * property of the compiled backend, not of a running subsystem, and
     * a program that is going to check it should check it before it
     * opens anything. A platform whose backend fills no OS record
     * answers 0.
     */
    static fn checkRecords() : i32 {
        return SysApp::checkRecords();
    }

    /** Initialise the video and event subsystems. */
    constructor() ! PlatformError {
        self.instance = SysApp::instance();
        if (SysApp::isNil(self.instance)) {
            throw PlatformError("GetModuleHandleW returned no module handle");
        }
        if (!SysApp::prepareWindows(self.instance)) {
            throw PlatformError("the platform refused to prepare the window subsystem");
        }
        self.timerRaised = SysApp::raiseTimerRes();
    }

    /** Open a window with a `w` by `h` client area. */
    fn createWindow(self, title : string, w : i32, h : i32, flags : i32) : Window ! PlatformError {
        return new Window(self.instance, title, w, h, flags)?;
    }

    /**
     * Release what initialisation acquired.
     *
     * The order is the reverse of the constructor's, and the raise is
     * undone only if it was granted — the granularity is process-wide
     * state the OS does not reclaim for a program that merely exits,
     * which is the whole reason this class is `Closeable`.
     */
    fn close(self) : void {
        if (self.timerRaised) {
            SysApp::lowerTimerRes();
        }
        SysApp::release(self.instance);
    }
}
