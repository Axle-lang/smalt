// mesh — indexed triangles, and the primitives to get started with.
//
// A mesh is vertices plus indices, exactly as a GPU vertex buffer and
// index buffer would be, because that is the shape the rasteriser wants
// to walk and the shape a loader would produce.
//
// The arrays are `T[]` from `malloc<T>(n)`: bounds-checked, and reclaimed
// by the synthesised destructor, so unlike the OS handles elsewhere in
// the library a mesh is not `Closeable` and needs no release.
//
// No OBJ, no glTF, no loader of any kind. The primitives below are for
// geometry what the BMP decoder is for images: enough to see something
// on screen and to test the pipeline, not an asset system.

use crate::math::vec::{Vec2, Vec3};
use crate::render::vertex::Vertex;
use std::numeric::math;

/** Indexed triangle geometry. */
pub class Mesh {
    /** Corners in a triangle. */
    pub(crate) static TRIANGLE_CORNERS : i32 = 3;

    verts       : Vertex[];
    indices     : i32[];
    vertexCount : i32;
    indexCount  : i32;

    /** Storage for `vertices` corners and `indices` index slots. */
    constructor(vertices : i32, indices : i32) {
        self.vertexCount = vertices.max(1);
        self.indexCount = indices.max(Mesh::TRIANGLE_CORNERS);
        self.verts = malloc<Vertex>(self.vertexCount as i64);
        self.indices = malloc<i32>(self.indexCount as i64);
    }

    /** Corners in the mesh. */
    pub fn vertices(self) : i32 {
        return self.vertexCount;
    }

    /** Index slots in the mesh. */
    pub fn indexSlots(self) : i32 {
        return self.indexCount;
    }

    /** Triangles in the mesh. */
    pub fn triangles(self) : i32 {
        return self.indexCount / Mesh::TRIANGLE_CORNERS;
    }

    /** Write the corner at `i`. */
    pub fn setVertex(mut self, i : i32, v : Vertex) : void {
        if (i >= 0 && i < self.vertexCount) {
            self.verts[i as i64] = v;
        }
    }

    /** The corner at `i`, or an empty vertex when out of range. */
    pub fn vertex(self, i : i32) : Vertex {
        if (i < 0 || i >= self.vertexCount) {
            return Vertex::empty();
        }
        return self.verts[i as i64];
    }

    /** Write the index at slot `i`. */
    pub fn setIndex(mut self, i : i32, value : i32) : void {
        if (i >= 0 && i < self.indexCount) {
            self.indices[i as i64] = value;
        }
    }

    /** The index at slot `i`, or 0 when out of range. */
    pub fn index(self, i : i32) : i32 {
        if (i < 0 || i >= self.indexCount) {
            return 0;
        }
        return self.indices[i as i64];
    }

    /** Write one triangle's three indices at triangle `t`. */
    pub fn setTriangle(mut self, t : i32, a : i32, b : i32, c : i32) : void {
        let base = t * Mesh::TRIANGLE_CORNERS;
        self.setIndex(base, a);
        self.setIndex(base + 1, b);
        self.setIndex(base + 2, c);
    }
}

/** The built-in shapes. */
pub class Primitives {
    /**
     * A quad in the XZ plane, `size` across, centred on the origin,
     * facing +Y — a floor.
     *
     * `tiles` is how many times the texture repeats across it, applied
     * by handing out UVs beyond 1 (the sampler wraps).
     */
    pub static fn ground(size : f64, tiles : f64) : Mesh {
        let m = new Mesh(4, 6);
        let half = size * 0.5;
        let up = Vec3::unitY();
        m.setVertex(0, Vertex::make(Vec3::make(-half, 0.0, -half), up, Vec2::make(0.0, 0.0)));
        m.setVertex(1, Vertex::make(Vec3::make(half, 0.0, -half), up, Vec2::make(tiles, 0.0)));
        m.setVertex(2, Vertex::make(Vec3::make(half, 0.0, half), up, Vec2::make(tiles, tiles)));
        m.setVertex(3, Vertex::make(Vec3::make(-half, 0.0, half), up, Vec2::make(0.0, tiles)));
        m.setTriangle(0, 0, 2, 1);
        m.setTriangle(1, 0, 3, 2);
        return m;
    }

    /** The outward normal of cube face `i`. */
    pub(file) static fn faceNormal(i : i32) : Vec3 {
        return match i {
            0 => Vec3::make(1.0, 0.0, 0.0),
            1 => Vec3::make(-1.0, 0.0, 0.0),
            2 => Vec3::make(0.0, 1.0, 0.0),
            3 => Vec3::make(0.0, -1.0, 0.0),
            4 => Vec3::make(0.0, 0.0, 1.0),
            _ => Vec3::make(0.0, 0.0, -1.0),
        };
    }

    /** The in-plane axis that runs to the right of cube face `i`. */
    pub(file) static fn faceRight(i : i32) : Vec3 {
        return match i {
            0 => Vec3::make(0.0, 0.0, -1.0),
            1 => Vec3::make(0.0, 0.0, 1.0),
            2 => Vec3::make(1.0, 0.0, 0.0),
            3 => Vec3::make(1.0, 0.0, 0.0),
            4 => Vec3::make(1.0, 0.0, 0.0),
            _ => Vec3::make(-1.0, 0.0, 0.0),
        };
    }

    /**
     * An axis-aligned cube of side `size`, centred on the origin.
     *
     * Twenty-four vertices, not eight: a cube's corner has three
     * different normals and three different texture coordinates
     * depending on which face is being drawn, so sharing the corner
     * would smear the lighting across the edges and make it look like a
     * sphere.
     */
    pub static fn cube(size : f64) : Mesh {
        let m = new Mesh(24, 36);
        let h = size * 0.5;
        for (face of 0..6) {
            let normal = Primitives::faceNormal(face);
            let right = Primitives::faceRight(face);
            let up = normal.cross(right);
            let centre = normal.scaled(h);
            let base = face * 4;

            let a = centre.minus(right.scaled(h)).minus(up.scaled(h));
            let b = centre.plus(right.scaled(h)).minus(up.scaled(h));
            let c = centre.plus(right.scaled(h)).plus(up.scaled(h));
            let d = centre.minus(right.scaled(h)).plus(up.scaled(h));

            m.setVertex(base, Vertex::make(a, normal, Vec2::make(0.0, 1.0)));
            m.setVertex(base + 1, Vertex::make(b, normal, Vec2::make(1.0, 1.0)));
            m.setVertex(base + 2, Vertex::make(c, normal, Vec2::make(1.0, 0.0)));
            m.setVertex(base + 3, Vertex::make(d, normal, Vec2::make(0.0, 0.0)));

            m.setTriangle(face * 2, base, base + 1, base + 2);
            m.setTriangle(face * 2 + 1, base, base + 2, base + 3);
        }
        return m;
    }

    /**
     * A UV sphere of radius `r`, `segments` around and `rings` from pole
     * to pole.
     *
     * The normal of a sphere at a point is the point itself normalised,
     * which is what makes this the cheapest smooth-shaded test object.
     */
    pub static fn sphere(r : f64, segments : i32, rings : i32) : Mesh {
        let segs = segments.max(3);
        let rows = rings.max(2);
        let m = new Mesh((segs + 1) * (rows + 1), segs * rows * 6);
        let pi = math::pi();

        for (row of 0..=rows) {
            let phi = pi * (row as f64) / (rows as f64);
            let sp = phi.sin();
            let cp = phi.cos();
            for (seg of 0..=segs) {
                let theta = 2.0 * pi * (seg as f64) / (segs as f64);
                let normal = Vec3::make(sp * theta.cos(), cp, sp * theta.sin());
                let uv = Vec2::make((seg as f64) / (segs as f64), (row as f64) / (rows as f64));
                m.setVertex(row * (segs + 1) + seg, Vertex::make(normal.scaled(r), normal, uv));
            }
        }

        for (y of 0..rows) {
            for (x of 0..segs) {
                let i0 = y * (segs + 1) + x;
                let i1 = i0 + segs + 1;
                let t = (y * segs + x) * 2;
                m.setTriangle(t, i0, i0 + 1, i1 + 1);
                m.setTriangle(t + 1, i0, i1 + 1, i1);
            }
        }
        return m;
    }
}
