/**
 * Slot of `code` in the headline face, or `-1` when the face does
 * not carry it (the caller falls back to the UI face).
 */
pub(crate) fn bigIndex(code : i32) : i32 {
    return match code {
        32 => 0,
        48 => 1,   // 0
        49 => 2,   // 1
        50 => 3,   // 2
        51 => 4,   // 3
        52 => 5,   // 4
        53 => 6,   // 5
        54 => 7,   // 6
        55 => 8,   // 7
        56 => 9,   // 8
        57 => 10,   // 9
        46 => 11,   // .
        44 => 12,   // ,
        37 => 13,   // %
        47 => 14,   // /
        71 => 15,   // G
        77 => 16,   // M
        75 => 17,   // K
        66 => 18,   // B
        84 => 19,   // T
        105 => 20,   // i
        80 => 21,   // P
        115 => 22,   // s
        99 => 23,   // c
        112 => 24,   // p
        117 => 25,   // u
        _ => -1,
    };
}
