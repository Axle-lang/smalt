/**
 * Pen advance of each headline glyph, in `bigIndex` order.
 */
pub(crate) fn bigWidths() : i32[] {
    return [
        6, 13, 13, 13, 13, 13, 13, 13, 13, 13, 13, 6, 6, 19, 10, 16,
        21, 14, 14, 13, 6, 14, 10, 11, 14, 13
    ];
}

/**
 * The headline face, laid out like `uiGlyphs` over `BIG_H` rows.
 */
pub(crate) fn bigGlyphs() : i32[] {
