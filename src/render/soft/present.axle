// present — the framebuffer onto the screen.
//
// This file is the *render*-side view of the blit: it knows what a
// `RenderTarget` is, reads its size and its pixels, and hands them to
// `SysBlit`, which is the only thing that knows what the OS calls a
// drawable. Splitting it that way is what keeps `platform/` below
// `render/` — a blit that understood render targets would be a layer
// reaching upward, and a port would inherit that coupling for nothing.
//
// The scaling that absorbs a window resize lives under the seam, because
// what it costs differs by platform: GDI gives it away, X11 does not.

use crate::platform::sys_blit::SysBlit;
use crate::render::soft::target::RenderTarget;

/**
 * The blit path, in render terms.
 *
 * Owns the platform blit for the life of the device that owns it.
 */
pub class Presenter : Closeable {
    blit : SysBlit = new SysBlit();

    /**
     * Blit `target` into the `dstW` by `dstH` client area of `surface`.
     *
     * Scales when the two differ, which is what absorbs a window resize
     * for the frame between the resize event and the target's
     * reallocation.
     */
    pub(crate) fn present(mut self, surface : ptr, target : RenderTarget, dstW : i32, dstH : i32) : void {
        self.presentPixels(surface, target.pixels(), target.width(), target.height(), dstW, dstH);
    }

    /**
     * The same blit, for a caller that owns pixels and no depth buffer.
     *
     * `Surface` is that caller, and so is a game that fills a
     * framebuffer with a renderer of its own. Splitting it out costs one
     * call and removes the claim that a presented frame must have come
     * from the 3D pipeline — which is not true and never was.
     */
    pub(crate) fn presentPixels(
        mut self,
        surface : ptr,
        pixels : i32[],
        srcW : i32,
        srcH : i32,
        dstW : i32,
        dstH : i32
    ) : void {
        self.blit.present(surface, pixels, srcW, srcH, dstW, dstH);
    }

    /** Release the platform blit. */
    pub(crate) fn close(self) : void {
        self.blit.close();
    }
}
