// vertex — what a mesh stores per corner, and what shades it.
//
// The CPU `Vertex` carries position, normal and texture coordinate. There is
// no per-vertex colour: a tint belongs to the material, and paying 24 bytes
// a corner for a constant is what turns a mesh into a memory problem. (The
// GPU vertex `gpu::MeshBuilder` writes is another record, packed to 32
// bytes, and does carry a colour — baked light — and a texture layer.)
//
// `Material` and `DirectionalLight` live here too, because they are the
// other half of the same question — a fragment's colour is a vertex
// attribute meeting a material meeting a light.

use crate::math::vec::{Vec2, Vec3};
use crate::render::color::Color;
use std::numeric::math;

/** One corner of a triangle. */
pub struct Vertex {
    /** Position, in the mesh's own space. */
    pub position : Vec3;

    /** Unit normal, in the mesh's own space. */
    pub normal   : Vec3;

    /** Texture coordinate; (0,0) is the top-left texel. */
    pub uv       : Vec2;

    /** A vertex from its three attributes. */
    pub static fn make(position : Vec3, normal : Vec3, uv : Vec2) : Vertex {
        return Vertex { position: position, normal: normal, uv: uv };
    }

    /** A vertex with no meaningful attributes — the fill value of a fresh mesh. */
    pub static fn empty() : Vertex {
        return Vertex { position: Vec3::zero(), normal: Vec3::unitY(), uv: Vec2::zero() };
    }
}

/**
 * How a surface answers light.
 *
 * `textured` selects whether the bound texture is sampled at all; an
 * untextured material is shaded from `albedo` alone, which is what a
 * flat-coloured level geometry wants and costs no texture fetch.
 */
pub struct Material {
    /** Base colour, multiplied with the texel when `textured`. */
    pub albedo       : Color;

    /** How much of the albedo survives with no light on it, 0..1. */
    pub ambient      : f64;

    /** Strength of the specular highlight, 0 for a matte surface. */
    pub specular     : f64;

    /** Tightness of the highlight; larger is smaller and sharper. */
    pub shininess    : f64;

    /** Whether to sample the bound texture. */
    pub textured     : bool;

    /** Whether to discard triangles facing away from the camera. */
    pub cullBackface : bool;

    /**
     * How opaque the surface is, 0..1. Below 1 a GPU device blends it over
     * what is behind; the software device draws it opaque.
     */
    pub opacity      : f64 = 1.0;

    /**
     * Alpha-test threshold, 0..1: a fragment whose alpha falls below it is not
     * drawn at all (a leaf's holes). The alpha tested is the texel's times the
     * vertex colour's times `opacity`, so a half-transparent material with a
     * cutoff of 0.5 discards everything but fully opaque texels. 0 means no test.
     * GPU devices only.
     */
    pub cutoff       : f64 = 0.0;

    /**
     * How much of the sun reaches the surface, 0..1 — its diffuse term and its
     * highlight both. 0 shades from the albedo, the ambient term and the mesh's
     * baked vertex colour (plus the point lights, see `lampLight`) — the shape a
     * voxel world's pre-lit faces want. The GPU scales by it; `gpu::SoftBackend`
     * can only switch the sun on or off, so it reads below 0.5 as 0 and the rest
     * as 1; `SoftDevice` used directly ignores it.
     */
    pub directLight  : f64 = 1.0;

    /**
     * How much of the scene's point lights reaches the surface, 0..1, apart
     * from the sun: a torch lights a voxel face whose sky light is baked into
     * its vertices. GPU devices only — the CPU has no point lights.
     */
    pub lampLight    : f64 = 1.0;

    /**
     * Whether the vertex colour carries *baked light with a sky channel*.
     *
     * When set, a vertex's colour is read as light, not tint: its RGB is light from
     * emitters (torches) and its alpha is the share of the sky that reaches that
     * corner. The light on the surface is `rgb + skyLight * alpha`, where `skyLight`
     * is the scene's per-frame sky colour (`Scene::setSkyLight`). The vertices are
     * written once; the time of day is one colour. GPU devices only.
     */
    pub skyLight     : bool = false;

    /** A matte, untextured surface of colour `albedo`. */
    pub static fn matte(albedo : Color) : Material {
        return Material {
            albedo: albedo,
            ambient: 0.18,
            specular: 0.0,
            shininess: 16.0,
            textured: false,
            cullBackface: true,
        };
    }

    /** A matte, textured surface; the texel is tinted white by default. */
    pub static fn textured() : Material {
        return Material {
            albedo: Color::white(),
            ambient: 0.18,
            specular: 0.0,
            shininess: 16.0,
            textured: true,
            cullBackface: true,
        };
    }

    /**
     * A textured surface lit entirely by what the mesh's vertices carry.
     *
     * No sun, no point lights, no highlight: the ambient term is full, so the
     * result is albedo x texel x vertex colour. What a mesh whose light was
     * computed when it was built (a voxel's smooth light and ambient occlusion)
     * is drawn with. On the software device, which has no vertex colour, it
     * reads as an evenly lit textured surface.
     */
    pub static fn baked() : Material {
        return Material {
            albedo: Color::white(),
            ambient: 1.0,
            specular: 0.0,
            shininess: 16.0,
            textured: true,
            cullBackface: true,
            directLight: 0.0,
            lampLight: 0.0,
        };
    }

    /**
     * A textured surface lit by baked light with a sky channel — what a streamed voxel
     * world's faces are drawn with.
     *
     * Like `baked`, no sun reaches it — the vertex colour's alpha is read as the sky's
     * share instead, and the scene's `skyLight` colour is what moves it from noon to night
     * with no re-mesh (see `Material::skyLight`). Unlike `baked`, the point lights do: a
     * `PointLight` per torch lights the faces around it on top of the baked block light.
     */
    pub static fn voxel() : Material {
        return Material {
            albedo: Color::white(),
            ambient: 1.0,
            specular: 0.0,
            shininess: 16.0,
            textured: true,
            cullBackface: true,
            directLight: 0.0,
            skyLight: true,
        };
    }

    /** A textured surface with a highlight. */
    pub static fn glossy(specular : f64, shininess : f64) : Material {
        return Material {
            albedo: Color::white(),
            ambient: 0.15,
            specular: specular,
            shininess: shininess,
            textured: true,
            cullBackface: true,
        };
    }
}

/**
 * A light infinitely far away — the sun.
 *
 * `direction` is the direction the light **travels**, so a light coming
 * down from above points along -Y. Naming it the other way round is the
 * classic source of a scene lit from underneath.
 */
pub struct DirectionalLight {
    /** The direction the light travels; normalised on construction. */
    pub direction : Vec3;

    /** The light's colour and intensity. */
    pub color     : Color;

    /** A light of `color` travelling along `direction`. */
    pub static fn make(direction : Vec3, color : Color) : DirectionalLight {
        return DirectionalLight { direction: direction.normalized(), color: color };
    }

    /** A plain white light from above and slightly to the front-left. */
    pub static fn noon() : DirectionalLight {
        return DirectionalLight::make(Vec3::make(-0.4, -1.0, -0.35), Color::rgb(1.0, 0.98, 0.92));
    }
}
