// color — a colour as the shader sees it, and as the framebuffer stores it.
//
// Two representations, deliberately. Lighting works in floating point on
// an unbounded range, because a Lambert term times a light colour times a
// texel routinely lands above 1.0 before it is tone-mapped down. The
// framebuffer stores packed `0x00RRGGBB`, because that is what
// `StretchDIBits` reads.
//
// The packed form leaves the top byte clear, and the framebuffer's
// element type is `i32` rather than `u32`: `StretchDIBits` ignores the
// top byte of a `BI_RGB` bitmap, so an alpha channel would be storage
// nobody reads, and the buffer's element type is what `malloc<T>` and
// the blit's array decay both key on. `Color::channel` clamps to
// 0..255, so no channel ever reaches the sign bit.

/** Largest value of one packed channel. */
const COLOR_CHANNEL_MAX : f64 = 255.0;

/** Bit position of the red channel in the packed form. */
const COLOR_RED_SHIFT : i32 = 16;

/** Bit position of the green channel in the packed form. */
const COLOR_GREEN_SHIFT : i32 = 8;

/**
 * A linear colour, one `f64` per channel, nominally 0.0 to 1.0.
 *
 * Values outside that range are legal and expected mid-pipeline; they
 * are clamped once, when the colour is packed.
 */
pub struct Color {
    /** Red, 0.0 to 1.0. */
    pub r : f64;

    /** Green, 0.0 to 1.0. */
    pub g : f64;

    /** Blue, 0.0 to 1.0. */
    pub b : f64;

    /** A colour from three channel values. */
    pub static fn rgb(r : f64, g : f64, b : f64) : Color {
        return Color { r: r, g: g, b: b };
    }

    /** Black. */
    pub static fn black() : Color {
        return Color { r: 0.0, g: 0.0, b: 0.0 };
    }

    /** White. */
    pub static fn white() : Color {
        return Color { r: 1.0, g: 1.0, b: 1.0 };
    }

    /** One channel clamped to 0..255. */
    pub static fn channel(v : f64) : i32 {
        if (v <= 0.0) {
            return 0;
        }
        if (v >= 1.0) {
            return 255;
        }
        return (v * COLOR_CHANNEL_MAX).floorToInt() as i32;
    }

    /** A colour from three 0..255 integers. */
    pub static fn bytes(r : i32, g : i32, b : i32) : Color {
        return Color {
            r: (r as f64) / COLOR_CHANNEL_MAX,
            g: (g as f64) / COLOR_CHANNEL_MAX,
            b: (b as f64) / COLOR_CHANNEL_MAX,
        };
    }

    /** Pack three 0..255 integers into the framebuffer's word. */
    pub static fn packBytes(r : i32, g : i32, b : i32) : i32 {
        return ((r & 0xFF) << COLOR_RED_SHIFT) | ((g & 0xFF) << COLOR_GREEN_SHIFT) | (b & 0xFF);
    }

    /** Unpack a framebuffer word. */
    pub static fn unpack(v : i32) : Color {
        return Color::bytes(
            (v >>> COLOR_RED_SHIFT) & 0xFF,
            (v >>> COLOR_GREEN_SHIFT) & 0xFF,
            v & 0xFF
        );
    }

    /** This colour as a framebuffer word, clamped. */
    pub fn packed(self) : i32 {
        return Color::packBytes(
            Color::channel(self.r),
            Color::channel(self.g),
            Color::channel(self.b)
        );
    }

    /** This colour scaled by `k` — a light's contribution. */
    pub fn scaled(self, k : f64) : Color {
        return Color { r: self.r * k, g: self.g * k, b: self.b * k };
    }

    /** This colour added to `o` — accumulating two lights. */
    pub fn plus(self, o : Color) : Color {
        return Color { r: self.r + o.r, g: self.g + o.g, b: self.b + o.b };
    }

    /** This colour multiplied channel-wise by `o` — a texel times a tint. */
    pub fn times(self, o : Color) : Color {
        return Color { r: self.r * o.r, g: self.g * o.g, b: self.b * o.b };
    }

    // ─── The packed form, without unpacking ──────────────────────
    //
    // Everything below takes and answers a framebuffer word. That is not
    // a convenience over the struct above, it is the other half of the
    // type: a renderer blending a glyph edge, a UI tinting a row, a HUD
    // dimming a backdrop all work in 0..255 integers, and routing them
    // through three `f64` divisions and three multiplications per pixel
    // is the cost this avoids. The struct is for light, which is
    // unbounded and belongs in floating point; these are for pixels,
    // which are bytes.

    /** `v` held inside 0..255. */
    pub static fn clamp8(v : i32) : i32 {
        return v.max(0).min(255);
    }

    /** The red channel of a packed word. */
    pub static fn red(packed : i32) : i32 {
        return (packed >>> COLOR_RED_SHIFT) & 0xFF;
    }

    /** The green channel of a packed word. */
    pub static fn green(packed : i32) : i32 {
        return (packed >>> COLOR_GREEN_SHIFT) & 0xFF;
    }

    /** The blue channel of a packed word. */
    pub static fn blue(packed : i32) : i32 {
        return packed & 0xFF;
    }

    /**
     * `dst` moved `num`/`den` of the way towards `src`, per channel.
     *
     * The one mixing rule: an anti-aliased glyph edge at coverage 2 of 3,
     * a rounded corner's last column, a modal backdrop at 3 of 5, a chip's
     * fill at 1 of 4. A `den` of zero answers `dst`, so a caller computing
     * the denominator cannot trap the process on an empty range.
     */
    pub static fn mix(dst : i32, src : i32, num : i32, den : i32) : i32 {
        if (den <= 0 || num <= 0) {
            return dst;
        }
        if (num >= den) {
            return src;
        }
        let dr : i32 = Color::red(dst);
        let dg : i32 = Color::green(dst);
        let db : i32 = Color::blue(dst);
        return Color::packBytes(
            dr + ((Color::red(src) - dr) * num) / den,
            dg + ((Color::green(src) - dg) * num) / den,
            db + ((Color::blue(src) - db) * num) / den
        );
    }

    /** Every channel of `packed` scaled by `num`/`den`, clamped. */
    pub static fn scale(packed : i32, num : i32, den : i32) : i32 {
        if (den <= 0) {
            return packed;
        }
        return Color::packBytes(
            Color::clamp8((Color::red(packed) * num) / den),
            Color::clamp8((Color::green(packed) * num) / den),
            Color::clamp8((Color::blue(packed) * num) / den)
        );
    }

    /**
     * `packed` scaled by a real factor, clamped.
     *
     * The form a lighting term takes — a Lambert cosine, a distance
     * falloff — where the ratio is not two integers the caller already
     * has.
     */
    pub static fn scaleBy(packed : i32, k : f64) : i32 {
        return Color::packBytes(
            Color::clamp8(((Color::red(packed) as f64) * k).floorToInt() as i32),
            Color::clamp8(((Color::green(packed) as f64) * k).floorToInt() as i32),
            Color::clamp8(((Color::blue(packed) as f64) * k).floorToInt() as i32)
        );
    }

    /** Two packed words added channel-wise, clamped — accumulating light. */
    pub static fn add(a : i32, b : i32) : i32 {
        return Color::packBytes(
            Color::clamp8(Color::red(a) + Color::red(b)),
            Color::clamp8(Color::green(a) + Color::green(b)),
            Color::clamp8(Color::blue(a) + Color::blue(b))
        );
    }

    /** Two packed words multiplied channel-wise — a texel times a tint. */
    pub static fn modulate(a : i32, b : i32) : i32 {
        return Color::packBytes(
            (Color::red(a) * Color::red(b)) / 255,
            (Color::green(a) * Color::green(b)) / 255,
            (Color::blue(a) * Color::blue(b)) / 255
        );
    }
}
