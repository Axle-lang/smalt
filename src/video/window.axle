// window — the portable window object.
//
// A size, a title, a flag word, and a native window behind them.
// Everything platform-specific is `video::sys_window`'s, so this file
// reads as the API a game sees and nothing else — it names no OS, and
// that is checkable by reading it rather than by tracing its imports.
//
// It is a façade over one `SysWindow` rather than a second window
// object. The alternative — a `Window` per platform — would mean this
// file's twenty documented methods existed once per OS, and the public
// API of the library would be the thing kept in sync by hand. One API,
// one implementation of the seam per target.
//
// A failed creation raises `PlatformError` from the constructor, so a
// Window that exists is a window that opened: the methods below hold no
// half-built state, and the caller handles the failure once, where it
// happens. The OS handles are not reclaimed by the synthesised
// destructor, so a Window is `Closeable` and the compiler (E0511)
// refuses a path that drops one without `close()`.

use crate::core::error::PlatformError;
use crate::video::sys_window::SysWindow;

/**
 * Window creation flags, as `SDL_WindowFlags` would spell them.
 *
 * Constants rather than a class of static accessors: a `pub const`
 * crosses a crate boundary, so a consumer writes what it means and
 * combines with `|` exactly like SDL's flag word.
 *
 * ```
 * platform.createWindow("game", 1280, 720, WINDOW_RESIZABLE | WINDOW_HIDDEN);
 * ```
 */
pub const WINDOW_NONE : i32 = 0;

/** The user may resize the window; the framebuffer follows. */
pub const WINDOW_RESIZABLE : i32 = 1;

/** No caption, no border — the shape a fullscreen-ish game wants. */
pub const WINDOW_BORDERLESS : i32 = 2;

/** Create the window hidden; `show()` reveals it. */
pub const WINDOW_HIDDEN : i32 = 4;

/**
 * An on-screen window and its drawing surface.
 *
 * Holds a native window, which the synthesised destructor does not
 * reclaim — the `Closeable` contract is what releases it.
 */
pub class Window : Closeable {
    sys : SysWindow;

    /**
     * Create a window with a `w` by `h` **client** area.
     *
     * `app` is the platform token `Platform` holds; a game never builds
     * one of these directly, it calls `Platform.createWindow`. The flag
     * word is taken apart here and handed to the seam as named
     * booleans — a bit pattern crossing the seam would have to mean the
     * same thing on every platform, and what each flag costs does not.
     */
    constructor(app : ptr, title : string, w : i32, h : i32, flags : i32) ! PlatformError {
        self.sys = new SysWindow(
            app,
            title,
            w,
            h,
            (flags & WINDOW_RESIZABLE) != 0,
            (flags & WINDOW_BORDERLESS) != 0,
            (flags & WINDOW_HIDDEN) != 0
        )?;
    }

    /** Client-area width, in pixels. */
    fn width(self) : i32 {
        return self.sys.width();
    }

    /** Client-area height, in pixels. */
    fn height(self) : i32 {
        return self.sys.height();
    }

    /** The native window, for the layers that need it (`pump`, the cursor). */
    fn native(self) : SysWindow {
        return self.sys;
    }

    /** The drawable the framebuffer is blitted onto. */
    fn surface(self) : ptr {
        return self.sys.surface();
    }

    /**
     * Whether the window still exists.
     *
     * A close is a *request*, not an obituary: the window stays valid
     * until the game calls `close()`, which is what lets it prompt,
     * save, or refuse.
     */
    fn isOpen(self) : bool {
        return self.sys.alive();
    }

    /** Whether the window is minimised — the frame to skip. */
    fn minimised(self) : bool {
        return self.sys.minimised();
    }

    /** Whether the window holds input focus. */
    fn focused(self) : bool {
        return self.sys.focused();
    }

    /** Whether the user asked to close the window, clearing the request. */
    fn takeCloseRequest(mut self) : bool {
        return self.sys.takeClose();
    }

    /** Whether a focus edge is waiting, clearing it. */
    fn takeFocusEdge(mut self) : bool {
        return self.sys.takeFocusEdge();
    }

    /** Whether a minimise / restore edge is waiting, clearing it. */
    fn takeMinimiseEdge(mut self) : bool {
        return self.sys.takeMinimiseEdge();
    }

    /** Make a hidden window visible and bring it forward. */
    fn show(mut self) : void {
        self.sys.show();
    }

    /** Hide the window without destroying it. */
    fn hide(mut self) : void {
        self.sys.hide();
    }

    /** Replace the title bar text. */
    fn setTitle(mut self, title : string) : void {
        self.sys.setTitle(title);
    }

    /**
     * Take the resize the platform recorded, if there is one.
     *
     * Answers whether the client size changed, and adopts the new size
     * into `width()` / `height()`.
     */
    fn syncSize(mut self) : bool {
        return self.sys.takeResize();
    }

    /**
     * Run the platform's event path against this window — 0 when every
     * step worked, otherwise which one did not.
     *
     * A platform library is allowed to be asked whether its platform
     * layer works here, and this is the only part of it a program cannot
     * exercise on its own: the events a driver decodes arrive from the
     * OS, not from the frame loop. `examples/proc_check` is one call to
     * this plus a pump, and it needs no user at the keyboard.
     *
     * Called before a frame loop and not during one — it leaves one
     * resize waiting for the next pump.
     */
    fn selfCheckProc(mut self, width : i32, height : i32) : i32 {
        return self.sys.selfCheck(width, height);
    }

    /** Destroy the window and release what it holds. */
    fn close(self) : void {
        self.sys.close();
    }
}
