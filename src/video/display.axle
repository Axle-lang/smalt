// display — what the screen is, before a window exists.
//
// The primary display only, which answers the question a game actually
// asks at startup: how big a window may I open.
//
// Enumerating the rest is a platform question with two different
// answers. On Windows it is `EnumDisplayMonitors`, which takes a
// callback and is therefore out of reach — `EnumDisplayDevicesW` /
// `EnumDisplaySettingsW` are the callback-free pair that would fit. On
// X11 it is Xinerama or XRandR, each a separate library on the link
// line. Both fit behind `SysScreen`'s two functions; neither is written.

use crate::platform::sys_screen::SysScreen;

/** The primary display. */
pub class Display {
    /** Width of the primary display, in pixels. */
    static fn width() : i32 {
        return SysScreen::width();
    }

    /** Height of the primary display, in pixels. */
    static fn height() : i32 {
        return SysScreen::height();
    }

    /**
     * A window size that fits the primary display with room for the
     * desktop's own furniture.
     *
     * `fraction` is how much of the screen to take, 0..1. The result is
     * never smaller than 640 by 360: a window sized from a display that
     * reports nonsense should still be usable.
     *
     * The two results are named, so a caller reads `size.w` rather than
     * `size.0` and cannot pass them to `createWindow` the wrong way round
     * without the swap being visible at the call. The names are a reading
     * aid only — this is the same type as `(i32, i32)`, and a caller that
     * prefers `let (w, h) = …` is unaffected.
     */
    static fn suggestedSize(fraction : f64) : (w: i32, h: i32) {
        let f : f64 = fraction;
        if (f <= 0.0 || f > 1.0) {
            f = 0.75;
        }
        let w = ((Display::width() as f64) * f).floorToInt() as i32;
        let h = ((Display::height() as f64) * f).floorToInt() as i32;
        if (w < 640) {
            w = 640;
        }
        if (h < 360) {
            h = 360;
        }
        return (w, h);
    }
}
