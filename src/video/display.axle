// display — what the screen is, before a window exists.
//
// SDL enumerates displays and their modes through `SDL_GetDisplays` and
// `SDL_GetFullscreenDisplayModes`. Both walk a list built by the video
// driver, and on Windows SDL fills that list from `EnumDisplayMonitors`
// — which takes a callback, and so is out of reach here.
//
// What is in reach is the primary display, through `GetSystemMetrics`,
// and that answers the question a game actually asks at startup: how big
// a window may I open. Multi-monitor enumeration would need
// `EnumDisplayDevicesW` / `EnumDisplaySettingsW`, which are callback-free
// and would fit this design; they are simply not written yet.

use crate::sys::win32_user::GetSystemMetrics;
use crate::video::windows::win_const::{SM_CXSCREEN, SM_CYSCREEN};

/** The primary display. */
pub class Display {
    /** Width of the primary display, in pixels. */
    static fn width() : i32 {
        return GetSystemMetrics(SM_CXSCREEN);
    }

    /** Height of the primary display, in pixels. */
    static fn height() : i32 {
        return GetSystemMetrics(SM_CYSCREEN);
    }

    /**
     * A window size that fits the primary display with room for the
     * desktop's own furniture.
     *
     * `fraction` is how much of the screen to take, 0..1. The result is
     * never smaller than 640 by 360: a window sized from a display that
     * reports nonsense should still be usable.
     *
     * The two results are named, so a caller reads `size.w` rather than
     * `size.0` and cannot pass them to `createWindow` the wrong way round
     * without the swap being visible at the call. The names are a reading
     * aid only — this is the same type as `(i32, i32)`, and a caller that
     * prefers `let (w, h) = …` is unaffected.
     */
    static fn suggestedSize(fraction : f64) : (w: i32, h: i32) {
        let f : f64 = fraction;
        if (f <= 0.0 || f > 1.0) {
            f = 0.75;
        }
        let w = ((Display::width() as f64) * f).floorToInt() as i32;
        let h = ((Display::height() as f64) * f).floorToInt() as i32;
        if (w < 640) {
            w = 640;
        }
        if (h < 360) {
            h = 360;
        }
        return (w, h);
    }
}
