// x_keymap — an X11 keycode to a `Scancode`.
//
// One translation, and then somebody else's table. An X11 keycode is the
// kernel's evdev code plus eight — a protocol artefact, X11 reserving
// keycodes 0..7, with nothing to do with the keyboard — so this file
// takes the offset off and hands the rest to
// [`crate::video::evdev_keymap`], which the Wayland backend reads too.
//
// The mapping itself lived here once and is not duplicated now: two
// Linux backends holding two copies of the same eighty-eight-entry
// agreement between evdev and PS/2 is one copy that can drift, and the
// drift would show up as a key that works on one desktop and not the
// other.

use crate::core::keyboard::Scancode;
use crate::video::evdev_keymap::EvdevKeymap;

/** X11 reserves keycodes below this; an evdev code is the keycode minus it. */
const X_KEYCODE_OFFSET : i32 = 8;

/** The X11 keycode to a position on the keyboard. */
class XKeymap {
    /** The scancode an X11 key event names. */
    pub(crate) static fn lookup(keycode : i32) : Scancode {
        return EvdevKeymap::lookup(keycode - X_KEYCODE_OFFSET);
    }
}
