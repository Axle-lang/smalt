// sys_vk_surface — the platform seam for turning a window into a Vulkan surface.
//
// THE CONTRACT, which a port honours and nothing above it may look behind:
//
//   extension()                   the instance extension that makes a surface for
//                                 this window system
//   create(table, instance,      write the `VkSurfaceKHR` for `win` at address `out`;
//          win, out)             the `VkResult` — VK_ERROR_EXTENSION_NOT_PRESENT when
//                                 the loader has no creation command for it
//
// See `video/x11/sys_vk_surface` for why the surface is the one platform-shaped
// piece of Vulkan.
//
// Wayland: `VK_KHR_wayland_surface`, from the connection's `wl_display *` — the
// first field of the token record every window carries — and the window's
// `wl_surface`, which is the identity `handle()` already answers.
//
// One thing is different here and worth saying: a Wayland window made by this
// library has already been given a shared-memory buffer and committed once, so the
// software blit can present. Vulkan's swapchain attaches its own buffers to the
// same `wl_surface`, and a compositor takes whichever was attached last. That is
// harmless while one path presents; a program must not present through both.
// `Renderer` presents through exactly one, which is why it is the door to prefer.

use crate::kernel::raw::Raw;
use crate::sys::vk::vk_const::{
    VK_ERROR_EXTENSION_NOT_PRESENT, VK_KHR_WAYLAND_SURFACE_EXTENSION_NAME,
    VK_STRUCTURE_TYPE_WAYLAND_SURFACE_CREATE_INFO_KHR,
};
use crate::sys::vk::vk_table::VkTable;
use crate::sys::wl_token::WlApp;
use crate::video::sys_window::SysWindow;
use crate::video::wl_surface_record::VkWaylandSurfaceCreateInfoKHR;

/** A Vulkan surface, from a Wayland window. */
pub(crate) class SysVkSurface {
    /** The instance extension a surface on this window system needs. */
    pub(crate) static fn extension() : string {
        return VK_KHR_WAYLAND_SURFACE_EXTENSION_NAME;
    }

    /**
     * 0 when `VkWaylandSurfaceCreateInfoKHR` has the size and offsets the C header gives it, else the
     * number of the first check that failed — the record `create` fills, held to the
     * same check as the generated ones (`GpuCheck::surfaceRecord`).
     */
    pub(crate) static fn recordLayout() : i32 {
        if (offsetof(VkWaylandSurfaceCreateInfoKHR, pNext) != 8) {
            return 1;
        }
        if (offsetof(VkWaylandSurfaceCreateInfoKHR, flags) != 16) {
            return 2;
        }
        if (offsetof(VkWaylandSurfaceCreateInfoKHR, display) != 24) {
            return 3;
        }
        if (offsetof(VkWaylandSurfaceCreateInfoKHR, surface) != 32) {
            return 4;
        }
        if (sizeof<VkWaylandSurfaceCreateInfoKHR>() != 40) {
            return 5;
        }
        return 0;
    }

    /** Write the surface for `win` at `out`; the `VkResult` (see the contract). */
    pub(crate) static fn create(table : VkTable, instance : i64, win : SysWindow, out : i64) : i32 {
        unsafe {
            let p : ptr = table.proc(instance, "vkCreateWaylandSurfaceKHR");
            if (Raw::isNil(p)) {
                return VK_ERROR_EXTENSION_NOT_PRESENT;
            }
            let f : extern "C" (i64, ptr, ptr, ptr) => i32 = p as extern "C" (i64, ptr, ptr, ptr) => i32;
            let app : ptr<WlApp> = win.app as ptr<WlApp>;
            let info : VkWaylandSurfaceCreateInfoKHR = VkWaylandSurfaceCreateInfoKHR {
                sType: VK_STRUCTURE_TYPE_WAYLAND_SURFACE_CREATE_INFO_KHR,
                pNext: Raw::nil(),
                flags: 0,
                display: (*app).display,
                surface: win.handle(),
            };
            return f(instance, (&info) as ptr, Raw::nil(), Raw::at(out));
        }
    }
}
