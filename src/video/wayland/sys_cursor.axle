// sys_cursor — the platform seam for pinning and hiding the pointer.
//
// THE CONTRACT:
//
//   recentre(win, x, y)        put the pointer at the client-area point
//                              (x, y) of `win`
//   showCursor(win, visible)   show or hide the pointer over that window
//                              (relative-mouse mode's half)
//   setShape(win, shape)       the shape the pointer takes over that window,
//                              a `CursorShape`'s number
//
// Wayland is the platform where half of this cannot be done, and saying
// so plainly is worth more than a call that appears to work.
//
// **A client cannot move the pointer.** There is no warp request, by
// design: the compositor owns the input device and a client that could
// place the cursor could also keep it. What a mouse-look game wants
// instead is to *lock* it — `zwp_pointer_constraints_v1` locks the
// pointer in place and `zwp_relative_pointer_v1` then delivers motion as
// deltas with no position at all, which is what recentring was a way of
// faking. Both are extensions, so both need their own interface tables
// built the way [`crate::sys::xdg_shell`] builds xdg-shell's. Until they
// are, `recentre` does nothing and a caller that recentres every frame
// gets a pointer that walks to the edge and stops.
//
// **Hiding and showing both work.** A pointer's appearance is a surface
// the client hands the compositor with `set_cursor`, so handing it none is
// a hidden pointer, and showing it again hands it one — the compositor's own
// drawing of a named shape where `wp_cursor_shape_v1` is offered, and the
// built-in pointers of `video::cursor_art` where it is not. `wl_cursor` has
// the three paths.
//
// `set_cursor` is also serial-bound: it is accepted only against the
// `wl_pointer.enter` that gave this surface the pointer, and the compositor
// forgets the picture at every enter. So the window records the serial and
// a dirty flag the enter sets; a request before the first enter waits, and
// the drain repeats it after every later one.

use crate::sys::wl_token::WlApp;
use crate::video::sys_window::SysWindow;
use crate::video::wayland::wl_cursor::applyCursor;
use crate::video::wayland::wl_win_state::WlWinState;
use crate::video::wayland::wl_window_ops::{winApp, winState};

class SysCursor {
    /**
     * Nothing: the protocol has no warp. See this file's header for what
     * replaces it and what it costs.
     */
    pub(crate) static fn recentre(win : SysWindow, x : i32, y : i32) : void {}

    /** Hide the pointer over `win` for relative-mouse mode, or show the shape it was asked for. */
    pub(crate) static fn showCursor(win : SysWindow, visible : bool) : void {
        unsafe {
            let st : ptr<WlWinState> = winState(win) as ptr<WlWinState>;
            (*st).cursorHidden = 1;
            if (visible) {
                (*st).cursorHidden = 0;
            }
            (*st).cursorDirty = 1;
            applyCursor(winApp(win) as ptr<WlApp>, st);
        }
    }

    /**
     * Set the shape the pointer takes over `win` — a `CursorShape`'s number.
     *
     * Sent at once if the pointer is over the window, and in any case
     * remembered: the next enter sends it, because the compositor forgets.
     */
    pub(crate) static fn setShape(win : SysWindow, shape : i32) : void {
        unsafe {
            let st : ptr<WlWinState> = winState(win) as ptr<WlWinState>;
            (*st).cursorShape = shape;
            (*st).cursorDirty = 1;
            applyCursor(winApp(win) as ptr<WlApp>, st);
        }
    }
}
