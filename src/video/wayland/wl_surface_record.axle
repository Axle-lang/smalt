// wl_surface_record — the Vulkan surface-creation record for this window system.
//
// Declared here, not generated with the rest of `sys/vk`, because the record
// names a window-system type (`Display *`, `wl_display *`, `HWND`) the
// registry-driven generator has no business knowing. It is a file of its own
// rather than part of `sys_vk_surface` because that file is a *seam*: every
// port must offer it with the same surface (`axle ports` checks), and a record
// only this port has would be a difference in it.
//
// `SysVkSurface::recordLayout` checks its size and offsets (against the numbers the
// real header gives), and the renderer asks before it creates a surface.

/** `VkWaylandSurfaceCreateInfoKHR`. */
pub extern "C" struct VkWaylandSurfaceCreateInfoKHR {
    /** `VkStructureType sType`. */
    pub sType   : i32;

    /** `const void *pNext`. */
    pub pNext   : ptr;

    /** `VkWaylandSurfaceCreateFlagsKHR flags`. */
    pub flags   : i32;

    /** `struct wl_display *display`. */
    pub display : ptr;

    /** `struct wl_surface *surface`. */
    pub surface : ptr;
}
