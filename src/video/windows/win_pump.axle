// win_pump — Win32 messages into smalt events.
//
// This is the file the library's central compromise lives in. Because
// the window class carries `DefWindowProcW` rather than a procedure of
// ours (see `win_class`), the only messages reachable are the ones
// Windows **posts** to the thread queue. That covers every input:
// `WM_KEYDOWN` / `WM_KEYUP` / `WM_CHAR`, `WM_MOUSEMOVE`, the button
// messages, and `WM_MOUSEWHEEL`.
//
// What it does not cover is everything Windows **sends** directly to a
// window procedure: `WM_SIZE`, `WM_SETFOCUS`, `WM_KILLFOCUS`,
// `WM_CLOSE`, `WM_DESTROY`. Those are recovered by polling in
// `core::pump`, which diffs `GetClientRect`, `GetForegroundWindow`,
// `IsIconic` and `IsWindow` once per frame. `WM_CLOSE` and `WM_QUIT` are
// still matched below: they cost one comparison, and if a future path
// ever posts one the queue answers immediately instead of waiting for
// the poll.
//
// `TranslateMessage` is called after decoding, so the `WM_CHAR` it
// synthesises from a `WM_KEYDOWN` arrives on a later turn of the loop —
// which is why text and key events are independent here.

use crate::core::event::{Event, EventKind, EventQueue};
use crate::core::keyboard::{KeyboardState, Scancode};
use crate::core::mouse::{MouseButton, MouseState};
use crate::kernel::blob::Blob;
use crate::sys::win32_types::MSG;
use crate::kernel::raw::Raw;
use crate::sys::win32_user::{PeekMessageW, TranslateMessage, DispatchMessageW};
use crate::video::windows::win_const::{
    PM_REMOVE, WHEEL_DELTA, WM_CHAR, WM_CLOSE, WM_KEYDOWN, WM_KEYUP, WM_LBUTTONDOWN,
    WM_LBUTTONUP, WM_MBUTTONDOWN, WM_MBUTTONUP, WM_MOUSEMOVE, WM_MOUSEWHEEL, WM_QUIT,
    WM_RBUTTONDOWN, WM_RBUTTONUP, WM_SYSKEYDOWN, WM_SYSKEYUP,
};
use crate::video::windows::win_keymap::WinKeymap;

/** First UTF-16 high surrogate. */
const SURROGATE_LOW_BOUND : i32 = 55296;
/** Last UTF-16 low surrogate. */
const SURROGATE_HIGH_BOUND : i32 = 57343;
/** The sign boundary of a 16-bit field. */
const WORD_SIGN_BOUND : i64 = 32768;
/** One past the largest 16-bit value. */
const WORD_MODULUS : i64 = 65536;

/** Decoding of the `MSG` fields, and the drain loop over the queue. */
class WinPump {
    /** A 16-bit field read as signed — a coordinate may be off-screen. */
    static fn signedWord(v : i64) : i32 {
        let low : i64 = v & 0xFFFF;
        if (low >= WORD_SIGN_BOUND) {
            return (low - WORD_MODULUS) as i32;
        }
        return low as i32;
    }

    /** The x coordinate packed in the low half of a mouse `lParam`. */
    static fn mouseX(lp : i64) : i32 {
        return WinPump::signedWord(lp);
    }

    /** The y coordinate packed in the high half of a mouse `lParam`. */
    static fn mouseY(lp : i64) : i32 {
        return WinPump::signedWord(lp >>> 16);
    }

    /** The hardware scancode, `lParam` bits 16..23. */
    static fn scanOf(lp : i64) : i32 {
        return ((lp >>> 16) & 0xFF) as i32;
    }

    /** The extended-key prefix, `lParam` bit 24. */
    static fn extendedOf(lp : i64) : bool {
        return ((lp >>> 24) & 1) != 0;
    }

    /**
     * Whether the key was already down, `lParam` bit 30.
     *
     * This is what separates a fresh press from the hardware
     * auto-repeat, which a game must ignore for a jump but honour for a
     * text cursor.
     */
    static fn repeatOf(lp : i64) : bool {
        return ((lp >>> 30) & 1) != 0;
    }

    /** The scancode a key message names. */
    static fn keyOf(lp : i64) : Scancode {
        return WinKeymap::lookup(WinPump::scanOf(lp), WinPump::extendedOf(lp));
    }

    /** Wheel notches, from the signed high half of `wParam`. */
    static fn wheelOf(wp : i64) : i32 {
        return WinPump::signedWord(wp >>> 16) / WHEEL_DELTA;
    }

    /** The button a message names, or `Left` for a message that names none. */
    static fn buttonOf(message : i32) : MouseButton {
        return match message {
            WM_RBUTTONDOWN => MouseButton::Right,
            WM_RBUTTONUP => MouseButton::Right,
            WM_MBUTTONDOWN => MouseButton::Middle,
            WM_MBUTTONUP => MouseButton::Middle,
            _ => MouseButton::Left,
        };
    }

    /**
     * Turn one message into state changes and queued events.
     *
     * Split out of the drain loop so the loop stays a loop: this is the
     * whole translation table, and it reads as one.
     */
    static fn handle(
        message : i32,
        wp : i64,
        lp : i64,
        stamp : i64,
        queue : EventQueue,
        keys : KeyboardState,
        mouse : MouseState
    ) : void {
        if (message == WM_KEYDOWN || message == WM_SYSKEYDOWN) {
            let sc = WinPump::keyOf(lp);
            keys.press(sc);
            queue.push(Event {
                kind: EventKind::KeyDown,
                timestamp: stamp,
                scancode: sc,
                repeat: WinPump::repeatOf(lp),
            });
            return;
        }
        if (message == WM_KEYUP || message == WM_SYSKEYUP) {
            let sc = WinPump::keyOf(lp);
            keys.release(sc);
            queue.push(Event { kind: EventKind::KeyUp, timestamp: stamp, scancode: sc });
            return;
        }
        if (message == WM_CHAR) {
            let cp : i32 = (wp & 0xFFFF) as i32;
            // A surrogate half is not a character. Dropping it loses
            // astral-plane text input, which no key on a keyboard
            // produces; pairing it would need state this layer has no
            // reason to carry.
            if (cp < SURROGATE_LOW_BOUND || cp > SURROGATE_HIGH_BOUND) {
                queue.push(Event { kind: EventKind::TextInput, timestamp: stamp, text: cp });
            }
            return;
        }
        if (message == WM_MOUSEMOVE) {
            let nx = WinPump::mouseX(lp);
            let ny = WinPump::mouseY(lp);
            let known = mouse.isPrimed();
            let px = mouse.posX();
            let py = mouse.posY();
            mouse.moveTo(nx, ny);
            // The very first motion has no previous position to subtract, so
            // the delta stays at the field's own default rather than being a
            // jump from wherever the pointer happened to enter.
            let e = Event { kind: EventKind::MouseMotion, timestamp: stamp, x: nx, y: ny };
            if (known) {
                e.dx = nx - px;
                e.dy = ny - py;
            }
            queue.push(e);
            return;
        }
        if (message == WM_LBUTTONDOWN || message == WM_RBUTTONDOWN || message == WM_MBUTTONDOWN) {
            let b = WinPump::buttonOf(message);
            mouse.press(b);
            queue.push(Event {
                kind: EventKind::MouseButtonDown,
                timestamp: stamp,
                button: b,
                x: WinPump::mouseX(lp),
                y: WinPump::mouseY(lp),
            });
            return;
        }
        if (message == WM_LBUTTONUP || message == WM_RBUTTONUP || message == WM_MBUTTONUP) {
            let b = WinPump::buttonOf(message);
            mouse.release(b);
            queue.push(Event {
                kind: EventKind::MouseButtonUp,
                timestamp: stamp,
                button: b,
                x: WinPump::mouseX(lp),
                y: WinPump::mouseY(lp),
            });
            return;
        }
        if (message == WM_MOUSEWHEEL) {
            let notches = WinPump::wheelOf(wp);
            mouse.scroll(notches);
            queue.push(Event { kind: EventKind::MouseWheel, timestamp: stamp, wheel: notches });
            return;
        }
        if (message == WM_CLOSE || message == WM_QUIT) {
            queue.push(Event { kind: EventKind::Quit, timestamp: stamp });
        }
    }

    /**
     * Drain the thread's message queue into `queue`.
     *
     * `msg` is the caller's reusable `MSG` block — one allocation for the
     * life of the program rather than one per frame.
     */
    static fn drain(
        msg : Blob,
        stamp : i64,
        queue : EventQueue,
        keys : KeyboardState,
        mouse : MouseState
    ) : void {
        unsafe {
            let m : ptr<MSG> = msg.at() as ptr<MSG>;
            while (PeekMessageW(m, Raw::nil(), 0, 0, PM_REMOVE) != 0) {
                let message = (*m).message as i32;
                let wp = (*m).wParam as i64;
                let lp = (*m).lParam;
                WinPump::handle(message, wp, lp, stamp, queue, keys, mouse);
                TranslateMessage(m);
                DispatchMessageW(m);
            }
        }
    }
}
