// win_proc — the window procedure, and the block it writes into.
//
// This is the file that used not to exist. `RegisterClassExW` wants an
// `lpfnWndProc`, and an Axle function value is the fat `{ code, env }`
// pair, which is not an address a C caller can invoke — so the class
// carried `DefWindowProcW` itself and the library read what it could
// from the message *queue*. Everything Windows **sends** rather than
// posts (`WM_SIZE`, `WM_SETFOCUS`, `WM_KILLFOCUS`, `WM_CLOSE`) never
// reached a queue and was reconstructed by polling once a frame.
//
// `extern "C" (…) => R` is a thin function pointer — one machine word,
// the function's own address — and a named `fn` degrades to it at the
// boundary. So the class now carries a procedure of ours, and the sent
// messages arrive as messages.
//
// # Where the state lives
//
// A window procedure captures nothing: it is handed `hwnd` and three
// integers, and Axle has no mutable globals to reach for. The Win32
// answer is the window's own user data — the address of a block is
// stored with `SetWindowLongPtrW` at creation, and read back with
// `GetWindowLongPtrW` on every message. That block is [`WinProcState`],
// and it is the only channel between the procedure and the frame loop.
//
// It is an `extern "C" struct` because two different pieces of code read
// it at addresses each computes for itself, which is exactly the promise
// that marker makes. `sizeof<WinProcState>()` is what the block is
// allocated with, so adding a field cannot leave the allocation behind.
//
// # What the procedure must not do
//
// Throw. The unwind would cross a frame `user32` owns, which has no
// landing pad for one — the compiler refuses a throwing function at the
// boundary (E0748), and the refusal is the rule, not a convention. So
// every path here answers with a value, and anything it cannot handle is
// handed to `DefWindowProcW`.

use crate::kernel::blob::Blob;
use crate::kernel::raw::Raw;
use crate::sys::win32_user::{DefWindowProcW, GetWindowLongPtrW, SendMessageW};
use crate::video::windows::win_const::{
    GWLP_USERDATA, SIZE_MINIMIZED, WM_CLOSE, WM_DESTROY, WM_KILLFOCUS, WM_SETFOCUS, WM_SIZE,
};

/**
 * What the window procedure learned, waiting for the next pump.
 *
 * Written by [`windowProc`] through a raw pointer and drained by
 * `core::pump`; every field is a latch the reader clears, so a message
 * that arrives twice between two frames is reported once and a frame
 * that runs long loses nothing.
 *
 * `i32` rather than `bool` throughout: this record is addressed from two
 * sides and a one-byte field would leave the neighbours' offsets
 * depending on how each side rounds.
 */
pub extern "C" struct WinProcState {
    /** The user asked to close the window — `WM_CLOSE` arrived. */
    pub closePending : i32;
    /** The window was destroyed — `WM_DESTROY` arrived. */
    pub destroyed : i32;
    /** A `WM_SIZE` arrived; `width` / `height` carry its client size. */
    pub sizePending : i32;
    /** Client width from the last `WM_SIZE`. */
    pub width : i32;
    /** Client height from the last `WM_SIZE`. */
    pub height : i32;
    /** Whether the window holds input focus, as of the last message. */
    pub focused : i32;
    /** Whether the window is minimised, as of the last `WM_SIZE`. */
    pub minimised : i32;
    /** A focus edge is waiting to be reported. */
    pub focusPending : i32;
    /** A minimise / restore edge is waiting to be reported. */
    pub minimisePending : i32;
}

/**
 * The window procedure.
 *
 * A free function, not a static method: what is handed to Windows is a
 * *named function's own address*, and a method reached through a class
 * name is not one the compiler can hand out (E0748 says so). The shape of
 * the boundary decides the shape of the declaration.
 *
 * Every message this does not recognise goes to `DefWindowProcW`, which
 * is what makes the window behave like a window — the system menu, the
 * frame, the caret, alt-tab.
 */
pub fn windowProc(hwnd : ptr, msg : u32, wParam : u64, lParam : i64) : i64 {
    unsafe {
        let raw : ptr = GetWindowLongPtrW(hwnd, GWLP_USERDATA);
        // Messages arrive during `CreateWindowExW`, before the block's
        // address can be stored. There is nothing to record yet, and the
        // sizes those messages carry are re-read at the first pump.
        if (Raw::isNil(raw)) {
            return DefWindowProcW(hwnd, msg, wParam, lParam);
        }
        let st : ptr<WinProcState> = raw as ptr<WinProcState>;
        let m : i32 = msg as i32;

        if (m == WM_CLOSE) {
            // Recorded, not obeyed. `DefWindowProcW` would destroy the
            // window here, and the frame loop would find a dead handle
            // with no chance to save, prompt, or refuse.
            (*st).closePending = 1;
            return 0;
        }

        if (m == WM_DESTROY) {
            (*st).destroyed = 1;
            return 0;
        }

        if (m == WM_SIZE) {
            let minimised : i32 = 0;
            if ((wParam as i64) == (SIZE_MINIMIZED as i64)) {
                minimised = 1;
            }
            if (minimised != (*st).minimised) {
                (*st).minimised = minimised;
                (*st).minimisePending = 1;
            }
            // A minimised window reports a 0×0 client area. Recording it
            // would resize the framebuffer to nothing and the restore
            // would come back to a window with no pixels.
            if (minimised == 0) {
                (*st).width = (lParam & 0xFFFF) as i32;
                (*st).height = ((lParam >>> 16) & 0xFFFF) as i32;
                (*st).sizePending = 1;
            }
            return 0;
        }

        if (m == WM_SETFOCUS) {
            (*st).focused = 1;
            (*st).focusPending = 1;
            return 0;
        }

        if (m == WM_KILLFOCUS) {
            (*st).focused = 0;
            (*st).focusPending = 1;
            return 0;
        }

        return DefWindowProcW(hwnd, msg, wParam, lParam);
    }
}

/**
 * The block a window's procedure writes into.
 *
 * A resource rather than a field of `Window`, because its **address** is
 * what the OS holds: it has to stay where it was put for as long as the
 * window can receive a message, and a value living in a class field is
 * somewhere the compiler is entitled to move.
 */
pub class WinProcBlock : Closeable {
    mem : Blob;

    /** A block with nothing pending and focus assumed. */
    constructor() {
        self.mem = new Blob(sizeof<WinProcState>());
        unsafe {
            let st : ptr<WinProcState> = self.mem.at() as ptr<WinProcState>;
            (*st).focused = 1;
        }
    }

    /** The address stored in the window's user data. */
    fn at(self) : ptr {
        return self.mem.at();
    }

    /** Whether `WM_CLOSE` arrived, clearing the latch. */
    fn takeClose(mut self) : bool {
        unsafe {
            let st : ptr<WinProcState> = self.mem.at() as ptr<WinProcState>;
            let pending : bool = (*st).closePending != 0;
            (*st).closePending = 0;
            return pending;
        }
    }

    /** Whether `WM_DESTROY` arrived. Not a latch: destruction is final. */
    fn destroyed(self) : bool {
        unsafe {
            let st : ptr<WinProcState> = self.mem.at() as ptr<WinProcState>;
            return (*st).destroyed != 0;
        }
    }

    /** Whether a resize is waiting, clearing the latch. */
    fn takeResize(mut self) : bool {
        unsafe {
            let st : ptr<WinProcState> = self.mem.at() as ptr<WinProcState>;
            let pending : bool = (*st).sizePending != 0;
            (*st).sizePending = 0;
            return pending;
        }
    }

    /** The client width from the last `WM_SIZE`. */
    fn width(self) : i32 {
        unsafe {
            let st : ptr<WinProcState> = self.mem.at() as ptr<WinProcState>;
            return (*st).width;
        }
    }

    /** The client height from the last `WM_SIZE`. */
    fn height(self) : i32 {
        unsafe {
            let st : ptr<WinProcState> = self.mem.at() as ptr<WinProcState>;
            return (*st).height;
        }
    }

    /** Whether a focus edge is waiting, clearing the latch. */
    fn takeFocusEdge(mut self) : bool {
        unsafe {
            let st : ptr<WinProcState> = self.mem.at() as ptr<WinProcState>;
            let pending : bool = (*st).focusPending != 0;
            (*st).focusPending = 0;
            return pending;
        }
    }

    /** Whether the window holds focus. */
    fn focused(self) : bool {
        unsafe {
            let st : ptr<WinProcState> = self.mem.at() as ptr<WinProcState>;
            return (*st).focused != 0;
        }
    }

    /** Whether a minimise / restore edge is waiting, clearing the latch. */
    fn takeMinimiseEdge(mut self) : bool {
        unsafe {
            let st : ptr<WinProcState> = self.mem.at() as ptr<WinProcState>;
            let pending : bool = (*st).minimisePending != 0;
            (*st).minimisePending = 0;
            return pending;
        }
    }

    /** Whether the window is minimised. */
    fn minimised(self) : bool {
        unsafe {
            let st : ptr<WinProcState> = self.mem.at() as ptr<WinProcState>;
            return (*st).minimised != 0;
        }
    }

    /** Release the block. */
    fn close(self) : void {
        self.mem.close();
    }
}

/**
 * Deliver the four sent messages to `hwnd` and answer whether the
 * procedure recorded each — 0 when it did, otherwise the number of the
 * first that did not.
 *
 * `SendMessageW` invokes a window procedure **synchronously**, bypassing
 * the queue, so this runs the whole chain with nobody at the keyboard:
 * the class was registered with our address rather than
 * `DefWindowProcW`'s, the state block was hung off the window, the
 * procedure executed on the OS's own callback, and it wrote through the
 * raw pointer into a record both sides address for themselves.
 *
 * It lives here because this is the file that owns the procedure, and
 * because proving it from outside would mean publishing the `WM_*`
 * constants and the `user32` declarations — widening the library's
 * surface to test it.
 *
 * The messages are the real ones and the window is left as it was found:
 * a `WM_CLOSE` is *recorded*, so nothing is destroyed, and the focus
 * edge is sent both ways.
 *
 * It ends by sending one more `WM_SIZE` and **leaving it pending**, so
 * the caller's next pump has something to turn into a `WindowResized`.
 * Every check above reads its latch by clearing it — which is the whole
 * point of a latch — and a caller that then found the queue empty would
 * be watching this function's bookkeeping rather than the event path.
 */
pub fn selfCheck(hwnd : ptr, block : WinProcBlock, width : i32, height : i32) : i32 {
    let packed : i64 = (width as i64) | ((height as i64) << 16);
    unsafe {
        SendMessageW(hwnd, WM_SIZE as u32, 0, packed);
    }
    if (!block.takeResize()) {
        return 1;
    }
    if (block.width() != width || block.height() != height) {
        return 2;
    }

    unsafe {
        SendMessageW(hwnd, WM_KILLFOCUS as u32, 0, 0);
    }
    if (!block.takeFocusEdge() || block.focused()) {
        return 3;
    }
    unsafe {
        SendMessageW(hwnd, WM_SETFOCUS as u32, 0, 0);
    }
    if (!block.takeFocusEdge() || !block.focused()) {
        return 4;
    }

    unsafe {
        SendMessageW(hwnd, WM_CLOSE as u32, 0, 0);
    }
    if (!block.takeClose()) {
        return 5;
    }
    if (block.destroyed()) {
        return 6;
    }

    unsafe {
        SendMessageW(hwnd, WM_SIZE as u32, 0, packed);
    }
    return 0;
}
