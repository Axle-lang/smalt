// win_const — the Win32 manifest constants, decimalised.
//
// Every value carries its C spelling so it can be checked against
// `winuser.h` / `wingdi.h` without arithmetic. They are decimal rather
// than hex where the hex form would not fit `i32`'s positive range: the
// style words travel through the `sys/` declarations as `i32`, the width
// the Win32 prototypes take, so `0x80000000` appears here as its negated
// decimal twin rather than as a `u32` that would have to be cast back at
// every call.

// ─── Window styles (`WS_*`) ──────────────────────────────────

/** `WS_OVERLAPPEDWINDOW` (0x00CF0000) — caption, sysmenu, resize, min/max. */
const WS_OVERLAPPEDWINDOW : i32 = 13565952;

/** `WS_VISIBLE` (0x10000000). */
const WS_VISIBLE : i32 = 268435456;

/** `WS_CAPTION` (0x00C00000). */
const WS_CAPTION : i32 = 12582912;

/** `WS_SYSMENU` (0x00080000). */
const WS_SYSMENU : i32 = 524288;

/** `WS_THICKFRAME` (0x00040000) — the resize border. */
const WS_THICKFRAME : i32 = 262144;

/** `WS_MINIMIZEBOX` (0x00020000). */
const WS_MINIMIZEBOX : i32 = 131072;

/** `WS_MAXIMIZEBOX` (0x00010000). */
const WS_MAXIMIZEBOX : i32 = 65536;

/** `WS_CLIPCHILDREN` (0x02000000). */
const WS_CLIPCHILDREN : i32 = 33554432;

/** `WS_CLIPSIBLINGS` (0x04000000). */
const WS_CLIPSIBLINGS : i32 = 67108864;

/** `WS_POPUP` (0x80000000) — a borderless window's base style. */
const WS_POPUP : i32 = -2147483648;

/** `WS_EX_APPWINDOW` (0x00040000) — force a taskbar button. */
const WS_EX_APPWINDOW : i32 = 262144;

/** `CW_USEDEFAULT` ((int)0x80000000) — let Windows place the window. */
const CW_USEDEFAULT : i32 = -2147483648;

// ─── Class styles (`CS_*`) ───────────────────────────────────

/** `CS_VREDRAW` (0x0001). */
const CS_VREDRAW : i32 = 1;

/** `CS_HREDRAW` (0x0002). */
const CS_HREDRAW : i32 = 2;

/** `CS_OWNDC` (0x0020) — a private DC, so `GetDC` is cheap every frame. */
const CS_OWNDC : i32 = 32;

/** `IDC_ARROW` (32512) — passed where a `LPCWSTR` is expected, as an atom. */
const IDC_ARROW : i64 = 32512;

// ─── ShowWindow commands (`SW_*`) ────────────────────────────

/** `SW_HIDE`. */
const SW_HIDE : i32 = 0;

/** `SW_SHOWNORMAL`. */
const SW_SHOWNORMAL : i32 = 1;

/** `SW_SHOW`. */
const SW_SHOW : i32 = 5;

// ─── Messages (`WM_*`) ───────────────────────────────────────

/** `WM_DESTROY` (0x0002). */
const WM_DESTROY : i32 = 2;

/** `WM_CLOSE` (0x0010). */
const WM_CLOSE : i32 = 16;

/** `WM_QUIT` (0x0012). */
const WM_QUIT : i32 = 18;

/** `WM_SIZE` (0x0005) — sent, so only a procedure of ours sees it. */
const WM_SIZE : i32 = 5;

/** `WM_SETFOCUS` (0x0007) — sent. */
const WM_SETFOCUS : i32 = 7;

/** `WM_KILLFOCUS` (0x0008) — sent. */
const WM_KILLFOCUS : i32 = 8;

/** `WM_KEYDOWN` (0x0100). */
const WM_KEYDOWN : i32 = 256;

/** `WM_KEYUP` (0x0101). */
const WM_KEYUP : i32 = 257;

/** `WM_CHAR` (0x0102) — synthesised by `TranslateMessage`. */
const WM_CHAR : i32 = 258;

/** `WM_SYSKEYDOWN` (0x0104) — Alt-combinations, and F10. */
const WM_SYSKEYDOWN : i32 = 260;

/** `WM_SYSKEYUP` (0x0105). */
const WM_SYSKEYUP : i32 = 261;

/** `WM_MOUSEMOVE` (0x0200). */
const WM_MOUSEMOVE : i32 = 512;

/** `WM_LBUTTONDOWN` (0x0201). */
const WM_LBUTTONDOWN : i32 = 513;

/** `WM_LBUTTONUP` (0x0202). */
const WM_LBUTTONUP : i32 = 514;

/** `WM_RBUTTONDOWN` (0x0204). */
const WM_RBUTTONDOWN : i32 = 516;

/** `WM_RBUTTONUP` (0x0205). */
const WM_RBUTTONUP : i32 = 517;

/** `WM_MBUTTONDOWN` (0x0207). */
const WM_MBUTTONDOWN : i32 = 519;

/** `WM_MBUTTONUP` (0x0208). */
const WM_MBUTTONUP : i32 = 520;

/** `WM_MOUSEWHEEL` (0x020A) — the delta is the high word of `wParam`. */
const WM_MOUSEWHEEL : i32 = 522;

/** `PM_REMOVE` (0x0001) — take the message off the queue. */
const PM_REMOVE : i32 = 1;

/** One notch of the wheel, `WHEEL_DELTA`. */
const WHEEL_DELTA : i32 = 120;

// The GDI raster ops and the `SM_*` metrics live in `sys/win32_const`
// instead: `platform/` reads them, and it sits below this folder.

// ─── Window procedure ────────────────────────────────────────

/**
 * `GWLP_USERDATA` (-21) — the per-window slot the procedure's state
 * block is addressed through. The one place a window procedure, which
 * captures nothing, can find what belongs to *this* window.
 */
const GWLP_USERDATA : i32 = -21;

/** `SIZE_MINIMIZED` (1) — the `wParam` of a `WM_SIZE` that minimised. */
const SIZE_MINIMIZED : i32 = 1;
