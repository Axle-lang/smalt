// mat — 4x4 matrices: model, view and projection.
//
// Sixteen named fields rather than a `f64[16]`. A struct is a value, so
// a matrix costs no allocation, copies cleanly and can sit inline in an
// array; addressing it by name also means a transposition typo is a
// compile error rather than a scene that is subtly inside out.
//
// Conventions, stated once because everything downstream depends on them:
//
//   * **Row-major storage**, `mRC` = row R, column C.
//   * **Column-vector multiplication**: a point is transformed as
//     `v' = M * v`, so composing reads right-to-left —
//     `projection.mul(view).mul(model)`.
//   * **Right-handed space**, the camera looking down **-Z**, +Y up.
//     That is OpenGL's convention.
//
// Every constructor that divides guards its divisor first: division
// traps in Axle, so a zero aspect ratio or a zero-depth frustum would
// abort the process rather than produce an infinity.
//
// **Every field defaults to the identity's value**, so a factory names
// only the cells it changes:
//
//     pub static fn translation(v : Vec3) : Mat4 {
//         return Mat4 { m03: v.x, m13: v.y, m23: v.z };
//     }
//
// That is not shorthand for its own sake. The alternative is a call
// taking sixteen positional `f64`s, where a transposed pair is invisible
// at the call site and silently produces a scene that is inside out —
// and this library had fourteen of them, `mul` and `transposed` included.
// Those two are where it mattered most: one is a table of sums that all
// look alike, and the other is a transposition, so a swapped pair there
// is a bug that reads as correct code.
//
// There is no sixteen-argument `rows` any more. It was the last caller of
// its own shape, and publishing it would have published the mistake back
// — a caller genuinely holding sixteen numbers in row order writes the
// literal, and gets each one checked against the cell it names.

use crate::math::vec::{Vec3, Vec4};
use std::numeric::math;

/** Below this, a divisor is treated as zero and the safe fallback is used. */
const MAT_EPSILON : f64 = 0.000000001;

/** A 4x4 transform. */
pub struct Mat4 {
    /** Row 0, column 0. */
    pub m00 : f64 = 1.0;

    /** Row 0, column 1. */
    pub m01 : f64 = 0.0;

    /** Row 0, column 2. */
    pub m02 : f64 = 0.0;

    /** Row 0, column 3. */
    pub m03 : f64 = 0.0;

    /** Row 1, column 0. */
    pub m10 : f64 = 0.0;

    /** Row 1, column 1. */
    pub m11 : f64 = 1.0;

    /** Row 1, column 2. */
    pub m12 : f64 = 0.0;

    /** Row 1, column 3. */
    pub m13 : f64 = 0.0;

    /** Row 2, column 0. */
    pub m20 : f64 = 0.0;

    /** Row 2, column 1. */
    pub m21 : f64 = 0.0;

    /** Row 2, column 2. */
    pub m22 : f64 = 1.0;

    /** Row 2, column 3. */
    pub m23 : f64 = 0.0;

    /** Row 3, column 0. */
    pub m30 : f64 = 0.0;

    /** Row 3, column 1. */
    pub m31 : f64 = 0.0;

    /** Row 3, column 2. */
    pub m32 : f64 = 0.0;

    /** Row 3, column 3. */
    pub m33 : f64 = 1.0;

    /** The identity. */
    pub static fn identity() : Mat4 {
        // One field named, because an empty struct literal is not a
        // form the parser accepts. Every other cell is its default.
        return Mat4 { m00: 1.0 };
    }

    /** A translation by `v`. */
    pub static fn translation(v : Vec3) : Mat4 {
        return Mat4 { m03: v.x, m13: v.y, m23: v.z };
    }

    /** A non-uniform scale by `v`. */
    pub static fn scaling(v : Vec3) : Mat4 {
        return Mat4 { m00: v.x, m11: v.y, m22: v.z };
    }

    /** A rotation of `radians` about +X. */
    pub static fn rotationX(radians : f64) : Mat4 {
        let c = radians.cos();
        let s = radians.sin();
        return Mat4 { m11: c, m12: -s, m21: s, m22: c };
    }

    /** A rotation of `radians` about +Y. */
    pub static fn rotationY(radians : f64) : Mat4 {
        let c = radians.cos();
        let s = radians.sin();
        return Mat4 { m00: c, m02: s, m20: -s, m22: c };
    }

    /** A rotation of `radians` about +Z. */
    pub static fn rotationZ(radians : f64) : Mat4 {
        let c = radians.cos();
        let s = radians.sin();
        return Mat4 { m00: c, m01: -s, m10: s, m11: c };
    }

    /**
     * A rotation of `radians` about an arbitrary `axis`.
     *
     * The axis is normalised here; a degenerate one yields the identity
     * rather than a matrix of NaNs.
     */
    pub static fn rotationAxis(axis : Vec3, radians : f64) : Mat4 {
        let a = axis.normalized();
        if (a.lengthSquared() < MAT_EPSILON) {
            return Mat4::identity();
        }
        let c = radians.cos();
        let s = radians.sin();
        let t : f64 = 1.0 - c;
        return Mat4 {
            m00: t * a.x * a.x + c,
            m01: t * a.x * a.y - s * a.z,
            m02: t * a.x * a.z + s * a.y,
            m10: t * a.x * a.y + s * a.z,
            m11: t * a.y * a.y + c,
            m12: t * a.y * a.z - s * a.x,
            m20: t * a.x * a.z - s * a.y,
            m21: t * a.y * a.z + s * a.x,
            m22: t * a.z * a.z + c,
        };
    }

    /**
     * A right-handed perspective projection.
     *
     * `fovY` is the vertical field of view in radians; `near` and `far`
     * are positive distances in front of the camera. A degenerate
     * argument — a zero field of view, a zero aspect, a zero-depth
     * frustum — yields the identity instead of trapping on the divide.
     */
    pub static fn perspective(fovY : f64, aspect : f64, near : f64, far : f64) : Mat4 {
        let half = (fovY * 0.5).tan();
        let depth : f64 = near - far;
        if (half < MAT_EPSILON || aspect < MAT_EPSILON) {
            return Mat4::identity();
        }
        if (depth > -MAT_EPSILON) {
            return Mat4::identity();
        }
        let f : f64 = 1.0 / half;
        // `m33` is 0 here and 1 by default, so it is named: a projection
        // is the one matrix whose bottom row is not the identity's.
        return Mat4 {
            m00: f / aspect,
            m11: f,
            m22: (far + near) / depth,
            m23: (2.0 * far * near) / depth,
            m32: -1.0,
            m33: 0.0,
        };
    }

    /**
     * A right-handed orthographic projection — shadow maps and 2D overlays.
     */
    pub static fn orthographic(
        left : f64,
        right : f64,
        bottom : f64,
        top : f64,
        near : f64,
        far : f64
    ) : Mat4 {
        let rl : f64 = right - left;
        let tb : f64 = top - bottom;
        let zRange : f64 = far - near;
        if (rl.abs() < MAT_EPSILON) {
            return Mat4::identity();
        }
        if (tb.abs() < MAT_EPSILON) {
            return Mat4::identity();
        }
        if (zRange.abs() < MAT_EPSILON) {
            return Mat4::identity();
        }
        return Mat4 {
            m00: 2.0 / rl,
            m03: -(right + left) / rl,
            m11: 2.0 / tb,
            m13: -(top + bottom) / tb,
            m22: -2.0 / zRange,
            m23: -(far + near) / zRange,
        };
    }

    /**
     * A view matrix placing the camera at `eye` looking at `target`.
     *
     * `up` only has to be non-parallel to the view direction; the true
     * up axis is rebuilt from the cross products. A parallel `up` — the
     * camera looking straight down while up is +Y — degenerates, and the
     * identity is returned rather than a scene that flips inside out.
     */
    pub static fn lookAt(eye : Vec3, target : Vec3, up : Vec3) : Mat4 {
        let forward = target.minus(eye).normalized();
        if (forward.lengthSquared() < MAT_EPSILON) {
            return Mat4::identity();
        }
        let right = forward.cross(up).normalized();
        if (right.lengthSquared() < MAT_EPSILON) {
            return Mat4::identity();
        }
        let trueUp = right.cross(forward);
        return Mat4 {
            m00: right.x,  m01: right.y,  m02: right.z,  m03: -right.dot(eye),
            m10: trueUp.x, m11: trueUp.y, m12: trueUp.z, m13: -trueUp.dot(eye),
            m20: -forward.x, m21: -forward.y, m22: -forward.z, m23: forward.dot(eye),
        };
    }

    /** This matrix times `o` — apply `o` first, then this. */
    pub fn mul(self, o : Mat4) : Mat4 {
        return Mat4 {
            m00: self.m00 * o.m00 + self.m01 * o.m10 + self.m02 * o.m20 + self.m03 * o.m30,
            m01: self.m00 * o.m01 + self.m01 * o.m11 + self.m02 * o.m21 + self.m03 * o.m31,
            m02: self.m00 * o.m02 + self.m01 * o.m12 + self.m02 * o.m22 + self.m03 * o.m32,
            m03: self.m00 * o.m03 + self.m01 * o.m13 + self.m02 * o.m23 + self.m03 * o.m33,
            m10: self.m10 * o.m00 + self.m11 * o.m10 + self.m12 * o.m20 + self.m13 * o.m30,
            m11: self.m10 * o.m01 + self.m11 * o.m11 + self.m12 * o.m21 + self.m13 * o.m31,
            m12: self.m10 * o.m02 + self.m11 * o.m12 + self.m12 * o.m22 + self.m13 * o.m32,
            m13: self.m10 * o.m03 + self.m11 * o.m13 + self.m12 * o.m23 + self.m13 * o.m33,
            m20: self.m20 * o.m00 + self.m21 * o.m10 + self.m22 * o.m20 + self.m23 * o.m30,
            m21: self.m20 * o.m01 + self.m21 * o.m11 + self.m22 * o.m21 + self.m23 * o.m31,
            m22: self.m20 * o.m02 + self.m21 * o.m12 + self.m22 * o.m22 + self.m23 * o.m32,
            m23: self.m20 * o.m03 + self.m21 * o.m13 + self.m22 * o.m23 + self.m23 * o.m33,
            m30: self.m30 * o.m00 + self.m31 * o.m10 + self.m32 * o.m20 + self.m33 * o.m30,
            m31: self.m30 * o.m01 + self.m31 * o.m11 + self.m32 * o.m21 + self.m33 * o.m31,
            m32: self.m30 * o.m02 + self.m31 * o.m12 + self.m32 * o.m22 + self.m33 * o.m32,
            m33: self.m30 * o.m03 + self.m31 * o.m13 + self.m32 * o.m23 + self.m33 * o.m33,
        };
    }

    /** This matrix applied to a homogeneous vector. */
    pub fn apply(self, v : Vec4) : Vec4 {
        return Vec4 {
            x: self.m00 * v.x + self.m01 * v.y + self.m02 * v.z + self.m03 * v.w,
            y: self.m10 * v.x + self.m11 * v.y + self.m12 * v.z + self.m13 * v.w,
            z: self.m20 * v.x + self.m21 * v.y + self.m22 * v.z + self.m23 * v.w,
            w: self.m30 * v.x + self.m31 * v.y + self.m32 * v.z + self.m33 * v.w,
        };
    }

    /** This matrix applied to a position (translation included). */
    pub fn applyPoint(self, v : Vec3) : Vec3 {
        return self.apply(Vec4::point(v)).xyz();
    }

    /** This matrix applied to a direction (translation ignored). */
    pub fn applyDirection(self, v : Vec3) : Vec3 {
        return self.apply(Vec4::direction(v)).xyz();
    }

    /** The transpose — the inverse of a rotation, and the normal matrix's half. */
    pub fn transposed(self) : Mat4 {
        return Mat4 {
            m00: self.m00,  m01: self.m10,  m02: self.m20,  m03: self.m30,
            m10: self.m01,  m11: self.m11,  m12: self.m21,  m13: self.m31,
            m20: self.m02,  m21: self.m12,  m22: self.m22,  m23: self.m32,
            m30: self.m03,  m31: self.m13,  m32: self.m23,  m33: self.m33,
        };
    }
}
