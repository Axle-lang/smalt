// wide — UTF-8 (Axle's `string`) to UTF-16 (Win32's `W` APIs).
//
// The library calls `RegisterClassExW` / `CreateWindowExW` /
// `SetWindowTextW` rather than their `A` twins, because the `A` family
// transcodes through the process ANSI codepage and mangles anything a
// user is likely to put in a window title. That means every string
// crossing to Win32 becomes a NUL-terminated UTF-16 buffer first.
//
// The conversion is a real UTF-8 decode, not a byte widening: a
// codepoint above the BMP is emitted as a surrogate pair, and a
// malformed sequence degrades to U+FFFD rather than desynchronising the
// rest of the string.

use crate::kernel::blob::Blob;

/** The replacement character, for a byte sequence that does not decode. */
const WIDE_REPLACEMENT : i32 = 65533;
/** First codepoint needing a surrogate pair. */
const WIDE_SUPPLEMENTARY : i32 = 65536;
/** High-surrogate base, `0xD800`. */
const WIDE_HIGH_BASE : i32 = 55296;
/** Low-surrogate base, `0xDC00`. */
const WIDE_LOW_BASE : i32 = 56320;

/**
 * UTF-16 text handed to Win32.
 *
 * The buffer is owned by the caller and must outlive the call that reads
 * it — a window class name in particular is retained by the OS until the
 * class is unregistered, so `win_class` keeps its blob alive for the
 * process's lifetime rather than freeing it after `RegisterClassExW`.
 */
class Wide {
    /** The payload bits of the continuation byte at `i`. */
    static fn tail(s : string, i : i32) : i32 {
        return s.byteAt(i) & 0x3F;
    }

    /**
     * `s` as a NUL-terminated UTF-16 buffer.
     *
     * Sized from the byte length: a UTF-8 string never produces more
     * UTF-16 code units than it has bytes (the 4-byte sequences that
     * yield two units also consume four bytes), so `len + 1` units is
     * always enough and the buffer is allocated once.
     */
    static fn from(s : string) : Blob {
        let bytes = s.length;
        let out = new Blob(((bytes as i64) + 1) * 2);
        let units : i64 = 0;
        let i : i32 = 0;
        while (i < bytes) {
            let b0 = s.byteAt(i) & 0xFF;
            let cp = WIDE_REPLACEMENT;
            let taken = 1;

            if (b0 < 0x80) {
                cp = b0;
            } else if (b0 >= 0xC2 && b0 <= 0xDF && i + 1 < bytes) {
                cp = ((b0 & 0x1F) << 6) | Wide::tail(s, i + 1);
                taken = 2;
            } else if (b0 >= 0xE0 && b0 <= 0xEF && i + 2 < bytes) {
                cp = ((b0 & 0x0F) << 12) | (Wide::tail(s, i + 1) << 6) | Wide::tail(s, i + 2);
                taken = 3;
            } else if (b0 >= 0xF0 && b0 <= 0xF4 && i + 3 < bytes) {
                cp = ((b0 & 0x07) << 18)
                    | (Wide::tail(s, i + 1) << 12)
                    | (Wide::tail(s, i + 2) << 6)
                    | Wide::tail(s, i + 3);
                taken = 4;
            }

            if (cp < WIDE_SUPPLEMENTARY) {
                out.setWord(units * 2, cp);
                units += 1;
            } else {
                let rest = cp - WIDE_SUPPLEMENTARY;
                out.setWord(units * 2, WIDE_HIGH_BASE + (rest >>> 10));
                out.setWord((units + 1) * 2, WIDE_LOW_BASE + (rest & 0x3FF));
                units += 2;
            }
            i += taken;
        }
        // The blob was zeroed at construction, so the NUL terminator is
        // already in place at `units`.
        return out;
    }
}
