// smalt — a window, an event queue, and a 3D renderer that is software or GPU.
//
// This file is the crate's wiring header: it names every module so the
// build pulls the whole tree into the compilation unit, and carries no
// logic of its own. What each module owns is documented in its own
// header; the map of the library is in the README.
//
// Layers, bottom to top — a module never reaches upward:
//
//   kernel   raw memory and owned blocks
//   sys      the records and the imports at the OS boundary
//   platform the seams below the event queue: the process token, the
//            clock, the screen, the blit, the audio device
//   core     init, time, the event queue, keyboard and mouse state
//   video    the window, its driver, the event drain and the cursor
//   math     vectors, matrices, quaternions, geometry
//   render   meshes, textures, the camera, and the software rasteriser
//   audio    WAV clips, the software mixer, and banks of variants
//   io       whole-file reads and the BMP decoder
//   gpu      the renderer a program draws 3-D through: scenes, handles, meshes
//            built for a GPU, and two backends behind one contract — Vulkan, and
//            the software rasteriser as the fallback. Above render/ and video/,
//            below nothing; the Vulkan ABI it speaks is `sys/vk`
//
// NOT ONE `use` BELOW NAMES AN OPERATING SYSTEM, and that is the point.
// A module path resolves to `<path>.axle` when there is one
// implementation and to `<dir>/<os>/<name>.axle` when there is one per
// target, so a seam keeps its name and the build's `--target` picks the
// file. What is per-OS is therefore answered by the *tree* — everything
// under a `windows/` or `linux/` directory, and nothing else — instead
// of by tracing imports. `tools/check_seam.sh` is that sentence,
// enforced.
//
// Only the seams are named here. Each backend's private modules — the
// Win32 records and the `user32` imports, the Xlib and ALSA ones — are
// pulled into the build by the seam file that imports them, which is
// what keeps this header from having to know they exist.

use crate::kernel::{raw, blob, mem, store};

use crate::sys::dib;

use crate::platform::audio_format;
use crate::platform::{sys_clock, sys_app, sys_screen, sys_blit, sys_audio, sys_gpu_loader};

use crate::audio::{clip, mixer, bank};

use crate::core::{error, init, timer, pool, event, keyboard, mouse, pump};

use crate::video::{
    window, display, scancode_set1, sys_window, sys_drain, sys_cursor, sys_vk_surface,
};

use crate::render::color;
use crate::render::soft::{target, present, device_soft};

use crate::math::{vec, mat};

use crate::render::{device, vertex, texture, mesh, camera, frame, glyphs, text, surface};
use crate::render::soft::{shade, raster};

use crate::math::{quat, geom};

use crate::io::{file, fmt, bmp};

use crate::sys::vk::{vk_const, vk_types, vk_out, vk_table, vk_layout_check};

use crate::gpu::{handle, light, image, mesh_builder, scene, backend, renderer};
use crate::gpu::soft::backend_soft;
use crate::gpu::vk::{spirv, vk_error, vk_frame, vk_context, vk_heap, vk_mem, vk_graveyard};
use crate::gpu::vk::{vk_cmd, vk_pipelines, vk_textures, vk_meshes, vk_swapchain, vk_overlay};
use crate::gpu::vk::{vk_backend, vk_check};
use std::numeric::math;
