// mixer — many clips into the one block the device is waiting for.
//
// A fixed set of voices, summed into the block `SysAudio` hands back.
// Fixed rather than growable because the count bounds the work per
// block, and a game that asks for a 33rd simultaneous sound wants the
// quietest one dropped, not an allocation in the audio path.
//
// A voice holds its clip's ADDRESS and frame count, never the `Clip`.
// The bank owns the clips; a voice that owned one too would free samples
// still being read, and the crash would land in the device's thread with
// no stack pointing back here. Holding the address is the same fix the
// framebuffer path uses.
//
// **The mixer takes its own lock.** A game plays a sound from whichever
// thread simulated the thing that made it, and the device is topped up
// from a thread of its own — so `play` and `pump` race over a fixed
// voice array both write. Every public entry point that touches a voice
// spins on one flag first; the critical sections are a handful of stores
// or a single block's mix, which is why a spin beats a mutex here. Two
// games built on this had each written the same six lines outside the
// library, which is six lines and one race away from not having them.
//
// Positional voices attenuate against the listener EVERY block, not once
// at play time, which is what makes a sound fade while it is still
// playing as the player walks away. The curve is linear to zero at
// `range`: inverse-square is what physics does and it is wrong here,
// because it never reaches zero and a game needs a distance past which a
// sound is gone.

use crate::kernel::raw::Raw;
use crate::audio::clip::Clip;
use std::concurrent::AtomicBoolean;
use std::sys::sleep;
use crate::platform::audio_format::AUDIO_CHANNELS;
use crate::platform::sys_audio::SysAudio;

/**
 * One playing sound.
 *
 * `base` and `frames` are the clip's, copied in: see the file header for
 * why a voice must not hold the clip itself.
 */
struct Voice {
    /** Where the clip's samples are; 0 for a slot that holds none. */
    base       : i64 = 0;

    /** Frames in the clip. */
    frames     : i32 = 0;

    /** How many of them have been mixed. */
    cursor     : i32 = 0;

    /** The gain before the listener distance is applied. */
    gain       : f64 = 0.0;

    /** Whether the three coordinates below mean anything. */
    positional : bool = false;

    /** Where the sound is, when it is positional. */
    x          : f64 = 0.0;

    /** Where the sound is, when it is positional. */
    y          : f64 = 0.0;

    /** Where the sound is, when it is positional. */
    z          : f64 = 0.0;

    /** Distance at which a positional voice has faded to nothing. */
    range      : f64 = 0.0;

    /** Whether this slot is playing. */
    active     : bool = false;
}

/**
 * The software mixer.
 *
 * Owns the device. One per process — two would each open the default
 * output and fight over it.
 */
pub class Mixer : Closeable {
    /** Simultaneous voices. Beyond this the oldest positional voice loses. */
    pub(file) static VOICES : i32 = 32;

    /** Milliseconds `mixerLoop` sleeps between two pumps. */
    pub(crate) static PUMP_SLEEP_MS : i32 = 4;

    /** Bytes per device sample. */
    pub(file) static SAMPLE_BYTES : i64 = 2;

    /** Full-scale sample magnitude, for the clamp. */
    pub(file) static CLAMP : i32 = 32767;

    audio  : SysAudio = new SysAudio();
    voices : Voice[] = malloc<Voice>(Mixer::VOICES as i64);
    lx     : f64 = 0.0;
    ly     : f64 = 0.0;
    lz     : f64 = 0.0;

    /**
     * The mixer's own lock.
     *
     * A game plays a sound from the thread that simulated the thing that
     * made it, and the device is topped up from a thread of its own — so
     * `play` and `pump` genuinely race, over a fixed voice array that
     * both write. Without this, publishing `mixerLoop` would be
     * publishing a data race with a convenient name.
     *
     * A spin rather than a mutex because every critical section here is
     * a handful of stores or one block's mix, and the mutex would cost
     * more than the work it guards. It is `pub(file)` so nothing outside
     * can hold it across a call that takes it again.
     */
    lock   : AtomicBoolean = new AtomicBoolean(false);

    /**
     * Whether `mixerLoop` should keep going.
     *
     * Atomic because it is written by the thread that owns the mixer and
     * read by the one pumping it, and a plain `bool` read across two
     * threads is a read the optimiser may hoist out of the loop.
     */
    alive  : AtomicBoolean = new AtomicBoolean(true);

    /** Open the device and start with every voice idle. */
    constructor() {
        let i : i32 = 0;
        while (i < Mixer::VOICES) {
            self.voices[i] = Voice { active: false };
            i = i + 1;
        }
    }

    /** Spin until this thread owns the lock. */
    pub(file) fn acquire(self) : void {
        while (!self.lock.compareAndSet(false, true)) {
        }
    }

    /** Give the lock back. */
    pub(file) fn release(self) : void {
        self.lock.set(false);
    }

    /** Whether the device opened. Playing into a closed device is silent. */
    pub fn isOpen(self) : bool {
        return self.audio.isOpen();
    }

    /**
     * Where the listener is, for the next block's attenuation.
     *
     * Published per frame by the game; read per block by the mix, which
     * is what lets a sound fade mid-playback.
     */
    pub fn setListener(mut self, x : f64, y : f64, z : f64) : void {
        self.acquire();
        self.lx = x;
        self.ly = y;
        self.lz = z;
        self.release();
    }

    /**
     * A free voice slot, or the one holding the least useful sound.
     *
     * Stealing prefers a positional voice because a non-positional one is
     * the player's own — a footstep or a hurt cry, which is the sound the
     * player most notices missing.
     */
    pub(file) fn slot(mut self) : i32 {
        let i : i32 = 0;
        while (i < Mixer::VOICES) {
            if (!self.voices[i].active) {
                return i;
            }
            i = i + 1;
        }
        i = 0;
        while (i < Mixer::VOICES) {
            if (self.voices[i].positional) {
                return i;
            }
            i = i + 1;
        }
        return 0;
    }

    /** Start `clip` at a fixed gain, heard the same wherever it happens. */
    pub fn play(mut self, clip : Clip, gain : f64) : void {
        if (!clip.loaded()) {
            return;
        }
        self.acquire();
        let i : i32 = self.slot();
        self.voices[i] = Voice {
            base: clip.base(),
            frames: clip.frameCount(),
            gain: gain,
            active: true,
        };
        self.release();
    }

    /** Start `clip` at a world position, fading to nothing at `range`. */
    pub fn playAt(mut self, clip : Clip, gain : f64, x : f64, y : f64, z : f64, range : f64) : void {
        if (!clip.loaded() || range <= 0.0) {
            return;
        }
        self.acquire();
        let i : i32 = self.slot();
        self.voices[i] = Voice {
            base: clip.base(),
            frames: clip.frameCount(),
            gain: gain,
            positional: true,
            x: x,
            y: y,
            z: z,
            range: range,
            active: true,
        };
        self.release();
    }

    /** Voice `i`'s gain for this block, listener distance included. */
    pub(file) fn voiceGain(self, i : i32) : f64 {
        let v = self.voices[i];
        if (!v.positional) {
            return v.gain;
        }
        let dx : f64 = v.x - self.lx;
        let dy : f64 = v.y - self.ly;
        let dz : f64 = v.z - self.lz;
        let d2 : f64 = dx * dx + dy * dy + dz * dz;
        let r2 : f64 = v.range * v.range;
        if (d2 >= r2) {
            return 0.0;
        }
        // Linear in distance, not in squared distance, so the fade is
        // even across the range rather than collapsing near the edge.
        let d : f64 = d2.sqrt();
        return v.gain * (1.0 - d / v.range);
    }

    /**
     * Fill one device block if the device has one free.
     *
     * Answers whether it did, so a caller can tell "nothing to do" from
     * "device closed" without asking twice. Call it far more often than
     * the block duration: a block that comes free between two calls is
     * silence the device has already played.
     */
    pub fn pump(mut self) : bool {
        self.acquire();
        let slot : i32 = self.audio.reclaim();
        if (slot < 0) {
            self.release();
            return false;
        }
        let dst : ptr = Raw::at(self.audio.blockAddress(slot));
        let frames : i32 = SysAudio::blockFrames();

        // Silence first: a block comes back carrying whatever it played
        // last, and every voice below ADDS.
        Raw::clear(dst, (frames as i64) * (AUDIO_CHANNELS as i64) * Mixer::SAMPLE_BYTES);

        let v : i32 = 0;
        while (v < Mixer::VOICES) {
            if (self.voices[v].active) {
                self.mixVoice(v, dst, frames);
            }
            v = v + 1;
        }
        self.audio.submit(slot);
        self.release();
        return true;
    }

    /** Add voice `v`'s next `frames` frames into `dst`, and retire it if it ends. */
    pub(file) fn mixVoice(mut self, v : i32, dst : ptr, frames : i32) : void {
        let gain : f64 = self.voiceGain(v);
        let total : i32 = self.voices[v].frames;
        let cursor : i32 = self.voices[v].cursor;
        // Resolved once, not per sample: the address is fixed for the
        // whole run, and re-deriving it inside the loop is a cast per
        // sample per voice — a thousand of them per block, per voice.
        let src : ptr = Raw::at(self.voices[v].base);

        // An out-of-range voice still has to advance its cursor — it is
        // playing, the listener simply cannot hear it, and it must end
        // when the sound ends rather than when they walk back. So the
        // silent case skips the mixing, not the loop.
        if (gain <= 0.0) {
            let skipped : i32 = total - cursor;
            if (skipped > frames) {
                skipped = frames;
            }
            self.voices[v].cursor = cursor + skipped;
            if (self.voices[v].cursor >= total) {
                self.voices[v].active = false;
            }
            return;
        }

        let i : i32 = 0;
        while (i < frames && cursor < total) {
            let s : i32 = Raw::i16At(src, (cursor as i64) * Mixer::SAMPLE_BYTES);
            let add : i32 = ((s as f64) * gain).floorToInt() as i32;
            let frame : i64 = (i as i64) * (AUDIO_CHANNELS as i64) * Mixer::SAMPLE_BYTES;
            let c : i32 = 0;
            while (c < AUDIO_CHANNELS) {
                let off : i64 = frame + (c as i64) * Mixer::SAMPLE_BYTES;
                let sum : i32 = Raw::i16At(dst, off) + add;
                // Clamp rather than wrap: a wrapped sum is a loud click,
                // which is worse than the distortion clamping costs when
                // many voices land on the same frame.
                if (sum > Mixer::CLAMP) {
                    sum = Mixer::CLAMP;
                }
                if (sum < -Mixer::CLAMP) {
                    sum = -Mixer::CLAMP;
                }
                Raw::putU16(dst, off, sum);
                c = c + 1;
            }
            cursor = cursor + 1;
            i = i + 1;
        }

        self.voices[v].cursor = cursor;
        if (cursor >= total) {
            self.voices[v].active = false;
        }
    }

    /**
     * Whether a pump loop should keep going.
     *
     * Read by `mixerLoop`; a game with a loop of its own reads it for the
     * same reason.
     */
    pub fn isRunning(self) : bool {
        return self.alive.get();
    }

    /**
     * Ask a pump loop to finish.
     *
     * Call it, then `join()` the task, then `close()` — in that order. A
     * mixer closed while a thread is still pumping it is a thread reading
     * a device that has been released.
     */
    pub fn requestStop(mut self) : void {
        self.alive.set(false);
    }

    /** Stop the device. The clips are the bank's to release. */
    pub fn close(self) : void {
        free(self.voices);
        self.audio.close();
    }
}

/**
 * Pump `mx` on this thread until `requestStop` is called.
 *
 * The audio device wants a block far more often than a frame arrives: a
 * block that comes free between two `pump` calls is silence it has
 * already played, so a heavy frame — a chunk bake, a light pass, a
 * garbage-collection pause in a different runtime — is a stutter the
 * player hears. Pumping from a thread of its own removes the coupling
 * entirely.
 *
 * ```
 * let audio : Task<i32> = spawn mixerLoop(mixer);
 * ...
 * mixer.requestStop();
 * audio.join();
 * mixer.close();
 * ```
 *
 * A free function rather than a `Mixer.startPump()`, because a `Task<T>`
 * is a handle minted on the thread that spawned it and joined by that
 * same thread — parking one in a field would put it where the thread
 * that must join it cannot reach. The two lines above are the shape the
 * language asks for, and both programs that needed this wrote the same
 * thirty-line loop to get them.
 *
 * The sleep is what keeps the thread off a core it does not need: a
 * block is milliseconds long and the queue is checked several times per
 * block, which is enough to never miss one and cheap enough to be
 * invisible in a profile.
 */
pub fn mixerLoop(mx : Mixer) : i32 {
    while (mx.isRunning()) {
        mx.pump();
        sleep(Mixer::PUMP_SLEEP_MS);
    }
    return 0;
}
