// vk_heap — device memory, taken from the driver in blocks and handed out in pieces.
//
// A driver promises only 4096 `vkAllocateMemory` calls, and a voxel world has more
// chunk meshes than that. So memory is taken in big blocks and sub-allocated, and
// this file is the sub-allocator. The invariants a change must keep — no two pieces
// overlap, every piece is aligned, free neighbours are always merged, and a block's
// `freeBytes` is the sum of its free ranges — are what to re-check by hand: nothing
// in the tree exercises the allocator without a device.
//
// The algorithm:
//
//   * A block belongs to one (memory type, linear | optimal) pair. Buffers are
//     linear and images are optimal-tiled, and keeping them in separate blocks is
//     the simplest honest way to respect `bufferImageGranularity` without reading it.
//   * Blocks grow with use: a pair's first block is 4 MiB, and each new one as big as
//     what the pair already holds, up to 64 MiB. A program that draws a cube does not
//     pay 64 MiB for every kind of memory it touches once, and a streamed world still
//     reaches 64 MiB blocks after a handful — far under the driver's 4096.
//   * Inside a block, free space is a sorted list of (offset, size) ranges.
//     Allocation is first-fit with alignment; release inserts in order and merges
//     with both neighbours.
//   * A request over half a full-size block gets a block of its own, exactly sized, which
//     goes back to the driver when it empties. So does any emptied block that is
//     not the last of its kind, and any emptied block of plain system memory (host
//     visible, not device-local): that is where texture uploads stage, and keeping
//     64 MiB of it for an upload that happened once is waste.
//   * When the driver refuses a new block, the request is tried once more with a
//     block exactly its size: a heap with 40 MiB left can still take a 1 MiB texture.
//     A memory type the driver has refused is remembered as full — the next request
//     does not ask again — until a block of that type is given back.
//   * A host-visible block is mapped once, whole, and stays mapped. An allocation's
//     `mapped` is that mapping plus its offset, so writing a mesh is a `memcpy`.
//
// Host-visible memory is requested *coherent* by the callers, so nothing here
// flushes or invalidates: a write is visible to the next submit.
//
// # Where the numbers live
//
// Per-block state is held in parallel arrays indexed by block, and a block's free
// ranges in a `Mem` block of `MAX_RANGES` (offset, size) pairs — 16 KiB — taken when
// the block is. A release that merges with a neighbour needs no new slot and always
// lands; one that would need a slot in a full list is leaked (never corrupted), which
// would take a thousand non-adjacent free gaps in one block to reach — and is counted
// in `leakedBytes`, so it is a number to look at rather than a mystery: a block with a
// leaked piece never empties, and so is never given back.
//
// # Windows of mutation
//
// Single-threaded, like everything in the backend: only the thread that owns the
// window calls in.

use crate::gpu::vk::vk_context::VkContext;
use crate::kernel::mem::Mem;
use crate::kernel::raw::Raw;
use crate::sys::vk::vk_const::{
    VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT,
};
use crate::sys::vk::vk_types::VkInit;

/** A piece of a block: where it is, how big, and — if host-visible — its address. */
pub(crate) struct HeapAlloc {
    /** The block it came from; -1 when the allocation failed. */
    pub block  : i32 = -1;

    /** Byte offset of the piece within the block's `VkDeviceMemory`. */
    pub offset : i64 = 0;

    /** Bytes in the piece. */
    pub size   : i64 = 0;

    /** The piece's address when its block is host-visible, otherwise 0. */
    pub mapped : i64 = 0;

    /** The allocation that names nothing — what a failed request answers. */
    pub(crate) static fn none() : HeapAlloc {
        return HeapAlloc { block: -1, offset: 0, size: 0, mapped: 0 };
    }

    /** Whether this names nothing. */
    pub(crate) fn isNone(self) : bool {
        return self.block < 0;
    }
}

/** The sub-allocator over one device's memory. */
pub(crate) class GpuHeap {
    /** Bytes in a full-size block, the most a shared block grows to. */
    pub static BLOCK_BYTES : i64 = 67108864;

    /** Bytes in a pair's first block. */
    pub static FIRST_BLOCK_BYTES : i64 = 4194304;

    /** Blocks the heap can hold at once. */
    pub static MAX_BLOCKS  : i32 = 256;

    /** Free ranges one block's list holds. */
    pub static MAX_RANGES  : i32 = 1024;

    typeCount : i32;
    typeFlags : i32[];

    live                   : i32[];
    mems                   : i64[];
    types                  : i32[];
    linear                 : i32[];
    dedicated              : i32[];
    sizes                  : i64[];
    freeBytes              : i64[];
    mapped                 : i64[];
    rangeAt                : i64[];
    rangeN                 : i32[];

    /** One past the highest block index in use. */
    high                   : i32 = 0;

    /** Where the last successful `fit` put the piece. */
    fitAt                  : i64 = 0;

    /** Per memory type: 1 once the driver refused a block of it, until one is given back. */
    full                   : i32[];

    /** Bytes released into a block whose free list had no slot left (see the header). */
    pub(crate) leakedBytes : i64 = 0;

    /** A heap over the memory types `ctx` reported. */
    constructor(ctx : VkContext) {
        self.typeCount = ctx.memoryTypeCount();
        self.typeFlags = malloc<i32>(self.typeCount.max(1) as i64);
        self.full = malloc<i32>(self.typeCount.max(1) as i64);
        for (i of 0..self.typeCount) {
            self.typeFlags[i as i64] = ctx.typeFlags(i);
            self.full[i as i64] = 0;
        }
        let n : i64 = GpuHeap::MAX_BLOCKS as i64;
        self.live = malloc<i32>(n);
        self.mems = malloc<i64>(n);
        self.types = malloc<i32>(n);
        self.linear = malloc<i32>(n);
        self.dedicated = malloc<i32>(n);
        self.sizes = malloc<i64>(n);
        self.freeBytes = malloc<i64>(n);
        self.mapped = malloc<i64>(n);
        self.rangeAt = malloc<i64>(n);
        self.rangeN = malloc<i32>(n);
        for (i of 0..n) {
            self.live[i] = 0;
            self.mems[i] = 0;
            self.types[i] = 0;
            self.linear[i] = 0;
            self.dedicated[i] = 0;
            self.sizes[i] = 0;
            self.freeBytes[i] = 0;
            self.mapped[i] = 0;
            self.rangeAt[i] = 0;
            self.rangeN[i] = 0;
        }
    }

    /** The `VkDeviceMemory` of block `b`, for a bind; 0 for a block that is not live. */
    pub(crate) fn memoryHandle(self, b : i32) : i64 {
        if (b < 0 || b >= self.high || self.live[b as i64] == 0) {
            return 0;
        }
        return self.mems[b as i64];
    }

    /**
     * The first memory type `typeBits` accepts that has every flag of `want` and none of
     * `avoid`; -1 if none.
     */
    pub(crate) fn pick(self, typeBits : i32, want : i32, avoid : i32) : i32 {
        for (i of 0..self.typeCount) {
            let flags : i32 = self.typeFlags[i as i64];
            if (((typeBits >>> i) & 1) != 0 && (flags & want) == want && (flags & avoid) == 0) {
                return i;
            }
        }
        return -1;
    }

    /** Round `v` up to a multiple of `a` (a power of two or any positive integer). */
    pub(file) static fn alignUp(v : i64, a : i64) : i64 {
        if (a <= 1) {
            return v;
        }
        return ((v + a - 1) / a) * a;
    }

    /** Offset of range `i` of block `b`. */
    pub(file) fn rOff(self, b : i32, i : i32) : i64 {
        return Mem::qwordOf(self.rangeAt[b as i64], (i as i64) * 2);
    }

    /** Size of range `i` of block `b`. */
    pub(file) fn rSize(self, b : i32, i : i32) : i64 {
        return Mem::qwordOf(self.rangeAt[b as i64], (i as i64) * 2 + 1);
    }

    /** Write range `i` of block `b`. */
    pub(file) fn rPut(self, b : i32, i : i32, off : i64, size : i64) : void {
        Mem::putQwordOf(self.rangeAt[b as i64], (i as i64) * 2, off);
        Mem::putQwordOf(self.rangeAt[b as i64], (i as i64) * 2 + 1, size);
    }

    /** Move ranges `from..n` of block `b` up by one slot, making a hole at `from`. */
    pub(file) fn rOpen(mut self, b : i32, fromIdx : i32) : void {
        let i : i32 = self.rangeN[b as i64];
        while (i > fromIdx) {
            self.rPut(b, i, self.rOff(b, i - 1), self.rSize(b, i - 1));
            i -= 1;
        }
        self.rangeN[b as i64] += 1;
    }

    /** Remove range `at` of block `b`, closing the gap. */
    pub(file) fn rClose(mut self, b : i32, at : i32) : void {
        let i : i32 = at;
        let last : i32 = self.rangeN[b as i64] - 1;
        while (i < last) {
            self.rPut(b, i, self.rOff(b, i + 1), self.rSize(b, i + 1));
            i += 1;
        }
        self.rangeN[b as i64] = last;
    }

    /**
     * The first free range of block `b` that can hold `size` bytes at `align`; its
     * index, or -1. `fitAt` is set to the aligned start.
     */
    pub(file) fn fit(mut self, b : i32, size : i64, align : i64) : i32 {
        let n : i32 = self.rangeN[b as i64];
        for (i of 0..n) {
            let off : i64 = self.rOff(b, i);
            let start : i64 = GpuHeap::alignUp(off, align);
            if (start + size <= off + self.rSize(b, i)) {
                self.fitAt = start;
                return i;
            }
        }
        return -1;
    }

    /** Take [`at`, `at + size`) out of range `i` of block `b`, leaving up to two remainders. */
    pub(file) fn carve(mut self, b : i32, i : i32, at : i64, size : i64) : bool {
        let off : i64 = self.rOff(b, i);
        let whole : i64 = self.rSize(b, i);
        let head : i64 = at - off;
        let tailAt : i64 = at + size;
        let tail : i64 = off + whole - tailAt;
        if (head > 0 && tail > 0) {
            if (self.rangeN[b as i64] >= GpuHeap::MAX_RANGES) {
                return false;
            }
            self.rOpen(b, i + 1);
            self.rPut(b, i, off, head);
            self.rPut(b, i + 1, tailAt, tail);
        } else if (head > 0) {
            self.rPut(b, i, off, head);
        } else if (tail > 0) {
            self.rPut(b, i, tailAt, tail);
        } else {
            self.rClose(b, i);
        }
        self.freeBytes[b as i64] -= size;
        return true;
    }

    /**
     * Ask the driver for a block of `size` bytes of memory type `memType`; its index,
     * or -1.
     *
     * A host-visible block is mapped whole before it is returned, so a block that
     * exists is one an allocation can be written through.
     */
    pub(file) fn newBlock(
        mut self,
        ctx : VkContext,
        memType : i32,
        linear : i32,
        size : i64,
        dedicated : i32
    ) : i32 {
        let slot : i32 = -1;
        for (i of 0..GpuHeap::MAX_BLOCKS) {
            if (slot < 0 && self.live[i as i64] == 0) {
                slot = i;
            }
        }
        if (slot < 0) {
            return -1;
        }
        let ranges : i64 = Mem::takeZeroed((GpuHeap::MAX_RANGES as i64) * 16);
        if (ranges == 0) {
            return -1;
        }
        let info = VkInit::memoryAllocateInfo();
        info.allocationSize = size;
        info.memoryTypeIndex = memType;
        let r : i32 = ctx.table.allocateMemory(ctx.device, info, Raw::at(ctx.scratch));
        if (r < 0) {
            Mem::release(ranges);
            self.full[memType as i64] = 1;
            return -1;
        }
        let mem : i64 = Mem::qwordAt(ctx.scratch, 0);
        let map : i64 = 0;
        if ((self.typeFlags[memType as i64] & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) != 0) {
            r = ctx.table.mapMemory(ctx.device, mem, 0, size, 0, Raw::at(ctx.scratch));
            if (r < 0) {
                ctx.table.freeMemory(ctx.device, mem);
                Mem::release(ranges);
                return -1;
            }
            map = Mem::qwordAt(ctx.scratch, 0);
        }
        let b : i64 = slot as i64;
        self.live[b] = 1;
        self.mems[b] = mem;
        self.types[b] = memType;
        self.linear[b] = linear;
        self.dedicated[b] = dedicated;
        self.sizes[b] = size;
        self.freeBytes[b] = size;
        self.mapped[b] = map;
        self.rangeAt[b] = ranges;
        self.rangeN[b] = 1;
        self.rPut(slot, 0, 0, size);
        if (slot >= self.high) {
            self.high = slot + 1;
        }
        return slot;
    }

    /** The piece of block `b` at `at` for `size`, as an allocation. */
    pub(file) fn made(self, b : i32, at : i64, size : i64) : HeapAlloc {
        let map : i64 = self.mapped[b as i64];
        if (map != 0) {
            map += at;
        }
        return HeapAlloc { block: b, offset: at, size: size, mapped: map };
    }

    /**
     * `size` bytes aligned to `align` from memory type `memType`; `HeapAlloc::none()`
     * when the driver has no more or a table is full.
     *
     * `linear` is 1 for a buffer, 0 for an optimal-tiling image.
     */
    pub(crate) fn alloc(
        mut self,
        ctx : VkContext,
        memType : i32,
        linear : i32,
        size : i64,
        align : i64
    ) : HeapAlloc {
        if (size <= 0 || memType < 0 || memType >= self.typeCount) {
            return HeapAlloc::none();
        }
        if (size <= GpuHeap::BLOCK_BYTES / 2) {
            for (b of 0..self.high) {
                let bi : i64 = b as i64;
                if (self.live[bi] != 0 && self.dedicated[bi] == 0 && self.types[bi] == memType && self.linear[bi] == linear && self.freeBytes[bi] >= size) {
                    let i : i32 = self.fit(b, size, align);
                    if (i >= 0) {
                        let at : i64 = self.fitAt;
                        if (self.carve(b, i, at, size)) {
                            return self.made(b, at, size);
                        }
                    }
                }
            }
            if (self.full[memType as i64] != 0) {
                return HeapAlloc::none();
            }
            let nb : i32 = self.newBlock(ctx, memType, linear, self.nextBlockBytes(memType, linear, size), 0);
            if (nb >= 0) {
                let i : i32 = self.fit(nb, size, align);
                if (i < 0) {
                    return HeapAlloc::none();
                }
                let at : i64 = self.fitAt;
                if (!self.carve(nb, i, at, size)) {
                    return HeapAlloc::none();
                }
                return self.made(nb, at, size);
            }
            // No room for a new block: fall through to one of just this size.
        }
        let db : i32 = self.newBlock(ctx, memType, linear, size, 1);
        if (db < 0) {
            return HeapAlloc::none();
        }
        let i : i32 = self.fit(db, size, align);
        if (i < 0) {
            return HeapAlloc::none();
        }
        let at : i64 = self.fitAt;
        if (!self.carve(db, i, at, size)) {
            return HeapAlloc::none();
        }
        return self.made(db, at, size);
    }

    /**
     * The size of the next shared block of a (memory type, linear) pair: as much as the
     * pair's shared blocks already hold — doubling it — from `FIRST_BLOCK_BYTES` up to
     * `BLOCK_BYTES`, and never less than twice the request that asks for it.
     */
    pub(file) fn nextBlockBytes(self, memType : i32, linear : i32, size : i64) : i64 {
        let held : i64 = 0;
        for (b of 0..self.high) {
            let bi : i64 = b as i64;
            if (self.live[bi] != 0 && self.dedicated[bi] == 0 && self.types[bi] == memType && self.linear[bi] == linear) {
                held += self.sizes[bi];
            }
        }
        return held.max(size * 2).max(GpuHeap::FIRST_BLOCK_BYTES).min(GpuHeap::BLOCK_BYTES);
    }

    /** Give the driver block `b` back; its memory type may then have room again. */
    pub(file) fn dropBlock(mut self, ctx : VkContext, b : i32) : void {
        let bi : i64 = b as i64;
        ctx.table.freeMemory(ctx.device, self.mems[bi]);
        self.full[self.types[bi] as i64] = 0;
        Mem::release(self.rangeAt[bi]);
        self.rangeAt[bi] = 0;
        self.mapped[bi] = 0;
        self.mems[bi] = 0;
        self.live[bi] = 0;
        self.rangeN[bi] = 0;
    }

    /**
     * Return a piece. Its range is merged with the free ranges either side, and a
     * block that is then entirely free goes back to the driver unless it is the
     * last of its kind (which would only be asked for again).
     *
     * Only call this once nothing that was reading or writing the piece can still
     * be running — `VkGraveyard` is how that is known.
     */
    pub(crate) fn release(mut self, ctx : VkContext, a : HeapAlloc) : void {
        if (a.block < 0 || a.block >= self.high || self.live[a.block as i64] == 0) {
            return;
        }
        let b : i32 = a.block;
        let bi : i64 = b as i64;
        let n : i32 = self.rangeN[bi];
        let i : i32 = 0;
        while (i < n && self.rOff(b, i) < a.offset) {
            i += 1;
        }
        let end : i64 = a.offset + a.size;
        let joinsLeft : bool = i > 0 && self.rOff(b, i - 1) + self.rSize(b, i - 1) == a.offset;
        let joinsRight : bool = i < n && self.rOff(b, i) == end;
        if (joinsLeft && joinsRight) {
            let merged : i64 = self.rSize(b, i - 1) + a.size + self.rSize(b, i);
            self.rPut(b, i - 1, self.rOff(b, i - 1), merged);
            self.rClose(b, i);
        } else if (joinsLeft) {
            self.rPut(b, i - 1, self.rOff(b, i - 1), self.rSize(b, i - 1) + a.size);
        } else if (joinsRight) {
            self.rPut(b, i, a.offset, a.size + self.rSize(b, i));
        } else {
            // Only a piece with free space on neither side needs a slot of its own.
            if (n >= GpuHeap::MAX_RANGES) {
                self.leakedBytes += a.size;
                return;
            }
            self.rOpen(b, i);
            self.rPut(b, i, a.offset, a.size);
        }
        self.freeBytes[bi] += a.size;
        if (self.freeBytes[bi] == self.sizes[bi]) {
            let others : i32 = 0;
            for (k of 0..self.high) {
                let ki : i64 = k as i64;
                if (k != b && self.live[ki] != 0 && self.dedicated[ki] == 0 && self.types[ki] == self.types[bi] && self.linear[ki] == self.linear[bi]) {
                    others += 1;
                }
            }
            let flags : i32 = self.typeFlags[self.types[bi] as i64];
            let systemRam : bool = (flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) != 0 && (flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) == 0;
            if (self.dedicated[bi] != 0 || others > 0 || systemRam) {
                self.dropBlock(ctx, b);
            }
        }
    }

    /**
     * Return every block to the driver, free-range lists included. The tables
     * themselves are arrays the destructor reclaims.
     */
    pub(crate) fn destroy(mut self, ctx : VkContext) : void {
        for (b of 0..self.high) {
            if (self.live[b as i64] != 0) {
                self.dropBlock(ctx, b);
            }
        }
        self.high = 0;
    }
}
