// vk_meshes — geometry on the GPU: a vertex buffer and an index buffer per mesh.
//
// A mesh is two Vulkan buffers, written by the CPU through a mapping and read by the GPU
// at draw time. They are host-visible and coherent (see `vk_mem`), so uploading is a
// `memcpy` from the `MeshBuilder` — no staging buffer, no transfer queue, no copy command
// — and a program that re-meshes a chunk pays for the copy and nothing else. A discrete
// GPU reading them across the bus is slower than reading its own memory; `vk_mem` prefers
// device-local host-visible memory (which an integrated GPU and a resizable-BAR discrete
// one both have) and that is where most of the difference goes. A staged upload to
// device-only memory is the next step and is listed in LIMITATIONS.
//
// # Updating
//
// `update` does not write into the existing buffers. A frame that is still in flight may be
// reading them, and the write would race with it — a flicker that depends on timing and
// never reproduces under a debugger. It makes a *new* pair, copies into that, swaps it in,
// and buries the old pair for the graveyard to free once no frame can name it. The cost is
// one allocation per update, which the heap makes cheap, and the price of correctness.
//
// # Slots
//
// Slot numbers are the backend's; `Renderer` hides them behind generation-checked handles.

use crate::gpu::mesh_builder::MeshBuilder;
use crate::gpu::vk::vk_context::VkContext;
use crate::gpu::vk::vk_graveyard::VkGraveyard;
use crate::gpu::vk::vk_heap::GpuHeap;
use crate::gpu::vk::vk_mem::{GpuBuffer, MemUse, VkMem};
use crate::kernel::mem::Mem;
use crate::sys::vk::vk_const::{VK_BUFFER_USAGE_INDEX_BUFFER_BIT, VK_BUFFER_USAGE_VERTEX_BUFFER_BIT};

/** Meshes uploaded to the GPU. */
pub(crate) class VkMeshes {
    cap     : i32;
    live    : i32[];
    vbufs   : GpuBuffer[];
    ibufs   : GpuBuffer[];
    indices : i32[];

    /** A table of `capacity` mesh slots. */
    constructor(capacity : i32) {
        self.cap = capacity.max(1);
        let n : i64 = self.cap as i64;
        self.live = malloc<i32>(n);
        self.vbufs = malloc<GpuBuffer>(n);
        self.ibufs = malloc<GpuBuffer>(n);
        self.indices = malloc<i32>(n);
        for (i of 0..n) {
            self.live[i] = 0;
            self.vbufs[i] = GpuBuffer::none();
            self.ibufs[i] = GpuBuffer::none();
            self.indices[i] = 0;
        }
    }

    /** The first free slot, or -1. */
    pub(file) fn freeSlot(self) : i32 {
        for (i of 0..self.cap) {
            if (self.live[i as i64] == 0) {
                return i;
            }
        }
        return -1;
    }

    /** The vertex buffer of mesh `slot`, or 0. */
    pub(crate) fn vertexBuffer(self, slot : i32) : i64 {
        if (slot < 0 || slot >= self.cap || self.live[slot as i64] == 0) {
            return 0;
        }
        return self.vbufs[slot as i64].buffer;
    }

    /** The index buffer of mesh `slot`, or 0. */
    pub(crate) fn indexBuffer(self, slot : i32) : i64 {
        if (slot < 0 || slot >= self.cap || self.live[slot as i64] == 0) {
            return 0;
        }
        return self.ibufs[slot as i64].buffer;
    }

    /** Indices to draw for mesh `slot`, or 0. */
    pub(crate) fn indexCount(self, slot : i32) : i32 {
        if (slot < 0 || slot >= self.cap || self.live[slot as i64] == 0) {
            return 0;
        }
        return self.indices[slot as i64];
    }

    /**
     * Make the two buffers for `mesh` and copy its data in.
     *
     * Both are `GpuBuffer::none()` when either could not be made; on failure nothing
     * is left allocated.
     */
    pub(file) static fn fill(
        ctx : VkContext,
        heap : GpuHeap,
        mesh : MeshBuilder
    ) : (vertex: GpuBuffer, index: GpuBuffer) {
        let vb : GpuBuffer = VkMem::makeBuffer(
            ctx,
            heap,
            mesh.vertexBytes(),
            VK_BUFFER_USAGE_VERTEX_BUFFER_BIT,
            MemUse::Stream
        );
        if (vb.isNone() || vb.mapped() == 0) {
            VkMem::destroyBuffer(ctx, heap, vb);
            return (GpuBuffer::none(), GpuBuffer::none());
        }
        let ib : GpuBuffer = VkMem::makeBuffer(
            ctx,
            heap,
            mesh.indexBytes(),
            VK_BUFFER_USAGE_INDEX_BUFFER_BIT,
            MemUse::Stream
        );
        if (ib.isNone() || ib.mapped() == 0) {
            VkMem::destroyBuffer(ctx, heap, vb);
            VkMem::destroyBuffer(ctx, heap, ib);
            return (GpuBuffer::none(), GpuBuffer::none());
        }
        Mem::copy(vb.mapped(), mesh.vertexBase(), mesh.vertexBytes());
        Mem::copy(ib.mapped(), mesh.indexBase(), mesh.indexBytes());
        return (vb, ib);
    }

    /** Take the pair `fill` made into slot `slot`. */
    pub(file) fn adopt(
        mut self,
        slot : i32,
        vb : GpuBuffer,
        ib : GpuBuffer,
        mesh : MeshBuilder
    ) : void {
        let s : i64 = slot as i64;
        self.vbufs[s] = vb;
        self.ibufs[s] = ib;
        self.indices[s] = mesh.indexSlots();
        self.live[s] = 1;
    }

    /** Upload `mesh`; the slot, or -1 when it is empty, the table is full, or memory is out. */
    pub(crate) fn create(mut self, ctx : VkContext, heap : GpuHeap, mesh : MeshBuilder) : i32 {
        if (mesh.isEmpty()) {
            return -1;
        }
        let slot : i32 = self.freeSlot();
        if (slot < 0) {
            return -1;
        }
        let (vb, ib) = VkMeshes::fill(ctx, heap, mesh);
        if (vb.isNone()) {
            return -1;
        }
        self.adopt(slot, vb, ib, mesh);
        return slot;
    }

    /** Bury the buffer pair of `slot`. The caller has checked the graveyard has room for two. */
    pub(file) fn buryPair(self, grave : VkGraveyard, slot : i32, frame : i64) : void {
        grave.buryBuffer(self.vbufs[slot as i64], frame);
        grave.buryBuffer(self.ibufs[slot as i64], frame);
    }

    /**
     * Replace the geometry in `slot`; whether it was.
     *
     * The old buffers are buried at `frame` (see the module header). False when the
     * slot is not live, the mesh is empty, memory is out, or the graveyard is full —
     * in every case the old geometry is untouched.
     */
    pub(crate) fn update(
        mut self,
        ctx : VkContext,
        heap : GpuHeap,
        grave : VkGraveyard,
        slot : i32,
        mesh : MeshBuilder,
        frame : i64
    ) : bool {
        if (slot < 0 || slot >= self.cap || self.live[slot as i64] == 0 || mesh.isEmpty()) {
            return false;
        }
        if (!grave.hasRoom(2)) {
            return false;
        }
        let (vb, ib) = VkMeshes::fill(ctx, heap, mesh);
        if (vb.isNone()) {
            return false;
        }
        self.buryPair(grave, slot, frame);
        self.adopt(slot, vb, ib, mesh);
        return true;
    }

    /** Release mesh `slot` once no frame in flight can be drawing it; false when the graveyard is full. */
    pub(crate) fn destroy(mut self, grave : VkGraveyard, slot : i32, frame : i64) : bool {
        if (slot < 0 || slot >= self.cap || self.live[slot as i64] == 0) {
            return true;
        }
        if (!grave.hasRoom(2)) {
            return false;
        }
        self.buryPair(grave, slot, frame);
        self.live[slot as i64] = 0;
        return true;
    }

    /** Destroy every live mesh at once. Only after the device has gone idle. */
    pub(crate) fn destroyAll(mut self, ctx : VkContext, heap : GpuHeap) : void {
        for (i of 0..self.cap) {
            let s : i64 = i as i64;
            if (self.live[s] != 0) {
                VkMem::destroyBuffer(ctx, heap, self.vbufs[s]);
                VkMem::destroyBuffer(ctx, heap, self.ibufs[s]);
                self.live[s] = 0;
            }
        }
    }
}
