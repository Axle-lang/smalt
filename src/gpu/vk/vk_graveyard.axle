// vk_graveyard — where a resource waits until the GPU can no longer be reading it.
//
// A frame is *recorded* on the CPU and *run* on the GPU some time later, and with
// two frames in flight there are always commands in the queue that name buffers and
// images by handle. Destroy one of those the moment the program lets go of it and the
// GPU reads freed memory: a crash on one driver, a flicker of someone else's geometry
// on another, nothing at all on the machine it was written on.
//
// So nothing a draw can reach is destroyed when it is released. It is *buried* with
// the number of the frame being built, and `sweep` — called once per frame, after the
// frame fence of the slot about to be reused has been waited on — destroys what no
// frame still running can name. That is the whole of "safe while frames that drew it
// are in flight".
//
// # The arithmetic
//
// Frames are numbered from 1 and the backend keeps `FRAMES_IN_FLIGHT` (`vk_frame`) of them. Burying
// at frame N means frames up to N - 1 may still reference the resource (frame N has
// not been recorded yet, or was recorded without it). Waiting on a slot's fence at
// the start of frame M proves frame M - FRAMES_IN_FLIGHT is complete — and in order,
// every frame before it. So a resource buried at N is free once
// `N - 1 <= M - FRAMES_IN_FLIGHT`. `sweep(…, completed)` takes that right-hand side.
//
// A semaphore is the one thing buried that a *present* rather than a draw may still be
// waiting on, and no fence covers a present in Vulkan 1.0. The swapchain buries the
// per-image semaphores of a swapchain it replaces a full round of frames later than a
// draw's resources, which is the margin every implementation leaves in practice.
//
// # When it fills
//
// The table is bounded. A frame that retires more than `CAPACITY` resources — a
// whole world re-meshed at once — makes `bury…` answer false, and the caller does what
// is always correct: wait for the device to go idle, `flush`, and bury again.

use crate::gpu::vk::vk_context::{CTX_SCRATCH_GRAVE, VkContext};
use crate::gpu::vk::vk_heap::{GpuHeap, HeapAlloc};
use crate::gpu::vk::vk_mem::{GpuBuffer, GpuImage, VkMem};
use crate::kernel::mem::Mem;
use crate::kernel::raw::Raw;

/** A buried buffer (and its memory). */
const GRAVE_BUFFER : i32 = 1;

/** A buried image (and its memory). */
const GRAVE_IMAGE : i32 = 2;

/** A buried image view. */
const GRAVE_VIEW : i32 = 3;

/** A buried sampler. */
const GRAVE_SAMPLER : i32 = 4;

/** A buried descriptor set. */
const GRAVE_SET : i32 = 5;

/** A buried semaphore. */
const GRAVE_SEMAPHORE : i32 = 6;

/** Resources waiting to be destroyed. */
pub(crate) class VkGraveyard {
    /** Entries the table holds. */
    pub static CAPACITY : i32 = 8192;

    kinds   : i32[];
    handles : i64[];
    blocks  : i32[];
    offsets : i64[];
    sizes   : i64[];
    born    : i64[];
    count   : i32 = 0;

    /** Descriptor sets among the entries: still allocated from the pool. */
    sets    : i32 = 0;

    /** An empty graveyard. */
    constructor() {
        let n : i64 = VkGraveyard::CAPACITY as i64;
        self.kinds = malloc<i32>(n);
        self.handles = malloc<i64>(n);
        self.blocks = malloc<i32>(n);
        self.offsets = malloc<i64>(n);
        self.sizes = malloc<i64>(n);
        self.born = malloc<i64>(n);
    }

    /** Entries waiting. */
    pub(crate) fn waiting(self) : i32 {
        return self.count;
    }

    /** Descriptor sets buried and not yet freed — part of what the pool has handed out. */
    pub(crate) fn setsWaiting(self) : i32 {
        return self.sets;
    }

    /** Room for `n` more entries. */
    pub(crate) fn hasRoom(self, n : i32) : bool {
        return self.count + n <= VkGraveyard::CAPACITY;
    }

    /** Add one entry; false when full. */
    pub(file) fn add(mut self, kind : i32, handle : i64, alloc : HeapAlloc, frame : i64) : bool {
        if (self.count >= VkGraveyard::CAPACITY) {
            return false;
        }
        let i : i64 = self.count as i64;
        self.kinds[i] = kind;
        self.handles[i] = handle;
        self.blocks[i] = alloc.block;
        self.offsets[i] = alloc.offset;
        self.sizes[i] = alloc.size;
        self.born[i] = frame;
        self.count += 1;
        return true;
    }

    /** Bury a buffer and its memory at `frame`; false when full. */
    pub(crate) fn buryBuffer(mut self, b : GpuBuffer, frame : i64) : bool {
        if (b.buffer == 0) {
            return true;
        }
        return self.add(GRAVE_BUFFER, b.buffer, b.alloc, frame);
    }

    /** Bury an image and its memory at `frame`; false when full. */
    pub(crate) fn buryImage(mut self, i : GpuImage, frame : i64) : bool {
        if (i.image == 0) {
            return true;
        }
        return self.add(GRAVE_IMAGE, i.image, i.alloc, frame);
    }

    /** Bury an image view at `frame`; false when full. */
    pub(crate) fn buryView(mut self, view : i64, frame : i64) : bool {
        if (view == 0) {
            return true;
        }
        return self.add(GRAVE_VIEW, view, HeapAlloc::none(), frame);
    }

    /** Bury a sampler at `frame`; false when full. */
    pub(crate) fn burySampler(mut self, sampler : i64, frame : i64) : bool {
        if (sampler == 0) {
            return true;
        }
        return self.add(GRAVE_SAMPLER, sampler, HeapAlloc::none(), frame);
    }

    /** Bury a descriptor set at `frame`; false when full. */
    pub(crate) fn burySet(mut self, set : i64, frame : i64) : bool {
        if (set == 0) {
            return true;
        }
        if (!self.add(GRAVE_SET, set, HeapAlloc::none(), frame)) {
            return false;
        }
        self.sets += 1;
        return true;
    }

    /** Bury a semaphore at `frame`; false when full. */
    pub(crate) fn burySemaphore(mut self, semaphore : i64, frame : i64) : bool {
        if (semaphore == 0) {
            return true;
        }
        return self.add(GRAVE_SEMAPHORE, semaphore, HeapAlloc::none(), frame);
    }

    /** Destroy entry `i` now. */
    pub(file) fn destroyOne(mut self, ctx : VkContext, heap : GpuHeap, pool : i64, i : i32) : void {
        let k : i64 = i as i64;
        let kind : i32 = self.kinds[k];
        let handle : i64 = self.handles[k];
        let alloc : HeapAlloc = HeapAlloc {
            block: self.blocks[k],
            offset: self.offsets[k],
            size: self.sizes[k],
            mapped: 0,
        };
        if (kind == GRAVE_BUFFER) {
            VkMem::destroyBuffer(
                ctx,
                heap,
                GpuBuffer { buffer: handle, alloc: alloc, size: alloc.size }
            );
        } else if (kind == GRAVE_IMAGE) {
            VkMem::destroyImage(ctx, heap, GpuImage { image: handle, alloc: alloc });
        } else if (kind == GRAVE_VIEW) {
            ctx.table.destroyImageView(ctx.device, handle);
        } else if (kind == GRAVE_SAMPLER) {
            ctx.table.destroySampler(ctx.device, handle);
        } else if (kind == GRAVE_SET) {
            let one : i64 = ctx.scratch + CTX_SCRATCH_GRAVE;
            Mem::putQword(one, 0, handle);
            ctx.table.freeDescriptorSets(ctx.device, pool, 1, Raw::at(one));
            self.sets -= 1;
        } else if (kind == GRAVE_SEMAPHORE) {
            ctx.table.destroySemaphore(ctx.device, handle);
        }
    }

    /**
     * Destroy every entry buried at a frame `N` with `N - 1 <= completed`, keeping the
     * rest in order.
     */
    pub(crate) fn sweep(
        mut self,
        ctx : VkContext,
        heap : GpuHeap,
        pool : i64,
        completed : i64
    ) : void {
        let kept : i32 = 0;
        for (i of 0..self.count) {
            let k : i64 = i as i64;
            if (self.born[k] - 1 <= completed) {
                self.destroyOne(ctx, heap, pool, i);
            } else {
                if (kept != i) {
                    let d : i64 = kept as i64;
                    self.kinds[d] = self.kinds[k];
                    self.handles[d] = self.handles[k];
                    self.blocks[d] = self.blocks[k];
                    self.offsets[d] = self.offsets[k];
                    self.sizes[d] = self.sizes[k];
                    self.born[d] = self.born[k];
                }
                kept += 1;
            }
        }
        self.count = kept;
    }

    /** Destroy everything at once. Only after the device has gone idle. */
    pub(crate) fn flush(mut self, ctx : VkContext, heap : GpuHeap, pool : i64) : void {
        for (i of 0..self.count) {
            self.destroyOne(ctx, heap, pool, i);
        }
        self.count = 0;
    }
}
