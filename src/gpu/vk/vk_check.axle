// vk_check — the questions about the GPU layer a program (or a test) may ask without a GPU.
//
// The layer's internals are `pub(crate)` on purpose: a program draws through `Renderer`
// and has no business with a uniform block's byte offsets. But a headless self-test has to be
// able to ask whether those offsets, the vertex format, the clip-space matrix and the
// embedded shaders are what the shaders expect, and it lives in another crate. This is the
// narrow public door for that — the same shape as `Platform::checkRecords`, which a program
// may ask before it opens anything. It sits beside the Vulkan backend because that is what
// it looks into; nothing in the portable half of `gpu/` depends on it.
//
// Every answer is a value: the blocks are written into arrays this file allocates and hands
// back, never to an address a caller supplies, so the door cannot be used to write anywhere.
//
// `prepare`, `opaqueDraws` and `orderAt` let a test look at the draw order; `Renderer::render`
// recomputes it every frame, so calling `prepare` early changes nothing it will draw.
//
// Nothing here opens a device or a window. `examples/gpu_check` calls all of it. What it
// cannot see is the shaders' *code*: `shaders()` checks each embedded module's header and
// size, and that the words are what the GLSL compiles to is checked by recompiling them
// (`doc/GPU.md` says how) — Axle has no SPIR-V compiler to ask.

use crate::gpu::image::Image;
use crate::gpu::mesh_builder::MeshBuilder;
use crate::gpu::scene::{DrawItem, Scene};
use crate::gpu::vk::spirv::Spirv;
use crate::gpu::vk::vk_frame::{
    DRAW_ALBEDO, DRAW_BYTES, DRAW_EXTRA, DRAW_MODEL, DRAW_PARAMS, FRAME_AMBIENT, FRAME_BYTES,
    FRAME_COUNTS, FRAME_EYE, FRAME_FOG_COLOR, FRAME_FOG_RANGE, FRAME_LIGHT_COL, FRAME_LIGHT_POS,
    FRAME_SUN_COLOR, FRAME_SUN_DIR, FRAME_VIEW_PROJ, FRAMES_IN_FLIGHT, VkFrame,
    FRAME_INV_VIEW_PROJ, FRAME_TARGET, FRAME_USER, DRAW_USER,
};
use crate::gpu::vk::vk_overlay::VkOverlay;
use crate::kernel::mem::Mem;
use crate::math::mat::Mat4;
use crate::sys::vk::vk_layout_check::VkLayout;
use crate::video::sys_vk_surface::SysVkSurface;

/** The first word of every SPIR-V module, `0x07230203`, as a signed 32-bit value. */
const SPIRV_MAGIC : i32 = 119734787;

/** The SPIR-V version the shaders are compiled for: 1.0, as Vulkan 1.0 requires. */
const SPIRV_VERSION_1_0 : i32 = 65536;

/** Queries the GPU layer answers without a device. */
pub class GpuCheck {
    /**
     * 0 when every Vulkan record the backend fills has the size and field offsets the C
     * headers give it, otherwise the number of the first check that failed. The backend
     * asks the same before it fills its first record.
     */
    pub static fn layout() : i32 {
        return VkLayout::verify();
    }

    /**
     * 0 when this port's surface-creation record (`VkWin32/Xlib/WaylandSurfaceCreateInfoKHR`)
     * has the size and offsets the C header gives it, otherwise the failed check's number.
     * Declared by hand beside its port, so it gets its own check.
     */
    pub static fn surfaceRecord() : i32 {
        return SysVkSurface::recordLayout();
    }

    /** 0 when `words` is a SPIR-V 1.0 module of exactly `bytes` bytes, else why not (1..3). */
    pub(file) static fn module(words : i32[], bytes : i64) : i32 {
        if (words.length < 5 || words[0] != SPIRV_MAGIC) {
            return 1;
        }
        if (words[1] != SPIRV_VERSION_1_0) {
            return 2;
        }
        if ((words.length as i64) * 4 != bytes) {
            return 3;
        }
        return 0;
    }

    /**
     * 0 when each embedded shader module has the SPIR-V header (magic, version 1.0) and the
     * size its `*Bytes()` declares, else `10 * module + reason` — module 1..5 in the order
     * scene vertex, scene fragment, overlay vertex, overlay fragment, copy.
     */
    pub static fn shaders() : i32 {
        let r : i32 = GpuCheck::module(Spirv::sceneVert(), Spirv::sceneVertBytes());
        if (r != 0) {
            return 10 + r;
        }
        r = GpuCheck::module(Spirv::sceneFrag(), Spirv::sceneFragBytes());
        if (r != 0) {
            return 20 + r;
        }
        r = GpuCheck::module(Spirv::overlayVert(), Spirv::overlayVertBytes());
        if (r != 0) {
            return 30 + r;
        }
        r = GpuCheck::module(Spirv::overlayFrag(), Spirv::overlayFragBytes());
        if (r != 0) {
            return 40 + r;
        }
        r = GpuCheck::module(Spirv::copyFrag(), Spirv::copyFragBytes());
        if (r != 0) {
            return 50 + r;
        }
        return 0;
    }

    /**
     * 0 when the facts written in more than one place agree, else the number of the first
     * that does not:
     *
     *   1  the `Frame` block's members follow one another with no gap or overlap — so a
     *      point-light array resized on one side only (`Scene::MAX_POINT_LIGHTS` against
     *      the offsets) is caught;
     *   2  the `Draw` block's likewise, and within the 128 bytes every device gives;
     *   3  the vertex: offsets increasing, the stride the end of the last field, and a
     *      word count that is the stride;
     *   4  a vertex's layer and an image's layers agree;
     *   5  frames in flight is at least one.
     */
    pub static fn constants() : i32 {
        let lamps : i64 = (Scene::MAX_POINT_LIGHTS as i64) * 16;
        let frameOk : bool = FRAME_VIEW_PROJ == 0 && FRAME_EYE == FRAME_VIEW_PROJ + 64 && FRAME_SUN_DIR == FRAME_EYE + 16 && FRAME_SUN_COLOR == FRAME_SUN_DIR + 16 && FRAME_AMBIENT == FRAME_SUN_COLOR + 16 && FRAME_FOG_COLOR == FRAME_AMBIENT + 16 && FRAME_FOG_RANGE == FRAME_FOG_COLOR + 16 && FRAME_LIGHT_POS == FRAME_FOG_RANGE + 16 && FRAME_LIGHT_COL == FRAME_LIGHT_POS + lamps && FRAME_COUNTS == FRAME_LIGHT_COL + lamps && FRAME_INV_VIEW_PROJ == FRAME_COUNTS + 16 && FRAME_TARGET == FRAME_INV_VIEW_PROJ + 64 && FRAME_USER == FRAME_TARGET + 16 && FRAME_BYTES == FRAME_USER + (Scene::USER_VECTORS as i64) * 16;
        if (!frameOk) {
            return 1;
        }
        let drawOk : bool = DRAW_MODEL == 0 && DRAW_ALBEDO == DRAW_MODEL + 64 && DRAW_PARAMS == DRAW_ALBEDO + 16 && DRAW_EXTRA == DRAW_PARAMS + 16 && DRAW_USER == DRAW_EXTRA + 16 && DRAW_BYTES == DRAW_USER + 16 && DRAW_BYTES <= 128;
        if (!drawOk) {
            return 2;
        }
        let vertexOk : bool = MeshBuilder::POSITION_AT == 0 && MeshBuilder::UV_AT == MeshBuilder::POSITION_AT + 12 && MeshBuilder::NORMAL_AT == MeshBuilder::UV_AT + 8 && MeshBuilder::COLOR_AT == MeshBuilder::NORMAL_AT + 4 && MeshBuilder::LAYER_AT == MeshBuilder::COLOR_AT + 4 && MeshBuilder::VERTEX_BYTES == MeshBuilder::LAYER_AT + 4 && MeshBuilder::VERTEX_WORDS * 4 == MeshBuilder::VERTEX_BYTES;
        if (!vertexOk) {
            return 3;
        }
        if (MeshBuilder::MAX_LAYER != Image::MAX_LAYERS - 1) {
            return 4;
        }
        if (FRAMES_IN_FLIGHT < 1) {
            return 5;
        }
        return 0;
    }

    /** The matrix that turns OpenGL clip space into Vulkan's: Y flipped, depth [-1, 1] to [0, 1]. */
    pub static fn clipFix() : Mat4 {
        return VkFrame::clipFix();
    }

    /**
     * The `Frame` uniform block for `scene` drawn at `w` x `h`, as the backend writes it
     * each frame: its 1024 bytes as 32-bit words, read back with
     * `Mem::floatOf(Mem::addressOf(words), i)`.
     */
    pub static fn frameBlock(scene : Scene, w : i32, h : i32) : i32[] {
        let words : i32[] = malloc<i32>(FRAME_BYTES / 4);
        VkFrame::writeFrame(Mem::addressOf(words), scene, w, h);
        return words;
    }

    /** The `Draw` push block for `item`, as the backend writes it per draw: 128 bytes as words. */
    pub static fn drawBlock(item : DrawItem) : i32[] {
        let words : i32[] = malloc<i32>(DRAW_BYTES / 4);
        for (i of 0..(DRAW_BYTES / 4)) {
            words[i] = 0;
        }
        VkFrame::writeDraw(Mem::addressOf(words), item);
        return words;
    }

    /** The side of the overlay texture made for a layer side of `v` on a device whose limit is `most`. */
    pub static fn overlayCapacity(v : i32, most : i32) : i32 {
        return VkOverlay::capacityFor(v, most);
    }

    /** Draw `i` of `scene` in submission order, as the backends read it. */
    pub static fn item(scene : Scene, i : i32) : DrawItem {
        return scene.item(i);
    }

    /** Fix `scene`'s draw order, as `Renderer::render` does before drawing. */
    pub static fn prepare(scene : Scene) : void {
        scene.prepare();
    }

    /** How many of `scene`'s draws are opaque (they come first in the draw order). */
    pub static fn opaqueDraws(scene : Scene) : i32 {
        return scene.opaqueDraws();
    }

    /** The submission index of the draw at position `k` of `scene`'s draw order. */
    pub static fn orderAt(scene : Scene, k : i32) : i32 {
        return scene.orderAt(k);
    }
}
