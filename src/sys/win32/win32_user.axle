// win32_user — the `user32.dll` imports.
//
// Declarations only. The block names the DLL and supplies the marker, so a
// member is one line that reads as its MSDN prototype does.
//
// Where a parameter is a pointer to a *record*, it is declared as one:
// `ptr<MSG>`, `ptr<RECT>`, `ptr<POINT>`, `ptr<WNDCLASSEXW>`. A bare `ptr`
// would accept any block of the right size and none of the right shape,
// which is the mistake this layer exists to make impossible — the caller
// now hands over a thing the compiler agrees is a `MSG`.
//
// The window-procedure trio is here — `SetWindowLongPtrW` /
// `GetWindowLongPtrW` for the per-window state slot, and `DefWindowProcW`
// for every message `video/windows/win_proc` does not answer itself.

use crate::sys::win32_types::{MSG, POINT, RECT, WNDCLASSEXW};

extern "C" from "user32" {
    /** `ATOM RegisterClassExW(const WNDCLASSEXW *)` — 0 on failure. */
    fn RegisterClassExW(wc : ptr<WNDCLASSEXW>) : i32;

    /**
     * `HWND CreateWindowExW(DWORD, LPCWSTR, LPCWSTR, DWORD, int, int, int,
     *                       int, HWND, HMENU, HINSTANCE, LPVOID)`.
     */
    fn CreateWindowExW(
        exStyle : i32,
        className : ptr,
        windowName : ptr,
        style : i32,
        x : i32,
        y : i32,
        w : i32,
        h : i32,
        parent : ptr,
        menu : ptr,
        instance : ptr,
        param : ptr
    ) : ptr;

    /** `BOOL DestroyWindow(HWND)`. */
    fn DestroyWindow(hwnd : ptr) : i32;

    /** `BOOL ShowWindow(HWND, int)`. */
    fn ShowWindow(hwnd : ptr, cmd : i32) : i32;

    /** `BOOL UpdateWindow(HWND)`. */
    fn UpdateWindow(hwnd : ptr) : i32;

    /** `BOOL SetWindowTextW(HWND, LPCWSTR)`. */
    fn SetWindowTextW(hwnd : ptr, text : ptr) : i32;

    /** `BOOL SetForegroundWindow(HWND)`. */
    fn SetForegroundWindow(hwnd : ptr) : i32;

    /**
     * `BOOL PeekMessageW(LPMSG, HWND, UINT, UINT, UINT)`.
     *
     * The load-bearing call of the event layer: it returns the *posted*
     * messages, which is every keyboard and mouse input.
     */
    fn PeekMessageW(
        msg : ptr<MSG>,
        hwnd : ptr,
        filterMin : i32,
        filterMax : i32,
        remove : i32
    ) : i32;

    /**
     * `DWORD MsgWaitForMultipleObjects(DWORD, const HANDLE *, BOOL, DWORD, DWORD)`.
     *
     * The one call that lets a message loop **sleep**. `PeekMessageW`
     * answers immediately whether or not anything arrived, so a loop
     * built on it alone either spins a core or sleeps a fixed period and
     * answers input that much later. This blocks until the queue has
     * something the wake mask covers, or the timeout expires.
     *
     * With a count of zero and a null handle array it waits on nothing
     * but the queue, which is what an event-driven program wants.
     */
    fn MsgWaitForMultipleObjects(
        count : i32,
        handles : ptr,
        waitAll : i32,
        millis : i32,
        wakeMask : i32
    ) : i32;

    /** `BOOL TranslateMessage(const MSG *)` — synthesises `WM_CHAR`. */
    fn TranslateMessage(msg : ptr<MSG>) : i32;

    /** `LRESULT DispatchMessageW(const MSG *)` — routes to the window procedure. */
    fn DispatchMessageW(msg : ptr<MSG>) : i64;

    /** `BOOL AdjustWindowRectEx(LPRECT, DWORD, BOOL, DWORD)`. */
    fn AdjustWindowRectEx(rect : ptr<RECT>, style : i32, menu : i32, exStyle : i32) : i32;

    /** `BOOL IsWindow(HWND)` — false once the window has been destroyed. */
    fn IsWindow(hwnd : ptr) : i32;

    /** `HDC GetDC(HWND)`. */
    fn GetDC(hwnd : ptr) : ptr;

    /** `int ReleaseDC(HWND, HDC)`. */
    fn ReleaseDC(hwnd : ptr, hdc : ptr) : i32;

    /** `HCURSOR LoadCursorW(HINSTANCE, LPCWSTR)` — NULL instance for `IDC_*`. */
    fn LoadCursorW(instance : ptr, name : ptr) : ptr;

    /** `SHORT GetAsyncKeyState(int)` — the polled key state, by virtual key. */
    fn GetAsyncKeyState(vk : i32) : i32;

    /** `BOOL GetCursorPos(LPPOINT)` — screen coordinates. */
    fn GetCursorPos(point : ptr<POINT>) : i32;

    /** `BOOL SetCursorPos(int, int)` — the recentre of relative mouse mode. */
    fn SetCursorPos(x : i32, y : i32) : i32;

    /** `BOOL ScreenToClient(HWND, LPPOINT)`. */
    fn ScreenToClient(hwnd : ptr, point : ptr<POINT>) : i32;

    /** `BOOL ClientToScreen(HWND, LPPOINT)`. */
    fn ClientToScreen(hwnd : ptr, point : ptr<POINT>) : i32;

    /** `int ShowCursor(BOOL)` — a counter, not a flag: shown while >= 0. */
    fn ShowCursor(show : i32) : i32;

    /** `BOOL ClipCursor(const RECT *)` — NULL releases the confinement. */
    fn ClipCursor(rect : ptr) : i32;

    /** `int GetSystemMetrics(int)` — screen size, border widths. */
    fn GetSystemMetrics(index : i32) : i32;

    /**
     * `LRESULT DefWindowProcW(HWND, UINT, WPARAM, LPARAM)`.
     *
     * What the window procedure hands every message it does not answer, and
     * what makes a window behave like one: the system menu, the frame, the
     * caret, alt-tab.
     */
    fn DefWindowProcW(hwnd : ptr, msg : u32, wParam : u64, lParam : i64) : i64;

    /**
     * `LONG_PTR SetWindowLongPtrW(HWND, int, LONG_PTR)`.
     *
     * Used with `GWLP_USERDATA` to hang the procedure's state block off the
     * window. A window procedure captures nothing, so this slot is the only
     * channel between it and the rest of the library.
     */
    fn SetWindowLongPtrW(hwnd : ptr, index : i32, value : ptr) : ptr;

    /** `LONG_PTR GetWindowLongPtrW(HWND, int)` — reads the slot back. */
    fn GetWindowLongPtrW(hwnd : ptr, index : i32) : ptr;

    /**
     * `LRESULT SendMessageW(HWND, UINT, WPARAM, LPARAM)`.
     *
     * Invokes the window procedure **synchronously**, bypassing the queue —
     * which is what makes it the one call that can test a procedure without
     * a user at the keyboard. `examples/proc_check` uses it for exactly that.
     */
    fn SendMessageW(hwnd : ptr, msg : u32, wParam : u64, lParam : i64) : i64;
}
