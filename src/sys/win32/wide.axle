// wide — UTF-8 (Axle's `string`) to UTF-16 (Win32's `W` APIs), as a Blob.
//
// The library calls `RegisterClassExW` / `CreateWindowExW` /
// `SetWindowTextW` rather than their `A` twins, because the `A` family
// transcodes through the process ANSI codepage and mangles anything a
// user is likely to put in a window title. That means every string
// crossing to Win32 becomes a NUL-terminated UTF-16 buffer first.
//
// The **decode itself is `Mem::wideFrom`'s**, not this file's. This is
// the shape the Win32 backend needs — an owned block whose address
// outlives the call that takes it — and it is three lines over the
// portable one. The split is deliberate: a second copy of a UTF-8
// decoder is a second place for the surrogate arithmetic to be wrong,
// and this file used to be that second place.

use crate::kernel::blob::Blob;
use crate::kernel::mem::Mem;
use crate::kernel::raw::Raw;

/**
 * UTF-16 text handed to Win32.
 *
 * The buffer is owned by the caller and must outlive the call that reads
 * it — a window class name in particular is retained by the OS until the
 * class is unregistered, so `win_class` keeps its blob alive for the
 * process's lifetime rather than freeing it after `RegisterClassExW`.
 */
class Wide {
    /**
     * `s` as a NUL-terminated UTF-16 buffer.
     *
     * Sized from the **byte** length: a UTF-8 string never produces more
     * UTF-16 code units than it has bytes (the four-byte sequences that
     * yield two units also consume four bytes), so `byteLength + 1` units
     * is always enough and the buffer is allocated once.
     *
     * It used to be sized — and looped — from `s.length`, which counts
     * *codepoints* while `byteAt` indexes *bytes*. Every title carrying a
     * character outside ASCII therefore lost as many trailing characters
     * as it had multi-byte ones, which is why the library's own
     * `"smalt — hello"` came out a letter short.
     */
    pub(crate) static fn from(s : string) : Blob {
        let units : i64 = s.byteLength + 1;
        let out = new Blob(units * 2);
        Mem::wideFrom(Raw::addr(out.at()), s, units as i32);
        return out;
    }
}
