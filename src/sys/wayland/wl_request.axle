// wl_request — the core protocol's vocabulary, as this port speaks it.
//
// An opcode is the position of a request in its interface's table, and
// the protocol freezes it: a request may be *added* after the last one,
// never inserted. That is what lets a port name them as constants
// instead of looking them up, and it is why a table this port builds by
// hand must keep a slot for a request it never sends.
//
// Only what is sent is named. A reader asking "what does this port do to
// the compositor" gets the answer by reading this file, and a request
// that appears here and nowhere else is one somebody stopped sending.

/** `wl_display.sync` — the request every compositor must answer. */
pub const WL_DISPLAY_SYNC : i32 = 0;

/** `wl_display.get_registry`. */
pub const WL_DISPLAY_GET_REGISTRY : i32 = 1;

/** `wl_registry.bind`. */
pub const WL_REGISTRY_BIND : i32 = 0;

/** `wl_compositor.create_surface`. */
pub const WL_COMPOSITOR_CREATE_SURFACE : i32 = 0;

/** `wl_shm.create_pool`. */
pub const WL_SHM_CREATE_POOL : i32 = 0;

/** `wl_shm_pool.create_buffer`. */
pub const WL_SHM_POOL_CREATE_BUFFER : i32 = 0;

/** `wl_shm_pool.destroy`. */
pub const WL_SHM_POOL_DESTROY : i32 = 1;

/** `wl_buffer.destroy`. */
pub const WL_BUFFER_DESTROY : i32 = 0;

/** `wl_surface.destroy`. */
pub const WL_SURFACE_DESTROY : i32 = 0;

/** `wl_surface.attach`. */
pub const WL_SURFACE_ATTACH : i32 = 1;

/** `wl_surface.damage`. */
pub const WL_SURFACE_DAMAGE : i32 = 2;

/** `wl_surface.commit`. */
pub const WL_SURFACE_COMMIT : i32 = 6;

/** `wl_seat.get_pointer`. */
pub const WL_SEAT_GET_POINTER : i32 = 0;

/** `wl_seat.get_keyboard`. */
pub const WL_SEAT_GET_KEYBOARD : i32 = 1;

/** `wl_pointer.set_cursor`. */
pub const WL_POINTER_SET_CURSOR : i32 = 0;

/** `WL_SHM_FORMAT_XRGB8888` — the one format every compositor supports. */
pub const WL_SHM_FORMAT_XRGB8888 : i64 = 1;

/** The version of every global this port binds. */
pub const WL_BIND_VERSION : i32 = 1;

/** `wl_seat.capability.pointer` — bit 0 of what a seat reports. */
pub const WL_SEAT_CAPABILITY_POINTER : i32 = 1;

/** `wl_seat.capability.keyboard` — bit 1. */
pub const WL_SEAT_CAPABILITY_KEYBOARD : i32 = 2;
