                extent: VkExtent2D { width: 0, height: 0 },
            },
            clearValueCount: 0,
            pClearValues: Raw::nil(),
        };
    }

    /** A `VkSubmitInfo` with its `sType` set. */
    pub static fn submitInfo() : VkSubmitInfo {
        return VkSubmitInfo {
            sType: VK_STRUCTURE_TYPE_SUBMIT_INFO,
            pNext: Raw::nil(),
            waitSemaphoreCount: 0,
            pWaitSemaphores: Raw::nil(),
            pWaitDstStageMask: Raw::nil(),
            commandBufferCount: 0,
            pCommandBuffers: Raw::nil(),
            signalSemaphoreCount: 0,
            pSignalSemaphores: Raw::nil(),
        };
    }

    /** A `VkPresentInfoKHR` with its `sType` set. */
    pub static fn presentInfo() : VkPresentInfoKHR {
        return VkPresentInfoKHR {
            sType: VK_STRUCTURE_TYPE_PRESENT_INFO_KHR,
