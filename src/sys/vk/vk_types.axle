/**
 * `VkClearValue` — a union in C, and Axle has none.
 *
 * Sixteen bytes, which is the union's width: a colour is four floats, and a
 * depth clear is `{ float depth; uint32_t stencil; }`, whose `depth` lands in
 * the first float. So the record is four floats, and a depth clear writes `c0`.
 */
pub extern "C" struct VkClearValue {
    /** Float 0 of the union. */
    pub c0 : f32;

    /** Float 1 of the union. */
    pub c1 : f32;

    /** Float 2 of the union. */
    pub c2 : f32;

    /** Float 3 of the union. */
    pub c3 : f32;
}

/**
 * One factory per record, with the `sType` tag already set where the record has
 * one and every other field zero or null.
 *
 * A wrong or missing `sType` is the commonest silent Vulkan mistake — the
 * driver reads the tag to know what it was handed — so a record is *started*
 * here and then assigned, which leaves no way to forget it.
 */
pub class VkInit {
    /** A `VkApplicationInfo` with its `sType` set. */
    pub static fn applicationInfo() : VkApplicationInfo {
        return VkApplicationInfo {
            sType: VK_STRUCTURE_TYPE_APPLICATION_INFO,
            pNext: Raw::nil(),
            pApplicationName: Raw::nil(),
            applicationVersion: 0,
            pEngineName: Raw::nil(),
            engineVersion: 0,
            apiVersion: 0,
        };
    }

    /** A `VkInstanceCreateInfo` with its `sType` set. */
    pub static fn instanceCreateInfo() : VkInstanceCreateInfo {
        return VkInstanceCreateInfo {
            sType: VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
            pNext: Raw::nil(),
            flags: 0,
            pApplicationInfo: Raw::nil(),
            enabledLayerCount: 0,
            ppEnabledLayerNames: Raw::nil(),
            enabledExtensionCount: 0,
            ppEnabledExtensionNames: Raw::nil(),
        };
    }

    /** A `VkDeviceQueueCreateInfo` with its `sType` set. */
    pub static fn deviceQueueCreateInfo() : VkDeviceQueueCreateInfo {
        return VkDeviceQueueCreateInfo {
            sType: VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
            pNext: Raw::nil(),
            flags: 0,
            queueFamilyIndex: 0,
            queueCount: 0,
            pQueuePriorities: Raw::nil(),
        };
    }

    /** A `VkDeviceCreateInfo` with its `sType` set. */
    pub static fn deviceCreateInfo() : VkDeviceCreateInfo {
        return VkDeviceCreateInfo {
            sType: VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
            pNext: Raw::nil(),
            flags: 0,
            queueCreateInfoCount: 0,
            pQueueCreateInfos: Raw::nil(),
            enabledLayerCount: 0,
            ppEnabledLayerNames: Raw::nil(),
            enabledExtensionCount: 0,
            ppEnabledExtensionNames: Raw::nil(),
            pEnabledFeatures: Raw::nil(),
        };
    }

    /** A `VkPhysicalDeviceFeatures`, every field zero. */
