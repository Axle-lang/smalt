    }

    /** A `VkSwapchainCreateInfoKHR` with its `sType` set. */
    pub static fn swapchainCreateInfo() : VkSwapchainCreateInfoKHR {
        return VkSwapchainCreateInfoKHR {
            sType: VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR,
            pNext: Raw::nil(),
