// vk_out — the offsets of the records the driver fills.
//
// Written from the Khronos registry (`vk.xml`) for the commands and records the
// backend uses, each size and offset measured by a C compiler against
// `<vulkan/vulkan.h>`. The script that first produced it is not part of this
// tree: the file is maintained by hand, and `vk_layout_check` is what holds the
// records to C — at start-up, before the first one reaches a driver, and in
// `examples/gpu_check`.

// A record the driver fills and smalt only reads (properties, capabilities,
// memory requirements) is not declared as an Axle struct: it carries arrays of
// `char` and nested limit tables, and a second copy of an 800-byte layout is a
// second place to be wrong. The block is allocated at `*_BYTES` and a field is
// read at its measured offset through `Mem`.

/** `sizeof(VkPhysicalDeviceProperties)`. */
pub(crate) const VKO_PHYSICAL_DEVICE_PROPERTIES_BYTES : i64 = 824;

/** `offsetof(VkPhysicalDeviceProperties, deviceType)`. */
pub(crate) const VKO_PHYSICAL_DEVICE_PROPERTIES_DEVICE_TYPE : i64 = 16;

/** `offsetof(VkPhysicalDeviceProperties, deviceName)`. */
pub(crate) const VKO_PHYSICAL_DEVICE_PROPERTIES_DEVICE_NAME : i64 = 20;

