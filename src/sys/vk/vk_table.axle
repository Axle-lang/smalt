    /** `VkResult vkCreateInstance(const VkInstanceCreateInfo* pCreateInfo, const VkAllocationCallbacks* pAllocator, VkInstance* pInstance)`. */
    pub fn createInstance(self, pCreateInfo : VkInstanceCreateInfo, pInstance : ptr) : i32 {
        unsafe {
            let pCreateInfo_ : VkInstanceCreateInfo = pCreateInfo;
            let f : extern "C" (ptr, ptr, ptr) => i32 = self.pCreateInstance as extern "C" (ptr, ptr, ptr) => i32;
            return f((&pCreateInfo_) as ptr, Raw::nil(), pInstance);
        }
    }

    /** `void vkDestroyInstance(VkInstance instance, const VkAllocationCallbacks* pAllocator)`. */
    pub fn destroyInstance(self, instance : i64) : void {
        unsafe {
            let f : extern "C" (i64, ptr) => void = self.pDestroyInstance as extern "C" (i64, ptr) => void;
            f(instance, Raw::nil());
        }
    }

    /** `VkResult vkEnumeratePhysicalDevices(VkInstance instance, uint32_t* pPhysicalDeviceCount, VkPhysicalDevice* pPhysicalDevices)`. */
    pub fn enumeratePhysicalDevices(
        self,
        instance : i64,
        pPhysicalDeviceCount : ptr,
        pPhysicalDevices : ptr
    ) : i32 {
        unsafe {
            let f : extern "C" (i64, ptr, ptr) => i32 = self.pEnumeratePhysicalDevices as extern "C" (i64, ptr, ptr) => i32;
