// vk_table — the Vulkan entry points, called through addresses the loader hands back.
//
// Written from the Khronos registry (`vk.xml`), one method per command the backend
// calls, each signature transcribed from the C prototype quoted above it. The
// script that first produced it is not part of this tree; the file is maintained by
// hand now, and a command is added the way the others are: field, load, method.

// Vulkan is not linked. The loader (`vulkan-1.dll`, `libvulkan.so.1`) is opened
// at run time by the `platform::sys_gpu_loader` seam, which yields one address,
// `vkGetInstanceProcAddr`; every other command is asked of it by name and kept
// here as a bare address. That is the whole reason there is no `[link]` section
// and no `-lvulkan`: a machine without a Vulkan driver builds, runs, and lets
// `Renderer` fall back to the software device.
//
// A method is the C prototype with three changes, all mechanical:
//   * the allocator argument is gone (always null);
//   * a `const VkXxx *` that names ONE record is taken by value, and its address
//     is the address of the callee's own copy;
//   * every other pointer is a `ptr`, and an array the caller built is handed
//     over with `VkAddr`.
//
// The `unsafe` in this crate's Vulkan code is exactly this file's casts and
// `VkAddr`'s address-of: each call site above it is safe Axle.

use crate::kernel::raw::Raw;
use crate::sys::vk::vk_types::{
    VkApplicationInfo, VkAttachmentDescription, VkAttachmentReference, VkBufferCreateInfo,
    VkBufferImageCopy, VkCommandBufferAllocateInfo, VkCommandBufferBeginInfo,
    VkCommandPoolCreateInfo, VkDescriptorBufferInfo, VkDescriptorImageInfo,
    VkDescriptorPoolCreateInfo, VkDescriptorPoolSize, VkDescriptorSetAllocateInfo,
    VkDescriptorSetLayoutBinding, VkDescriptorSetLayoutCreateInfo, VkDeviceCreateInfo,
    VkDeviceQueueCreateInfo, VkFenceCreateInfo, VkFramebufferCreateInfo,
    VkGraphicsPipelineCreateInfo, VkImageBlit, VkImageCreateInfo, VkImageMemoryBarrier, VkMemoryBarrier,
    VkImageViewCreateInfo, VkInstanceCreateInfo, VkMemoryAllocateInfo, VkPhysicalDeviceFeatures,
    VkPipelineColorBlendAttachmentState, VkPipelineColorBlendStateCreateInfo,
    VkPipelineDepthStencilStateCreateInfo, VkPipelineDynamicStateCreateInfo,
    VkPipelineInputAssemblyStateCreateInfo, VkPipelineLayoutCreateInfo,
    VkPipelineMultisampleStateCreateInfo, VkPipelineRasterizationStateCreateInfo,
    VkPipelineShaderStageCreateInfo, VkPipelineVertexInputStateCreateInfo,
    VkPipelineViewportStateCreateInfo, VkPresentInfoKHR, VkPushConstantRange, VkRect2D,
    VkRenderPassBeginInfo, VkRenderPassCreateInfo, VkSamplerCreateInfo, VkSemaphoreCreateInfo,
    VkShaderModuleCreateInfo, VkSubmitInfo, VkSubpassDependency, VkSubpassDescription,
    VkSwapchainCreateInfoKHR, VkVertexInputAttributeDescription, VkVertexInputBindingDescription,
    VkViewport, VkWriteDescriptorSet,
};

/** The loaded Vulkan entry points. */
pub class VkTable {
    /** `vkGetInstanceProcAddr`, the one address the loader gives. */
    getProc : ptr = Raw::nil();

    pCreateInstance : ptr = Raw::nil();
    pEnumerateInstanceLayerProperties : ptr = Raw::nil();
    pDestroyInstance : ptr = Raw::nil();
    pEnumeratePhysicalDevices : ptr = Raw::nil();
    pGetPhysicalDeviceProperties : ptr = Raw::nil();
    pGetPhysicalDeviceFeatures : ptr = Raw::nil();
    pGetPhysicalDeviceQueueFamilyProperties : ptr = Raw::nil();
    pGetPhysicalDeviceMemoryProperties : ptr = Raw::nil();
    pGetPhysicalDeviceFormatProperties : ptr = Raw::nil();
    pCreateDevice : ptr = Raw::nil();
    pDestroySurfaceKHR : ptr = Raw::nil();
    pGetPhysicalDeviceSurfaceSupportKHR : ptr = Raw::nil();
    pGetPhysicalDeviceSurfaceCapabilitiesKHR : ptr = Raw::nil();
    pGetPhysicalDeviceSurfaceFormatsKHR : ptr = Raw::nil();
    pGetPhysicalDeviceSurfacePresentModesKHR : ptr = Raw::nil();
    pDestroyDevice : ptr = Raw::nil();
    pGetDeviceQueue : ptr = Raw::nil();
    pDeviceWaitIdle : ptr = Raw::nil();
    pQueueSubmit : ptr = Raw::nil();
    pQueueWaitIdle : ptr = Raw::nil();
    pAllocateMemory : ptr = Raw::nil();
    pFreeMemory : ptr = Raw::nil();
    pMapMemory : ptr = Raw::nil();
    pBindBufferMemory : ptr = Raw::nil();
    pBindImageMemory : ptr = Raw::nil();
    pGetBufferMemoryRequirements : ptr = Raw::nil();
    pGetImageMemoryRequirements : ptr = Raw::nil();
    pCreateBuffer : ptr = Raw::nil();
    pDestroyBuffer : ptr = Raw::nil();
    pCreateImage : ptr = Raw::nil();
    pDestroyImage : ptr = Raw::nil();
    pCreateImageView : ptr = Raw::nil();
    pDestroyImageView : ptr = Raw::nil();
    pCreateSampler : ptr = Raw::nil();
    pDestroySampler : ptr = Raw::nil();
    pCreateShaderModule : ptr = Raw::nil();
    pDestroyShaderModule : ptr = Raw::nil();
    pCreateDescriptorSetLayout : ptr = Raw::nil();
    pDestroyDescriptorSetLayout : ptr = Raw::nil();
    pCreatePipelineLayout : ptr = Raw::nil();
    pDestroyPipelineLayout : ptr = Raw::nil();
    pCreateRenderPass : ptr = Raw::nil();
    pDestroyRenderPass : ptr = Raw::nil();
    pCreateFramebuffer : ptr = Raw::nil();
    pDestroyFramebuffer : ptr = Raw::nil();
    pCreateGraphicsPipelines : ptr = Raw::nil();
    pDestroyPipeline : ptr = Raw::nil();
    pCreateCommandPool : ptr = Raw::nil();
    pDestroyCommandPool : ptr = Raw::nil();
    pAllocateCommandBuffers : ptr = Raw::nil();
    pFreeCommandBuffers : ptr = Raw::nil();
    pResetCommandBuffer : ptr = Raw::nil();
    pBeginCommandBuffer : ptr = Raw::nil();
    pEndCommandBuffer : ptr = Raw::nil();
    pCreateSemaphore : ptr = Raw::nil();
    pDestroySemaphore : ptr = Raw::nil();
    pCreateFence : ptr = Raw::nil();
    pDestroyFence : ptr = Raw::nil();
    pWaitForFences : ptr = Raw::nil();
    pResetFences : ptr = Raw::nil();
    pCreateDescriptorPool : ptr = Raw::nil();
    pDestroyDescriptorPool : ptr = Raw::nil();
    pAllocateDescriptorSets : ptr = Raw::nil();
    pFreeDescriptorSets : ptr = Raw::nil();
    pUpdateDescriptorSets : ptr = Raw::nil();
    pCreateSwapchainKHR : ptr = Raw::nil();
    pDestroySwapchainKHR : ptr = Raw::nil();
    pGetSwapchainImagesKHR : ptr = Raw::nil();
    pAcquireNextImageKHR : ptr = Raw::nil();
    pQueuePresentKHR : ptr = Raw::nil();
    pCmdBeginRenderPass : ptr = Raw::nil();
    pCmdEndRenderPass : ptr = Raw::nil();
    pCmdBindPipeline : ptr = Raw::nil();
    pCmdBindDescriptorSets : ptr = Raw::nil();
    pCmdBindVertexBuffers : ptr = Raw::nil();
    pCmdBindIndexBuffer : ptr = Raw::nil();
    pCmdPushConstants : ptr = Raw::nil();
    pCmdDrawIndexed : ptr = Raw::nil();
    pCmdDraw : ptr = Raw::nil();
    pCmdSetViewport : ptr = Raw::nil();
    pCmdSetScissor : ptr = Raw::nil();
    pCmdCopyBufferToImage : ptr = Raw::nil();
    pCmdPipelineBarrier : ptr = Raw::nil();
    pCmdBlitImage : ptr = Raw::nil();
    pCmdCopyImageToBuffer : ptr = Raw::nil();

    /** A table over the loader's `vkGetInstanceProcAddr`. */
    constructor(getProc : ptr) {
        self.getProc = getProc;
    }

    /**
     * The address of the command `name`, as the loader answers for `instance`
     * (0 for the commands that exist before an instance does).
     *
     * Public because a platform's surface commands (`vkCreateXlibSurfaceKHR`, …)
     * are not in the portable table: the port that needs one asks for it here.
     */
    pub fn proc(self, instance : i64, name : string) : ptr {
        unsafe {
            let f : extern "C" (i64, string) => ptr = self.getProc as extern "C" (i64, string) => ptr;
            return f(instance, name);
        }
    }

    /** Whether the loader answered at all. */
    pub fn isLoaded(self) : bool {
        return Raw::addr(self.getProc) != 0;
    }

    /** Resolve the commands that exist before an instance; "" when all did. */
    pub fn loadGlobal(mut self) : string {
        self.pCreateInstance = self.proc(0, "vkCreateInstance");
        if (Raw::isNil(self.pCreateInstance)) {
            return "vkCreateInstance";
        }
        // Optional: only asked when a layer is wanted, and a loader without it has none.
        self.pEnumerateInstanceLayerProperties = self.proc(0, "vkEnumerateInstanceLayerProperties");
        return "";
    }

    /**
     * Whether `vkDestroyInstance` was resolved. `loadInstance` can fail on the very
     * first name, and an instance whose destroy command the loader would not give is
     * one that cannot be destroyed — calling through the null address instead is a
     * crash where a fallback to the CPU was due.
     */
    pub fn canDestroyInstance(self) : bool {
        return !Raw::isNil(self.pDestroyInstance);
    }

    /** Whether `vkEnumerateInstanceLayerProperties` was resolved. */
    pub fn canListLayers(self) : bool {
        return !Raw::isNil(self.pEnumerateInstanceLayerProperties);
    }

    /** `VkResult vkEnumerateInstanceLayerProperties(uint32_t* pPropertyCount, VkLayerProperties* pProperties)`. */
    pub fn enumerateInstanceLayerProperties(self, pPropertyCount : ptr, pProperties : ptr) : i32 {
        unsafe {
            let f : extern "C" (ptr, ptr) => i32 = self.pEnumerateInstanceLayerProperties as extern "C" (ptr, ptr) => i32;
            return f(pPropertyCount, pProperties);
        }
    }

    /** Resolve every other command against `instance`; the first missing name, or "". */
    pub fn loadInstance(mut self, instance : i64) : string {
        self.pDestroyInstance = self.proc(instance, "vkDestroyInstance");
        if (Raw::isNil(self.pDestroyInstance)) {
            return "vkDestroyInstance";
