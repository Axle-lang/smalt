/**
 * The address of the first element of an array the caller built.
 *
 * A creation record names its arrays by pointer (`pAttachments`, `pSetLayouts`)
 * and the array has to outlive the call that reads it — which is why these take
 * the array and not an address stored for later: the caller's local is alive
 * for the statement that builds the record and the one that submits it. An
 * empty array is a null pointer, which is what a count of zero goes with.
 */
pub class VkAddr {
    /** The address of `a[0]`, for a `i64[]` the driver reads. */
    pub static fn handles(a : i64[]) : ptr {
        if (a.length == 0) {
            return Raw::nil();
        }
        unsafe {
            return (&a[0]) as ptr;
        }
    }

    /** The address of `a[0]`, for a `i32[]` the driver reads. */
    pub static fn ints(a : i32[]) : ptr {
        if (a.length == 0) {
            return Raw::nil();
        }
        unsafe {
            return (&a[0]) as ptr;
        }
    }

    /** The address of `a[0]`, for a `f32[]` the driver reads. */
    pub static fn floats(a : f32[]) : ptr {
        if (a.length == 0) {
            return Raw::nil();
        }
        unsafe {
            return (&a[0]) as ptr;
        }
    }

    /** The address of `a[0]`, for a `VkApplicationInfo[]` the driver reads. */
    pub static fn applicationInfo(a : VkApplicationInfo[]) : ptr {
        if (a.length == 0) {
            return Raw::nil();
        }
        unsafe {
            return (&a[0]) as ptr;
        }
    }

    /** The address of `a[0]`, for a `VkAttachmentDescription[]` the driver reads. */
    pub static fn attachmentDescription(a : VkAttachmentDescription[]) : ptr {
        if (a.length == 0) {
