// vk_layout_check — the numbers, asserted against the declarations.
//
// Written from the Khronos registry (`vk.xml`) for the commands and records the
// backend uses, each size and offset measured by a C compiler against
// `<vulkan/vulkan.h>`. The script that first produced it is not part of this
// tree: the file is maintained by hand, and `vk_layout_check` is what holds the
// records to C — at start-up, before the first one reaches a driver, and in
// `examples/gpu_check`.

// `vk_types` declares the records; this file holds what the C compiler measured
// from the real `<vulkan/vulkan.h>`, and asserts the Axle compiler agrees. A
// mismatch is a creation record the driver reads at the wrong offset — no error,
// just garbage — so it is a returned number here, and a renderer that gets one
// does not open the GPU (`VkContext`). A record added to `vk_types` gets its size
// and every offset here, in the same shape, numbered on from the last check.

use crate::sys::vk::vk_types::{
    VkApplicationInfo, VkAttachmentDescription, VkAttachmentReference, VkBufferCopy,
    VkBufferCreateInfo, VkBufferImageCopy, VkCommandBufferAllocateInfo, VkCommandBufferBeginInfo,
    VkCommandPoolCreateInfo, VkComponentMapping, VkDescriptorBufferInfo, VkDescriptorImageInfo,
    VkDescriptorPoolCreateInfo, VkDescriptorPoolSize, VkDescriptorSetAllocateInfo,
    VkDescriptorSetLayoutBinding, VkDescriptorSetLayoutCreateInfo, VkDeviceCreateInfo,
    VkDeviceQueueCreateInfo, VkExtent2D, VkExtent3D, VkFenceCreateInfo, VkFramebufferCreateInfo,
    VkGraphicsPipelineCreateInfo, VkImageBlit, VkImageCreateInfo, VkImageMemoryBarrier, VkMemoryBarrier,
    VkImageSubresourceLayers, VkImageSubresourceRange, VkImageViewCreateInfo, VkInstanceCreateInfo,
    VkMemoryAllocateInfo, VkOffset2D, VkOffset3D, VkPhysicalDeviceFeatures,
    VkPipelineColorBlendAttachmentState, VkPipelineColorBlendStateCreateInfo,
    VkPipelineDepthStencilStateCreateInfo, VkPipelineDynamicStateCreateInfo,
    VkPipelineInputAssemblyStateCreateInfo, VkPipelineLayoutCreateInfo,
    VkPipelineMultisampleStateCreateInfo, VkPipelineRasterizationStateCreateInfo,
    VkPipelineShaderStageCreateInfo, VkPipelineVertexInputStateCreateInfo,
    VkPipelineViewportStateCreateInfo, VkPresentInfoKHR, VkPushConstantRange, VkRect2D,
    VkRenderPassBeginInfo, VkRenderPassCreateInfo, VkSamplerCreateInfo, VkSemaphoreCreateInfo,
    VkShaderModuleCreateInfo, VkStencilOpState, VkSubmitInfo, VkSubpassDependency,
    VkSubpassDescription, VkSwapchainCreateInfoKHR, VkVertexInputAttributeDescription,
    VkVertexInputBindingDescription, VkViewport, VkWriteDescriptorSet, VkClearValue,
};

/** Sizes and offsets of the Vulkan records, checked against the C headers. */
pub(crate) class VkLayout {
    /**
     * 0 when every record matches, otherwise the number of the first check
     * that failed. A number rather than a boolean, so the record that moved
     * is the only thing worth knowing.
     */
    pub(crate) static fn verify() : i32 {
        if (sizeof<VkApplicationInfo>() != 48) {
            return 1;
        }
        if (offsetof(VkApplicationInfo, sType) != 0) {
            return 2;
        }
        if (offsetof(VkApplicationInfo, pNext) != 8) {
            return 3;
        }
        if (offsetof(VkApplicationInfo, pApplicationName) != 16) {
            return 4;
        }
        if (offsetof(VkApplicationInfo, applicationVersion) != 24) {
            return 5;
        }
        if (offsetof(VkApplicationInfo, pEngineName) != 32) {
            return 6;
        }
        if (offsetof(VkApplicationInfo, engineVersion) != 40) {
            return 7;
        }
        if (offsetof(VkApplicationInfo, apiVersion) != 44) {
            return 8;
        }
        if (sizeof<VkInstanceCreateInfo>() != 64) {
            return 9;
        }
        if (offsetof(VkInstanceCreateInfo, sType) != 0) {
            return 10;
        }
        if (offsetof(VkInstanceCreateInfo, pNext) != 8) {
            return 11;
        }
        if (offsetof(VkInstanceCreateInfo, flags) != 16) {
            return 12;
        }
        if (offsetof(VkInstanceCreateInfo, pApplicationInfo) != 24) {
            return 13;
        }
        if (offsetof(VkInstanceCreateInfo, enabledLayerCount) != 32) {
            return 14;
        }
        if (offsetof(VkInstanceCreateInfo, ppEnabledLayerNames) != 40) {
            return 15;
        }
        if (offsetof(VkInstanceCreateInfo, enabledExtensionCount) != 48) {
            return 16;
        }
        if (offsetof(VkInstanceCreateInfo, ppEnabledExtensionNames) != 56) {
            return 17;
        }
        if (sizeof<VkDeviceQueueCreateInfo>() != 40) {
            return 18;
        }
        if (offsetof(VkDeviceQueueCreateInfo, sType) != 0) {
            return 19;
        }
        if (offsetof(VkDeviceQueueCreateInfo, pNext) != 8) {
            return 20;
        }
        if (offsetof(VkDeviceQueueCreateInfo, flags) != 16) {
            return 21;
        }
        if (offsetof(VkDeviceQueueCreateInfo, queueFamilyIndex) != 20) {
            return 22;
        }
        if (offsetof(VkDeviceQueueCreateInfo, queueCount) != 24) {
            return 23;
