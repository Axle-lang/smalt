// win32_gdi — the `gdi32.dll` imports.
//
// One call carries the whole present path. `StretchDIBits` reads a
// caller-owned pixel buffer directly, so the library allocates no GDI
// bitmap, selects nothing into a memory DC, and therefore has no GDI object
// to leak. It also scales, which is what absorbs a window resize without
// reallocating the framebuffer.
//
// The block names `gdi32`, which is where the link line learns of it.

use crate::sys::win32_types::BITMAPINFO;

extern "C" from "gdi32" {
    /**
     * `int StretchDIBits(HDC, int, int, int, int, int, int, int, int,
     *                    const void *, const BITMAPINFO *, UINT, DWORD)`.
     *
     * `bits` is the library's own `i32[]` framebuffer, decayed once per
     * frame; `info` describes it, and its `biHeight` is negative — the rows
     * are top-down, so row 0 is the top of the screen.
     */
    fn StretchDIBits(
        hdc : ptr,
        destX : i32,
        destY : i32,
        destW : i32,
        destH : i32,
        srcX : i32,
        srcY : i32,
        srcW : i32,
        srcH : i32,
        bits : ptr,
        info : ptr<BITMAPINFO>,
        usage : i32,
        rop : i32
    ) : i32;
}
