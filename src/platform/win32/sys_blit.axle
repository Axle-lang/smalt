// sys_blit — the platform seam for putting a framebuffer on the screen.
//
// THE CONTRACT:
//
//   present(surface, pixels, srcW, srcH, dstW, dstH)
//       copy a `srcW` by `srcH` block of 32-bit pixels, row 0 at the
//       TOP, onto the `dstW` by `dstH` drawable named by `surface`,
//       scaling when the two differ. `surface` is whatever the window
//       layer calls a drawable — this file is the only one that knows.
//
//   presentRegion(surface, pixels, srcW, srcH, dstW, dstH, rx, ry, rw, rh)
//       the same picture as `present`, for a caller that knows only the
//       rectangle (`rx`, `ry`, `rw`, `rh`) of the frame has changed since
//       its previous present: the port may move just that. It must still
//       leave the whole window showing `pixels`, so a port that cannot do
//       better answers with a full `present` — and does when the frame is
//       scaled, because a scaled pixel depends on its neighbours' sizes.
//
// The scaling is not a nicety: it is what lets a resized window keep
// drawing at the old framebuffer resolution for the frame between the
// resize event and the target's reallocation, instead of showing garbage.
//
// The seam takes a bare `i32[]` rather than a `RenderTarget` so that
// `platform/` stays *below* `render/`. A blit that knew what a render
// target was would be a layer reaching upward, and the port would
// inherit that coupling for nothing.
//
// Windows: `StretchDIBits` reads the caller's `i32[]` directly, so there
// is no DIB section, no memory DC, no `SelectObject`, and therefore no
// GDI object that could leak. `surface` is an `HDC`. `biHeight` is
// stored NEGATIVE — a positive height declares a bottom-up bitmap, the
// DIB default, and would put row 0 at the bottom of the window, which is
// the classic upside-down first frame.
//
// Linux: `surface` becomes the pair (Display*, Drawable) behind one
// token, the header becomes an `XImage`, and `present` becomes
// `XPutImage` — or `XShmPutImage` where the server is local, which is
// the only version fast enough for a full-screen software renderer.
// X11 has no scaling blit, so the port owns the resample this file gets
// from GDI for free.

use crate::kernel::blob::Blob;
use crate::kernel::raw::Raw;
use crate::sys::dib::{BITMAPINFO, BITMAPINFOHEADER};
use crate::sys::win32_gdi::StretchDIBits;
use crate::sys::win32_const::{BI_RGB, DIB_RGB_COLORS, SRCCOPY};

/** Bits per pixel of the framebuffer format. */
const BLIT_BIT_COUNT : i32 = 32;

/** Colour planes; the format has always required exactly one. */
const BLIT_PLANES : i32 = 1;

/**
 * The blit path.
 *
 * Owns the record describing the framebuffer's format, rewritten only
 * when the framebuffer's size changes — describing it per frame would be
 * three stores and a branch for a value that changes on resize.
 */
pub(crate) class SysBlit : Closeable {
    info       : Blob = new Blob(sizeof<BITMAPINFO>());
    describedW : i32 = 0;
    describedH : i32 = 0;

    /** A blit path with no format described yet. */
    constructor() {
        unsafe {
            let mut bmi = self.header();
            // `biSize` is the header validating itself, and it is the
            // header's own `sizeof` — the one number a DIB call fails on
            // with no diagnosis is the one number nobody types any more.
            (*bmi).bmiHeader.biSize = sizeof<BITMAPINFOHEADER>() as u32;
            (*bmi).bmiHeader.biPlanes = BLIT_PLANES as u16;
            (*bmi).bmiHeader.biBitCount = BLIT_BIT_COUNT as u16;
            (*bmi).bmiHeader.biCompression = BI_RGB as u32;
        }
    }

    /** Point the header at a `w` by `h`, top-down framebuffer. */
    pub(crate) fn describe(mut self, w : i32, h : i32) : void {
        if (w == self.describedW && h == self.describedH) {
            return;
        }
        unsafe {
            let mut bmi = self.header();
            (*bmi).bmiHeader.biWidth = w;
            // Negative height declares the rows top-down, so row 0 is the
            // top of the screen rather than the bottom.
            (*bmi).bmiHeader.biHeight = -h;
        }
        self.describedW = w;
        self.describedH = h;
    }

    /**
     * Copy `pixels` onto `surface`, scaling to the destination size.
     *
     * A nil surface or a non-positive extent is a no-op rather than an
     * error: both happen legitimately while a window is minimised, and a
     * frame loop should not have to test for it.
     */
    pub(crate) fn present(
        mut self,
        surface : ptr,
        pixels : i32[],
        srcW : i32,
        srcH : i32,
        dstW : i32,
        dstH : i32
    ) : void {
        if (Raw::isNil(surface) || dstW <= 0 || dstH <= 0 || srcW <= 0 || srcH <= 0) {
            return;
        }
        self.describe(srcW, srcH);
        unsafe {
            StretchDIBits(
                surface,
                0,
                0,
                dstW,
                dstH,
                0,
                0,
                srcW,
                srcH,
                Raw::pixelsOf(pixels),
                self.header(),
                DIB_RGB_COLORS,
                SRCCOPY
            );
        }
    }

    /**
     * Copy one rectangle of the frame onto the window, unscaled.
     *
     * `StretchDIBits` takes a source rectangle and a destination one, and
     * with the two the same size and the frame the window's size it is a
     * straight copy of that rectangle — GDI reads only the rows it needs,
     * so a repaint of a button costs a button, not a screen. The frame is
     * top-down (`biHeight` is negative), and for a top-down DIB the source
     * origin is its top-left, so (`rx`, `ry`) is where the rectangle's
     * first pixel is in both.
     */
    pub(crate) fn presentRegion(
        mut self,
        surface : ptr,
        pixels : i32[],
        srcW : i32,
        srcH : i32,
        dstW : i32,
        dstH : i32,
        rx : i32,
        ry : i32,
        rw : i32,
        rh : i32
    ) : void {
        if (srcW != dstW || srcH != dstH) {
            self.present(surface, pixels, srcW, srcH, dstW, dstH);
            return;
        }
        if (Raw::isNil(surface) || dstW <= 0 || dstH <= 0) {
            return;
        }
        let x0 : i32 = rx.max(0);
        let y0 : i32 = ry.max(0);
        let x1 : i32 = (rx + rw).min(dstW);
        let y1 : i32 = (ry + rh).min(dstH);
        if (x1 <= x0 || y1 <= y0) {
            return;
        }
        self.describe(srcW, srcH);
        unsafe {
            StretchDIBits(
                surface,
                x0,
                y0,
                x1 - x0,
                y1 - y0,
                x0,
                y0,
                x1 - x0,
                y1 - y0,
                Raw::pixelsOf(pixels),
                self.header(),
                DIB_RGB_COLORS,
                SRCCOPY
            );
        }
    }

    /**
     * The block, read as the record it holds.
     *
     * The cast lives here and only here: the block *is* a `BITMAPINFO`
     * for the whole life of this object, and repeating that claim at
     * each of the three places that use it would be three places to get
     * it wrong.
     */
    pub(crate) fn header(self) : ptr<BITMAPINFO> {
        unsafe {
            return self.info.at() as ptr<BITMAPINFO>;
        }
    }

    /** Release the header block. */
    pub(crate) fn close(self) : void {
        self.info.close();
    }
}
