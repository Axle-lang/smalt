// sys_app — the platform seam for the process's own handle on the OS,
// and for the scheduler granularity a frame pacer depends on.
//
// THE CONTRACT:
//
//   instance()          an opaque token the window layer needs to create
//                       a window; nil means the OS refused
//   isNil(token)        whether `instance` failed
//   prepareWindows(t)   whatever must exist once, before any window can
//                       be created; answers whether it worked
//   raiseTimerRes()     ask for the finest sleep granularity available;
//                       answers whether it was granted, because the
//                       matching lower() must run only if it was
//   lowerTimerRes()     undo exactly one granted raise
//   release(token)      hand the token back to the OS
//   checkRecords()      0 when the OS records this backend addresses
//                       match the ones the OS reads, otherwise which
//                       check failed
//
// The granularity pair is process-wide state the OS does not reclaim for
// a program that merely exits, which is why `Platform` is `Closeable` and
// why the raise reports whether it took.
//
// Windows: the module handle from `GetModuleHandleW(NULL)`, and
// `timeBeginPeriod` / `timeEndPeriod` from `winmm`. `prepareWindows`
// registers the window class — `CreateWindowExW` will not accept a class
// name that was never registered, and registering twice fails, so it
// happens once and its answer is kept. `release` is a no-op: a module
// handle is the process's own and is not reference-counted.
//
// Linux: the token becomes the X11 `Display*` from `XOpenDisplay`,
// `prepareWindows` has nothing to do, the granularity pair is a no-op
// that reports "not granted" (`nanosleep` already resolves far below a
// frame), and `release` is the `XCloseDisplay` that matches the open.

use crate::kernel::raw::Raw;
use crate::sys::win32_kernel::GetModuleHandleW;
use crate::sys::win32_mm::{timeBeginPeriod, timeEndPeriod};
use crate::sys::win32_layout_check::Win32Layout;
use crate::video::win_class::WinClass;

/** The scheduler granularity a frame pacer asks for, in milliseconds. */
const SYS_TIMER_PERIOD_MS : i32 = 1;

/** The process's handle on the OS. */
pub class SysApp {
    /** The token the window layer creates windows from. */
    static fn instance() : ptr {
        return GetModuleHandleW(Raw::nil());
    }

    /** Whether `instance` failed to produce a usable token. */
    static fn isNil(token : ptr) : bool {
        return Raw::isNil(token);
    }

    /**
     * Register the window class every smalt window is created from.
     *
     * Answers whether a window may now be created. Registering twice
     * fails with `ERROR_CLASS_ALREADY_EXISTS`, so the caller does this
     * exactly once and keeps the answer.
     */
    static fn prepareWindows(token : ptr) : bool {
        return WinClass::register(token);
    }

    /**
     * Ask for the finest sleep granularity. Answers whether it was
     * granted — only a granted raise may be lowered.
     */
    static fn raiseTimerRes() : bool {
        return timeBeginPeriod(SYS_TIMER_PERIOD_MS) == 0;
    }

    /** Undo one granted raise. */
    static fn lowerTimerRes() : void {
        timeEndPeriod(SYS_TIMER_PERIOD_MS);
    }

    /**
     * Whether the Win32 records this backend fills are the records the
     * OS reads — 0 when every check passes, otherwise its number.
     *
     * A backend addresses OS structures from a declaration, and the OS
     * addresses them from its own; the two agreeing is an assumption
     * nothing else in the library tests. A drifted field is a silent
     * memory corruption at the FFI boundary, which is why this is a
     * returned number and not a comment.
     *
     * A port with no such records answers 0.
     */
    static fn checkRecords() : i32 {
        return Win32Layout::verify();
    }

    /**
     * Hand the token back to the OS.
     *
     * Nothing to do on Win32: a module handle from `GetModuleHandleW` is
     * the process's own and carries no reference count. The call exists
     * because the seam has to have it — an X11 `Display*` is a socket,
     * and a library that never closed it would leak one per process.
     */
    static fn release(token : ptr) : void {}
}
