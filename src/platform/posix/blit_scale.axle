// blit_scale — the scratch a scaled frame is resampled into.
//
// Neither Linux backend can scale while it blits. `XPutImage` copies
// pixel for pixel, and a `wl_buffer` is pixels the compositor reads as
// they were written — so a window that does not match its framebuffer is
// resampled here first, by whichever of the two is answering.
//
// It sits in `posix/` for exactly that reason: both Linux ports name
// that directory and the Windows one does not, which is the difference
// this file is about. GDI's `StretchDIBits` scales in the driver, so the
// Win32 backend has nothing like this and must not grow a name for it —
// a name declared on one port and not another is a call that compiles
// for one target and fails for the other.

use crate::kernel::blob::Blob;

/** The scratch, grown on demand and never shrunk. */
pub(crate) class ScaleScratch : Closeable {
    /** Bytes per pixel in the framebuffer's format. */
    pub(file) static PIXEL_BYTES : i32 = 4;

    /** Fractional bits of the source walk's fixed-point accumulator. */
    pub(file) static FRACTION_BITS : i32 = 16;

    pixels   : Blob;
    capacity : i64;

    /**
     * A scratch holding nothing.
     *
     * One byte rather than none: a `Blob` is at least a byte, and a
     * scratch nobody has needed yet is simpler to model as an empty one
     * than as an absent one every path would have to test for. A game
     * whose window matches its framebuffer never grows it.
     */
    constructor() {
        self.pixels = new Blob(1);
        self.capacity = 0;
    }

    /** Where the resampled frame starts. */
    pub(crate) fn at(self) : ptr {
        return self.pixels.at();
    }

    /** Make sure the scratch holds at least `count` pixels. */
    pub(crate) fn reserve(mut self, count : i64) : void {
        if (count <= self.capacity) {
            return;
        }
        self.pixels.close();
        self.pixels = new Blob(count * (ScaleScratch::PIXEL_BYTES as i64));
        self.capacity = count;
    }

    /**
     * Resample `source` into the scratch at `dstW` by `dstH`, nearest
     * neighbour.
     *
     * The source is walked with a fixed-point accumulator, so the inner
     * loop is an add and a shift — a division per pixel is what a naive
     * `sx = dx * srcW / dstW` costs, and at a window's worth of pixels
     * sixty times a second that is the whole budget.
     */
    pub(crate) fn resample(mut self, source : i32[], srcW : i32, srcH : i32, dstW : i32, dstH : i32) : void {
        let xStep : i64 = ((srcW as i64) << ScaleScratch::FRACTION_BITS) / (dstW as i64);
        let yStep : i64 = ((srcH as i64) << ScaleScratch::FRACTION_BITS) / (dstH as i64);
        unsafe {
            let dst : ptr<i32> = self.pixels.at() as ptr<i32>;
            let sy : i64 = 0;
            let dy : i32 = 0;
            while (dy < dstH) {
                let srcRow : i64 = (sy >> ScaleScratch::FRACTION_BITS) * (srcW as i64);
                let dstRow : i64 = (dy as i64) * (dstW as i64);
                let sx : i64 = 0;
                let dx : i32 = 0;
                while (dx < dstW) {
                    dst[dstRow + (dx as i64)] = source[srcRow + (sx >> ScaleScratch::FRACTION_BITS)];
                    sx = sx + xStep;
                    dx = dx + 1;
                }
                sy = sy + yStep;
                dy = dy + 1;
            }
        }
    }

    /** Release the scratch. */
    pub(crate) fn close(self) : void {
        self.pixels.close();
    }
}
