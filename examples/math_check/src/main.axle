// math_check — the assertions the cube demo does not make.
//
// The screenshot proves the projection, the depth test, the winding and
// the perspective-correct interpolation: get any of them wrong and the
// picture is visibly wrong. Nothing on screen exercises quaternions,
// frustum culling or bounding boxes, and nothing on screen proves that
// a degenerate input answers safely rather than trapping — Axle's
// division traps, so `normalized()` on a zero vector and a perspective
// with a zero field of view are real crash paths, not theoretical ones.
//
// Headless, so unlike the two graphical examples this one can run
// unattended. Exit code is the number of failures; zero means green.

use smalt::{Vec3, Mat4, Quat, Aabb, Frustum, Camera};

fn near(a : f64, b : f64) : bool {
    return (a - b).abs() < 0.00001;
}

fn sameVec(a : Vec3, b : Vec3) : bool {
    return near(a.x, b.x) && near(a.y, b.y) && near(a.z, b.z);
}

fn main() : i32 {
    let fails : i32 = 0;

    // A quaternion rotation must agree with the matrix rotation.
    let axis = Vec3::make(0.3, 1.0, 0.2);
    let angle : f64 = 0.9;
    let v = Vec3::make(1.0, 2.0, 3.0);
    let byQuat = Quat::axisAngle(axis, angle).rotate(v);
    let byMat = Mat4::rotationAxis(axis, angle).applyPoint(v);
    if (!sameVec(byQuat, byMat)) {
        println("FAIL quat vs matrix rotation");
        fails += 1;
    }

    // A quaternion's matrix must agree with the quaternion itself.
    let byQuatMat = Quat::axisAngle(axis, angle).matrix().applyPoint(v);
    if (!sameVec(byQuat, byQuatMat)) {
        println("FAIL quat matrix");
        fails += 1;
    }

    // Rotating by q then by its inverse is the identity.
    let q = Quat::euler(0.7, 0.3, 1.1);
    if (!sameVec(q.inverse().rotate(q.rotate(v)), v)) {
        println("FAIL quat inverse");
        fails += 1;
    }

    // slerp endpoints.
    let a = Quat::axisAngle(Vec3::unitY(), 0.0);
    let b = Quat::axisAngle(Vec3::unitY(), 1.2);
    if (!sameVec(a.slerp(b, 1.0).rotate(v), b.rotate(v))) {
        println("FAIL slerp at t=1");
        fails += 1;
    }
    if (!sameVec(a.slerp(b, 0.0).rotate(v), a.rotate(v))) {
        println("FAIL slerp at t=0");
        fails += 1;
    }

    // A degenerate axis must not produce NaN.
    if (!sameVec(Quat::axisAngle(Vec3::zero(), 1.0).rotate(v), v)) {
        println("FAIL degenerate axis");
        fails += 1;
    }
    if (!sameVec(Vec3::zero().normalized(), Vec3::zero())) {
        println("FAIL zero normalize");
        fails += 1;
    }

    // A frustum must keep what is in front and reject what is behind.
    let cam = new Camera();
    cam.moveTo(Vec3::make(0.0, 0.0, 5.0));
    cam.lookAt(Vec3::zero());
    cam.setViewport(1024, 640);
    let f = Frustum::ofMatrix(cam.viewProjection());
    if (!f.touchesSphere(Vec3::zero(), 0.5)) {
        println("FAIL frustum rejects a visible sphere");
        fails += 1;
    }
    if (f.touchesSphere(Vec3::make(0.0, 0.0, 60.0), 0.5)) {
        println("FAIL frustum accepts a sphere behind the camera");
        fails += 1;
    }
    if (f.touchesSphere(Vec3::make(400.0, 0.0, 0.0), 0.5)) {
        println("FAIL frustum accepts a sphere far to the side");
        fails += 1;
    }
    if (!f.touchesBox(Aabb::around(Vec3::zero(), Vec3::splat(1.0)))) {
        println("FAIL frustum rejects a visible box");
        fails += 1;
    }

    // AABB overlap and containment.
    let boxA = Aabb::around(Vec3::zero(), Vec3::splat(2.0));
    let boxB = Aabb::around(Vec3::make(1.5, 0.0, 0.0), Vec3::splat(2.0));
    let boxC = Aabb::around(Vec3::make(9.0, 0.0, 0.0), Vec3::splat(2.0));
    if (!boxA.overlaps(boxB)) {
        println("FAIL aabb overlap");
        fails += 1;
    }
    if (boxA.overlaps(boxC)) {
        println("FAIL aabb disjoint");
        fails += 1;
    }
    if (!boxA.contains(Vec3::make(0.5, 0.5, 0.5)) || boxA.contains(Vec3::make(0.0, 0.0, 5.0))) {
        println("FAIL aabb contains");
        fails += 1;
    }

    // A degenerate projection must not trap on the divide.
    let bad = Mat4::perspective(0.0, 0.0, 1.0, 1.0);
    if (!sameVec(bad.applyPoint(v), v)) {
        println("FAIL degenerate perspective is not the identity");
        fails += 1;
    }

    println("failures: ${fails}");
    return fails;
}
